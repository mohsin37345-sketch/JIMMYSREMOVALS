---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import CleanAirZoneNotice from 'theme/components/CleanAirZoneNotice.astro';
import CTABand from 'theme/components/CTABand.astro';
import Icon from 'theme/components/Icon.astro';
import { siteConfig } from 'src/data/site';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'About Us', item: '/about-us/' }
];
---

<BaseLayout
  title={`About Jimmys Removals | Insured Birmingham Removals Company`}
  description={`Learn about ${siteConfig.legalName}. Birmingham-based house removals, logistics, and containerised storage company serving the West Midlands with DBS-checked crews.`}
  schemaType="About"
  breadcrumbs={breadcrumbs}
>
  <Hero
    variant="page"
    title="About Jimmys Removals & Logistics"
    subtitle="Founded in Birmingham to provide honest, transparent, and stress-free house removals and transport solutions across the West Midlands."
    badge="Our Heritage & Standards"
  />

  <TrustStrip />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 space-y-16">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Section 1: Company Story & Foundation -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400">
          <Icon name="map-pin" class="w-4 h-4" />
          <span>Birmingham Born & Operated</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Raising the Standard for Domestic & Commercial Removals in the West Midlands
        </h2>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          {siteConfig.legalName} was founded with a straightforward objective: to eliminate the anxiety, hidden costs, and unreliability that have historically troubled the UK removals industry. Moving home is universally acknowledged as a major life transition, yet all too often clients are confronted with ambiguous hourly meters, untrained agency day-labour, unconfirmed arrival times, and surprise surcharges on moving day.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          Headquartered at Unit 4, Phoenix Business Park on Avenue Road in Birmingham, our central location provides immediate access to the A38(M) Aston Expressway, M6 Junction 6 (Spaghetti Junction), and the M5 corridor. This geographical advantage enables our operations desk to coordinate punctual arrival times and responsive same-day support across Birmingham, the Black Country, Solihull, Coventry, and surrounding districts.
        </p>
        <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed">
          From the outset, we committed to permanent, full-time removals specialists. Every member of our moving crew undergoes thorough Disclosure and Barring Service (DBS) vetting, manual handling certification, and in-house training in protective export-wrapping techniques. We never rely on temporary agency workers who lack familiarity with our equipment or standards.
        </p>
      </div>

      <!-- Business Credentials Card -->
      <div class="lg:col-span-5 p-8 bg-slate-50 dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 space-y-6 shadow-sm">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white">Business Verification & Standards</h3>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Complete transparency in our legal status, operational insurance, and vehicle fleet compliance.
        </p>
        
        <div class="space-y-4 text-xs sm:text-sm">
          <div class="flex items-start gap-3.5 pb-3 border-b border-slate-200/60 dark:border-slate-800">
            <span class="text-amber-500 mt-1 shrink-0"><Icon name="shield" class="w-5 h-5" /></span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold">£50,000 Goods in Transit Cover</strong>
              <span class="text-slate-600 dark:text-slate-400 text-xs">Underwritten cover protecting your furniture and valuables during transit.</span>
            </div>
          </div>

          <div class="flex items-start gap-3.5 pb-3 border-b border-slate-200/60 dark:border-slate-800">
            <span class="text-amber-500 mt-1 shrink-0"><Icon name="shield-check" class="w-5 h-5" /></span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold">£2,000,000 Public Liability Cover</strong>
              <span class="text-slate-600 dark:text-slate-400 text-xs">Protection against accidental structural or third-party property damage.</span>
            </div>
          </div>

          <div class="flex items-start gap-3.5 pb-3 border-b border-slate-200/60 dark:border-slate-800">
            <span class="text-amber-500 mt-1 shrink-0"><Icon name="truck" class="w-5 h-5" /></span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold">Euro 6 Clean Air Zone Compliant Fleet</strong>
              <span class="text-slate-600 dark:text-slate-400 text-xs">Zero emissions penalty fees inside Birmingham's A4540 Middleway ring road.</span>
            </div>
          </div>

          <div class="flex items-start gap-3.5 pb-3 border-b border-slate-200/60 dark:border-slate-800">
            <span class="text-amber-500 mt-1 shrink-0"><Icon name="check" class="w-5 h-5" /></span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold">Registered UK Limited Company</strong>
              <span class="text-slate-600 dark:text-slate-400 text-xs">Companies House No: {siteConfig.companyNumber} · VAT Reg: {siteConfig.vatNumber}</span>
            </div>
          </div>

          <div class="flex items-start gap-3.5">
            <span class="text-amber-500 mt-1 shrink-0"><Icon name="clock" class="w-5 h-5" /></span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold">Operating 7 Days a Week</strong>
              <span class="text-slate-600 dark:text-slate-400 text-xs">Monday to Sunday, 07:00 to 20:00 for flexible weekend completion days.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 2: Fleet & Equipment Architecture -->
    <div class="p-8 sm:p-12 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-8">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
          Purpose-Built Fleet & Kit
        </span>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          The Equipment Behind Every Successful Move
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Proper equipment is what separates a professional removal company from an amateur man-and-van service. We invest continuously in our fleet of 3.5-tonne Luton box vans and specialist handling apparatus to ensure zero damage to your furniture, carpets, and entrance door frames.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
            <Icon name="truck" class="w-5 h-5" />
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">Luton Vans with Tail Lifts</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Our vans feature 500kg hydraulic column tail lifts, allowing heavy white goods, upright pianos, and solid oak wardrobes to be loaded level without tipping or physical strain.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
            <Icon name="shield-check" class="w-5 h-5" />
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">Transit Blanket & Webbing Rails</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Every vehicle interior is carpet-lined and fitted with multi-tier load-lock tracks. Possessions are wrapped in quilted woolen blankets and secured firmly with ratchet webbing.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
            <Icon name="box" class="w-5 h-5" />
          </div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">Floor & Door Frame Protection</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Before carrying the first box, our porters lay non-slip neoprene carpet runners and apply padded jamb protectors to internal doorways to prevent scuffs, dirt, and scratches.
          </p>
        </div>
      </div>
    </div>

    <!-- Section 3: Clean Air Zone Exemption Notice -->
    <CleanAirZoneNotice variant="full" />

    <!-- Section 4: Our 4 Operating Principles -->
    <div class="space-y-8">
      <div class="text-center max-w-2xl mx-auto">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Our 4 Core Operating Principles</h3>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Every relocation we undertake is governed by these straightforward commitments.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl space-y-2">
          <div class="text-amber-500 font-extrabold text-lg">01</div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">Guaranteed Fixed Pricing</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Once we survey your inventory and access, our written price is fixed. We do not add unexpected fuel levies, stair charges, or Clean Air Zone surcharges.
          </p>
        </div>

        <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl space-y-2">
          <div class="text-amber-500 font-extrabold text-lg">02</div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">Punctuality & Tracking</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            We schedule realistic departure windows and monitor West Midlands traffic live via telematics, keeping you informed before our vehicles arrive.
          </p>
        </div>

        <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl space-y-2">
          <div class="text-amber-500 font-extrabold text-lg">03</div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">Permanent Uniformed Staff</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Your belongings are handled exclusively by vetted, polite, and uniformed employees who treat your furniture and personal memories with genuine respect.
          </p>
        </div>

        <div class="p-6 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl space-y-2">
          <div class="text-amber-500 font-extrabold text-lg">04</div>
          <h4 class="text-base font-bold text-slate-900 dark:text-white">Chain Delay Understanding</h4>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Solicitor completion holdups happen. We remain with your loaded vehicle patiently outside your new property while waiting for estate keys to be released.
          </p>
        </div>
      </div>
    </div>

    <!-- Conversion CTA -->
    <CTABand
      variant="quote"
      heading="Looking for a Trustworthy Removals Partner in Birmingham?"
      subheading="Speak directly with our operations team or request a detailed, fixed-price quote online."
      primaryCtaText="Get a Free Quote"
      primaryCtaHref="/get-a-quote/"
    />
  </div>
</BaseLayout>
