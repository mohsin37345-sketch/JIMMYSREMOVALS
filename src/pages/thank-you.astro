---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Icon from 'theme/components/Icon.astro';
import site from 'src/data/site';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Thank You', item: '/thank-you/' }
];
---

<BaseLayout
  title="Thank You for Your Quote Request | Jimmys Removals"
  description="Thank you for contacting Jimmys Removals and Logistics LTD. We will review your moving details and provide your fixed-price quote within 2 working hours."
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <div class="min-h-[70vh] flex items-center justify-center py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 p-8 sm:p-12 shadow-xl text-center">
      
      <!-- Success Icon -->
      <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-6 shadow-sm">
        <Icon name="check" class="w-8 h-8 sm:w-10 sm:h-10" />
      </div>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-4">
        Quote Request Received
      </span>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Thank You! We're On It.
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl mx-auto">
        Your enquiry has been delivered directly to our Birmingham dispatch office. One of our moving coordinators will review your route, property size, and schedule to calculate an itemised, fixed-price quote.
      </p>

      <!-- Response Window Callout -->
      <div class="mt-6 p-4 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 text-sm text-slate-700 dark:text-slate-300 flex items-center justify-center gap-3">
        <Icon name="clock" class="w-5 h-5 text-amber-500 shrink-0" />
        <span>Expect your quote within <strong>2 working hours</strong> (Monday - Saturday, 8am - 7pm).</span>
      </div>

      <!-- Urgent Move Callout -->
      <div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800 text-left">
        <h2 class="text-base font-bold text-slate-900 dark:text-white mb-2">
          Need an immediate response or booking a same-day move?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-4">
          If your move is within the next 48 hours, speak directly to our logistics team on the phone or message us via WhatsApp.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={site.phoneHref}
            class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-sm hover:opacity-90 transition-opacity"
          >
            <Icon name="phone" class="w-4 h-4" />
            <span>Call {site.phone}</span>
          </a>
          <a
            href={site.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition-colors"
          >
            <Icon name="whatsapp" class="w-4 h-4" />
            <span>WhatsApp Us Now</span>
          </a>
        </div>
      </div>

      <!-- Return Links -->
      <div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-600 dark:text-slate-400">
        <a href="/" class="hover:text-amber-500 transition-colors">Return to Home</a>
        <span>&bull;</span>
        <a href="/removals/" class="hover:text-amber-500 transition-colors">View All Services</a>
        <span>&bull;</span>
        <a href="/moving-cost-calculator/" class="hover:text-amber-500 transition-colors">Cost Calculator</a>
      </div>

    </div>
  </div>
</BaseLayout>
