---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ContactForm from 'theme/components/ContactForm.astro';
import ImageSlot from 'theme/components/ImageSlot.astro';
import Icon from 'theme/components/Icon.astro';
import { siteConfig } from 'src/data/site';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Guides', item: '/guides/' },
  { name: 'Birmingham Clean Air Zone Removals', item: '/guides/birmingham-clean-air-zone-removals/' }
];

const faqs = [
  {
    question: 'Are there Clean Air Zone charges for removals in Birmingham?',
    answer: 'No Clean Air Zone charges are added to your quote. We operate inside the A4540 Middleway ring road with zero CAZ surcharges for our customers.'
  },
  {
    question: 'Where is the Birmingham Clean Air Zone boundary located?',
    answer: 'The Birmingham Clean Air Zone encompasses all roads enclosed within the A4540 Middleway ring road, including the city centre, Jewellery Quarter, Digbeth, and Southside.'
  },
  {
    question: 'Do other removal companies pass CAZ charges to customers?',
    answer: 'Some operators add daily vehicle fees onto customer invoices when entering the central zone. Jimmys Removals provides guaranteed fixed quotes with zero CAZ surcharges.'
  },
  {
    question: 'What size vans do you operate inside the Birmingham CAZ?',
    answer: 'We operate 3.5-tonne Luton low-loader box vans equipped with 500kg hydraulic tail lifts, providing ideal urban maneuverability and volume for city-centre apartment moves.'
  }
];
---

<BaseLayout
  title="Birmingham Clean Air Zone Removals | Zero CAZ Surcharges"
  description="Guide to moving within the Birmingham Clean Air Zone (A4540 Middleway). Guaranteed fixed removal quotes with zero CAZ surcharges added."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-8 pb-16 lg:pb-24 border-b border-slate-800 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6 text-slate-400" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <Icon name="shield-check" class="w-3.5 h-3.5" />
            <span>Birmingham CAZ Moving Guide</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Birmingham Clean Air Zone Removals: What You Need to Know
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            Moving into, out of, or across central Birmingham? Learn how the Clean Air Zone boundary operates inside the A4540 Middleway and book your move with zero CAZ surcharges guaranteed.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="#quote-form"
              class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all hover:scale-[1.02] flex items-center gap-2"
            >
              <span>Get a Fixed Quote</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>

            <a
              href={siteConfig.phoneHref}
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition-all flex items-center gap-2"
            >
              <Icon name="phone" class="w-4 h-4 text-amber-400" />
              <span>Call {siteConfig.phone}</span>
            </a>
          </div>

          <!-- Trust Strip -->
          <div class="pt-6 border-t border-slate-800/80">
            <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-300 font-medium">
              <li class="flex items-center gap-1.5">
                <Icon name="clock" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Open 24 hours, 7 days a week</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="shield-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>DBS-checked crews</span>
              </li>
              <li class="flex items-center gap-1.5 text-amber-400">
                <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Zero CAZ surcharges</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fully insured</span>
              </li>
            </ul>
          </div>

          <!-- Image Slot 1: Hero (16/9) -->
          <div class="pt-4">
            <ImageSlot
              src=""
              alt="Removals Luton van operating in central Birmingham Clean Air Zone"
              aspect="16/9"
              slotId="hero"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        <!-- Hero Quote Form (5 cols) -->
        <div id="quote-form" class="lg:col-span-5 bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white">
          <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Zero CAZ Surcharges</span>
            <h3 class="text-xl font-bold mt-1">Check Your Move Price</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
              Fixed quotes with no Clean Air Zone charges added.
            </p>
          </div>
          <ContactForm formType="quick-quote" prefilledLocation="Birmingham" />
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-12 lg:py-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Section: Boundary Explanation -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Understanding the Birmingham Clean Air Zone Boundary
        </h2>
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          The Birmingham Clean Air Zone (CAZ) covers all public roads inside the A4540 Middleway ring road. This includes central shopping districts, business quarters around Colmore Row and Snow Hill, and major residential apartment zones across the Jewellery Quarter, Digbeth, Gun Quarter, Holloway Head, and Southside.
        </p>
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          The A4540 ring road itself is not part of the charging zone, but any road leading into the central district is monitored by automatic number plate recognition cameras 24 hours a day.
        </p>
      </div>

      <!-- Key Zone Details Card -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2">
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Operating Hours</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            The zone operates 24 hours a day, 365 days a year. Midnight marks the start of each daily charging period.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2">
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Zero CAZ Surcharges</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            When you move with Jimmys Removals, zero Clean Air Zone surcharges are added to your quotation.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2">
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Central Access</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Our 3.5-tonne Luton vans operate freely across the inner ring road with direct loading access to apartment developments.
          </p>
        </div>
      </div>

      <!-- Image Slot 2: Local (4/3) -->
      <div>
        <ImageSlot
          src=""
          alt="Clean Air Zone Middleway road signs and Luton removal van in Birmingham"
          aspect="4/3"
          slotId="local"
          loading="lazy"
        />
      </div>

      <!-- Moving Tips inside CAZ -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Practical Tips for Moving Inside the Birmingham CAZ
        </h2>
        <div class="space-y-3">
          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">1. Book Apartment Lifts Early</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Many city-centre buildings require you to reserve service elevators. Secure a dedicated 2-to-3 hour window to ensure smooth, rapid transfer.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">2. Check Loading Bay Approvals</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Certain developments along Broad Street and Digbeth have gated loading yards. Inform concierge of our van registration so gates are opened promptly.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
            <h3 class="text-sm font-bold text-slate-900 dark:text-white">3. Demand Fixed Pricing</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              Always confirm that your written removals quotation explicitly excludes clean air zone daily charges.
            </p>
          </div>
        </div>
      </div>

      <!-- Image Slot 3: Team (4/3) -->
      <div>
        <ImageSlot
          src=""
          alt="Removals crew moving apartment furnishings in Birmingham city centre"
          aspect="4/3"
          slotId="team"
          loading="lazy"
        />
      </div>

      <!-- FAQs -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Frequently Asked CAZ Questions
        </h2>
        <div class="space-y-3">
          {faqs.map((faq, idx) => (
            <details class="group p-5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-all [&_summary::-webkit-details-marker]:hidden" open={idx === 0}>
              <summary class="flex items-center justify-between cursor-pointer font-bold text-sm sm:text-base text-slate-900 dark:text-white gap-4">
                <span>{faq.question}</span>
                <span class="text-amber-500 shrink-0 group-open:rotate-180 transition-transform">
                  <Icon name="chevron-down" class="w-5 h-5" />
                </span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-200/60 dark:border-slate-700/60 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-12 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold">Ready to Book Your Birmingham Move?</h2>
      <p class="text-xs sm:text-sm text-slate-300">
        Guaranteed fixed quotes with zero Clean Air Zone charges added. Available 24 hours, 7 days a week.
      </p>
      <div class="flex justify-center gap-3 pt-2">
        <a href="#quote-form" class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shadow transition">
          Get a Fixed Quote
        </a>
        <a href={siteConfig.phoneHref} class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs border border-slate-700 transition">
          Call {siteConfig.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- NAP Block -->
  <section class="py-8 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs text-slate-500 text-center space-y-1">
      <p><strong>{siteConfig.legalName}</strong> (trading as {siteConfig.tradingName}) · Company No: {siteConfig.companyNumber}</p>
      <p>{siteConfig.address.fullAddress} · Phone: {siteConfig.phone} · Open 24 hours, 7 days a week</p>
    </div>
  </section>
</BaseLayout>
