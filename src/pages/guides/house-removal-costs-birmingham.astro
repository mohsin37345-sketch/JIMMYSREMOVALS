---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ContactForm from 'theme/components/ContactForm.astro';
import ImageSlot from 'theme/components/ImageSlot.astro';
import Icon from 'theme/components/Icon.astro';
import { pricingData } from 'src/data/pricing';
import { siteConfig } from 'src/data/site';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Guides', item: '/guides/' },
  { name: 'House Removal Costs Birmingham', item: '/guides/house-removal-costs-birmingham/' }
];

const faqs = [
  {
    question: 'How much do house removals cost in Birmingham?',
    answer: 'House removals in Birmingham typically range from £220 to £400 for a 1-bedroom flat, £320 to £600 for a 2-bedroom property, £500 to £850 for a 3-bedroom house, and from £800 for 4 bedrooms or larger. Final costs depend on inventory volume, access, and distance, with guaranteed fixed quotes provided before booking.'
  },
  {
    question: 'Are there Clean Air Zone charges added to my Birmingham move?',
    answer: 'No Clean Air Zone charges are added to your quote. We operate inside the A4540 Middleway ring road with zero CAZ surcharges for our customers.'
  },
  {
    question: 'What is included in a fixed-price house removal quote?',
    answer: 'Our quotes include an equipped 3.5-tonne Luton van with tail lift, directly employed DBS-checked movers, protective furniture blankets, floor runners, mattress covers, loading, transport, and room-of-choice placement.'
  },
  {
    question: 'How do I ensure my removal quote remains fixed?',
    answer: 'Provide an accurate inventory of furniture and boxed items during your initial survey, along with details regarding parking, staircases, and key exchange timing.'
  }
];
---

<BaseLayout
  title="House Removal Costs Birmingham | 2026 Price Guide & Checklist"
  description="Clear guide to house removals Birmingham prices. Property tier cost benchmarks, price factors, fixed quotes, and zero CAZ surcharges."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-8 pb-16 lg:pb-24 border-b border-slate-800 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6 text-slate-400" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <Icon name="tag" class="w-3.5 h-3.5" />
            <span>Birmingham Removals Cost Guide</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            House Removal Costs in Birmingham: Complete Price Guide
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            Planning a move in Birmingham? Explore realistic property-by-property cost benchmarks, understand key pricing factors, and secure a guaranteed fixed quote with zero hidden charges.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="#quote-form"
              class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all hover:scale-[1.02] flex items-center gap-2"
            >
              <span>Get a Fixed Quote</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>

            <a
              href={siteConfig.phoneHref}
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition-all flex items-center gap-2"
            >
              <Icon name="phone" class="w-4 h-4 text-amber-400" />
              <span>Call {siteConfig.phone}</span>
            </a>
          </div>

          <!-- Trust Strip -->
          <div class="pt-6 border-t border-slate-800/80">
            <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-300 font-medium">
              <li class="flex items-center gap-1.5">
                <Icon name="clock" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Open 24 hours, 7 days a week</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="shield-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>DBS-checked crews</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fully insured</span>
              </li>
              <li class="flex items-center gap-1.5 text-amber-400">
                <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Zero CAZ surcharges</span>
              </li>
            </ul>
          </div>

          <!-- Image Slot 1: Hero (16/9) -->
          <div class="pt-4">
            <ImageSlot
              src=""
              alt="House removals pricing calculator and Luton van loading in Birmingham"
              aspect="16/9"
              slotId="hero"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        <!-- Hero Quote Form (5 cols) -->
        <div id="quote-form" class="lg:col-span-5 bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white">
          <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Guaranteed Fixed Quote</span>
            <h3 class="text-xl font-bold mt-1">Check Your Move Price</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
              Fixed pricing with no hidden charges. Punctual arrivals day and night.
            </p>
          </div>
          <ContactForm formType="quick-quote" prefilledLocation="Birmingham" />
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-12 lg:py-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Section: Average Costs Overview -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          What Is the Average Cost of House Removals in Birmingham?
        </h2>
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          The cost of moving home across Birmingham depends on property dimensions, total furniture volume, accessibility, and transit mileage. Unlike hourly transport services that leave you exposed to escalating costs if traffic builds up or completion is delayed, professional removals companies provide comprehensive fixed quotations.
        </p>
      </div>

      <!-- Pricing Table -->
      <div class="overflow-x-auto rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-700/50 text-slate-900 dark:text-white text-xs font-bold uppercase tracking-wider">
              <th class="py-3.5 px-4 sm:px-6">Property Size</th>
              <th class="py-3.5 px-4 sm:px-6">Guide Price Range</th>
              <th class="py-3.5 px-4 sm:px-6">Typical Vehicle & Team</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200/60 dark:divide-slate-700/60 text-xs sm:text-sm">
            {pricingData.houseRemovals.tiers.map((tier) => (
              <tr>
                <td class="py-3.5 px-4 sm:px-6 font-bold text-slate-900 dark:text-white">
                  {tier.propertyType}
                </td>
                <td class="py-3.5 px-4 sm:px-6 font-extrabold text-amber-600 dark:text-amber-400">
                  {tier.guideRange}
                </td>
                <td class="py-3.5 px-4 sm:px-6 text-slate-600 dark:text-slate-300">
                  {tier.description}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Image Slot 2: Local (4/3) -->
      <div>
        <ImageSlot
          src=""
          alt="Removals crew operating Luton van in Birmingham street"
          aspect="4/3"
          slotId="local"
          loading="lazy"
        />
      </div>

      <!-- Price Factors -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Key Factors That Influence Your Birmingham Move Price
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {pricingData.priceFactors.map((factor) => (
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">{factor.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{factor.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Clean Air Zone Cost Protection -->
      <div class="p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-slate-900 dark:text-white space-y-2">
        <h3 class="text-lg font-bold">Zero Clean Air Zone Surcharges Guaranteed</h3>
        <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          The Birmingham Clean Air Zone encompasses all roads inside the A4540 Middleway ring road. When booking with Jimmys Removals, you receive zero CAZ surcharges on your move, with no Clean Air Zone charges added to your quote.
        </p>
      </div>

      <!-- Image Slot 3: Team (4/3) -->
      <div>
        <ImageSlot
          src=""
          alt="Uniformed Jimmys Removals team unloading furniture into Birmingham property"
          aspect="4/3"
          slotId="team"
          loading="lazy"
        />
      </div>

      <!-- FAQs -->
      <div class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Frequently Asked Cost Questions
        </h2>
        <div class="space-y-3">
          {faqs.map((faq, idx) => (
            <details class="group p-5 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-all [&_summary::-webkit-details-marker]:hidden" open={idx === 0}>
              <summary class="flex items-center justify-between cursor-pointer font-bold text-sm sm:text-base text-slate-900 dark:text-white gap-4">
                <span>{faq.question}</span>
                <span class="text-amber-500 shrink-0 group-open:rotate-180 transition-transform">
                  <Icon name="chevron-down" class="w-5 h-5" />
                </span>
              </summary>
              <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-200/60 dark:border-slate-700/60 pt-3">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-12 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h2 class="text-2xl sm:text-3xl font-extrabold">Get Your Fixed Birmingham Removal Quote Today</h2>
      <p class="text-xs sm:text-sm text-slate-300">
        Our directly employed moving crews operate 24 hours, 7 days a week across Birmingham and the West Midlands.
      </p>
      <div class="flex justify-center gap-3 pt-2">
        <a href="#quote-form" class="px-6 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shadow transition">
          Get a Fixed Quote
        </a>
        <a href={siteConfig.phoneHref} class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs border border-slate-700 transition">
          Call {siteConfig.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- NAP Block -->
  <section class="py-8 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-xs text-slate-500 text-center space-y-1">
      <p><strong>{siteConfig.legalName}</strong> (trading as {siteConfig.tradingName}) · Company No: {siteConfig.companyNumber}</p>
      <p>{siteConfig.address.fullAddress} · Phone: {siteConfig.phone} · Open 24 hours, 7 days a week</p>
    </div>
  </section>
</BaseLayout>
