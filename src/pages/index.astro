---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import ServiceGrid from 'theme/components/ServiceGrid.astro';
import CostCalculator from 'theme/components/CostCalculator.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import AreaCoverageMap from 'theme/components/AreaCoverageMap.astro';
import PricingTable from 'theme/components/PricingTable.astro';
import ComparisonTable from 'theme/components/ComparisonTable.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import FAQ from 'theme/components/FAQ.astro';
import FeaturedPosts from 'theme/components/FeaturedPosts.astro';
import CTABand from 'theme/components/CTABand.astro';
import FleetShowcase from 'theme/components/FleetShowcase.astro';
import Icon from 'theme/components/Icon.astro';
import { getCollection } from 'astro:content';
import faqsData from 'src/data/faqs.json';

// Fetch collection items
let services: any[] = [];
try {
  services = await getCollection('services');
  services.sort((a, b) => a.data.order - b.data.order);
} catch (e) {
  services = [];
}

let testimonials: any[] = [];
try {
  const tCollection = await getCollection('testimonials');
  testimonials = tCollection.map((t) => t.data).filter((t) => t.verified);
} catch (e) {
  testimonials = [];
}

let posts: any[] = [];
try {
  posts = await getCollection('blog', ({ data }) => !data.draft);
} catch (e) {
  posts = [];
}

// Homepage specific FAQs including Clean Air Zone
const homepageFaqs = [
  {
    question: "Do you charge extra for Birmingham Clean Air Zone (CAZ) moves?",
    answer: "No. Our entire fleet of modern Luton vans and commercial vehicles meets Euro 6 low-emission regulations. When moving into or out of Birmingham city centre inside the A4540 Middleway, you will never receive a CAZ surcharge or penalty pass-through on your invoice.",
    display: true
  },
  ...faqsData
];
---

<BaseLayout
  title="Jimmys Removals Birmingham | House Removals & Logistics West Midlands"
  description="Professional house removals, flat moves, and logistics across Birmingham, Solihull, Coventry and the Black Country. Fully insured, DBS-checked crew, Clean Air Zone compliant vans."
  schemaType="Home"
  faqs={homepageFaqs}
  reviews={testimonials}
>
  <!-- 1. Hero: Single h1, primary keyword, subheading, dual CTA, LCP-optimised layout -->
  <Hero
    variant="home"
    title="Stress-Free House Removals Across Birmingham & the West Midlands"
  />

  <!-- 2. Trust Strip -->
  <TrustStrip />

  <!-- 3. Intro Paragraph Section: Who we are, where we cover, addressing real anxieties -->
  <section class="py-16 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Text Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400">
            <Icon name="map-pin" class="w-4 h-4" />
            <span>West Midlands Removals & Logistics Specialists</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Reliable, Punctual Relocations Across Birmingham, the Black Country & Beyond
          </h2>

          <div class="text-sm sm:text-base text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed">
            <p>
              At Jimmys Removals and Logistics LTD, we know moving house is consistently ranked among life's most stressful experiences. Based at Phoenix Business Park in Birmingham, our full-time, DBS-checked removal specialists provide domestic and commercial relocation services across all 37 West Midlands towns and boroughs, as well as dedicated nationwide transit across mainland Britain.
            </p>
            <p>
              Whether you are moving out of a period Victorian terrace in Harborne, an apartment in Digbeth within Birmingham's Clean Air Zone, a family detached home in Solihull, or commercial offices in Coventry, we eliminate the uncertainty. Every booking includes full transit blanket wrapping, heavy-duty webbing straps, mattress protection bags, and up to £50,000 Goods in Transit insurance cover with transparent, fixed pricing and zero hidden fees.
            </p>
          </div>

          <div class="pt-2 flex flex-wrap gap-4 text-xs font-semibold text-slate-700 dark:text-slate-300">
            <span class="flex items-center gap-1.5"><Icon name="shield-check" class="w-4 h-4 text-emerald-500" /> £50k Goods in Transit</span>
            <span class="flex items-center gap-1.5"><Icon name="shield-check" class="w-4 h-4 text-emerald-500" /> £2m Public Liability</span>
            <span class="flex items-center gap-1.5"><Icon name="check" class="w-4 h-4 text-emerald-500" /> Euro 6 CAZ Compliant</span>
            <span class="flex items-center gap-1.5"><Icon name="clock" class="w-4 h-4 text-emerald-500" /> 7 Days a Week</span>
          </div>
        </div>

        <!-- Featured Real Fleet Card -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200 dark:border-slate-800 group bg-slate-900">
            <picture>
              <source srcset="/images/moves/luton-van-tail-lift.webp" type="image/webp" />
              <img
                src="/images/moves/luton-van-tail-lift.jpg"
                alt="Jimmys Removals 3.5T Luton box van with hydraulic tail-lift lowered on street in Birmingham"
                width="800"
                height="1066"
                class="w-full h-[400px] sm:h-[460px] object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/40 to-transparent"></div>

            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500 text-slate-950 shadow-md">
                <span class="w-2 h-2 rounded-full bg-slate-950 animate-pulse"></span>
                Real Move in Progress
              </span>
            </div>

            <div class="absolute bottom-5 left-5 right-5 text-white space-y-2">
              <div class="flex items-center gap-2 text-xs font-semibold text-amber-300">
                <Icon name="truck" class="w-4 h-4" />
                <span>3.5T Luton Box Van • 500kg Tail-Lift</span>
              </div>
              <h3 class="text-lg font-bold text-white leading-snug">
                Ground-Level Loading & Zero Heavy Lifting Strain
              </h3>
              <p class="text-xs text-slate-300 leading-snug">
                Electric tail-lift allows seamless roll-on loading for heavy sofas, appliances and solid oak furniture.
              </p>
              <div class="pt-1 flex items-center justify-between">
                <a
                  href="#fleet-showcase"
                  class="inline-flex items-center gap-1 text-xs font-bold text-amber-400 hover:text-amber-300 transition"
                >
                  <span>See All 3 Fleet Photos</span>
                  <Icon name="chevron-right" class="w-3.5 h-3.5" />
                </a>
                <span class="text-[11px] text-slate-400">Solihull & Bham</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Quote Tool Area: Interactive Moving Cost Calculator above the fold on desktop -->
  <section class="py-14 bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <CostCalculator />
    </div>
  </section>

  <!-- 5. Services Grid: All 12 specialist services with icons, from-prices and hover lifts -->
  <section class="py-16 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
          Our Capabilities
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mt-1">
          Complete Removals & Logistics Solutions
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2">
          From single-room student moves to comprehensive 5-bedroom full-pack domestic relocations, discover our 12 specialist services.
        </p>
      </div>

      <ServiceGrid services={services} />
    </div>
  </section>

  <!-- 6. How Jimmys Removals Works: 4 numbered steps with connecting line -->
  <HowItWorks />

  <!-- 6.5 Real Fleet & Equipment Showcase: Modern 3-Photo Interactive Gallery & Lightbox -->
  <FleetShowcase />

  <!-- 7. Areas Covered: Click-to-load map + linked town list grouped into 4 regional clusters -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/60 border-y border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
          West Midlands Network
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white mt-1">
          Areas We Cover Daily
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-2">
          Daily removals coverage across Birmingham, the Black Country, Coventry, Warwickshire, and border districts.
        </p>
      </div>

      <AreaCoverageMap />
    </div>
  </section>

  <!-- 8. Pricing & Comparison Table Section -->
  <section class="py-16 bg-white dark:bg-slate-950 space-y-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <PricingTable />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ComparisonTable />
    </div>
  </section>

  <!-- 9. Reviews: Verified customer testimonials, hides itself when empty -->
  {testimonials.length > 0 && (
    <Testimonials testimonials={testimonials} />
  )}

  <!-- 10. Frequently Asked Questions -->
  <FAQ faqs={homepageFaqs} />

  <!-- 11. Featured Blog Posts (Resilient Empty-State Fallback) -->
  <FeaturedPosts posts={posts} />

  <!-- 12. Primary Conversion CTA Band -->
  <CTABand
    variant="quote"
    heading="Ready to Plan Your West Midlands Relocation?"
    subheading="Speak directly with our Birmingham operations team for instant availability, advice, and a guaranteed fixed quotation."
    primaryCtaText="Get a Free Quote"
    primaryCtaHref="/get-a-quote/"
  />
</BaseLayout>
