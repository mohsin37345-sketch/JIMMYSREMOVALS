---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import WhyChooseUs from 'theme/components/WhyChooseUs.astro';
import CostTable from 'theme/components/CostTable.astro';
import ServiceGrid from 'theme/components/ServiceGrid.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import FleetShowcase from 'theme/components/FleetShowcase.astro';
import AreaCoverageMap from 'theme/components/AreaCoverageMap.astro';
import ComparisonTable from 'theme/components/ComparisonTable.astro';
import Testimonials from 'theme/components/Testimonials.astro';
import AboutEeatBlock from 'theme/components/AboutEeatBlock.astro';
import GuidesTeaser from 'theme/components/GuidesTeaser.astro';
import FAQ from 'theme/components/FAQ.astro';
import CTABand from 'theme/components/CTABand.astro';
import { getCollection } from 'astro:content';
import faqsData from 'src/data/faqs.json';

// Fetch collection items
let services: any[] = [];
try {
  services = await getCollection('services');
  services.sort((a, b) => a.data.order - b.data.order);
} catch (e) {
  services = [];
}

let testimonials: any[] = [];
try {
  const tCollection = await getCollection('testimonials');
  testimonials = tCollection
    .map((t) => t.data)
    .filter((t) => t.verified)
    .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
} catch (e) {
  testimonials = [];
}
---

<BaseLayout
  title="House Removals Birmingham | Jimmys Removals & Logistics"
  description="Looking for a trusted house removals company in Birmingham? DBS-checked movers handle removals across Birmingham and the West Midlands with Fully insured."
  schemaType="Home"
  faqs={faqsData}
  reviews={testimonials}
>
  <!-- 1. HERO — Single H1 + H2 subhead + 3-field quote form + trust bar -->
  <Hero
    variant="home"
    title="House Removals Birmingham & the West Midlands"
  />

  <!-- Trust Strip Badges -->
  <TrustStrip />

  <!-- 2. WHY BIRMINGHAM MOVERS CHOOSE JIMMYS REMOVALS — H2 + 4× H3 trust pillars -->
  <WhyChooseUs />

  <!-- 3. HOW MUCH DO HOUSE REMOVALS COST IN BIRMINGHAM? — H2 + Crawlable HTML table + Price factors + Man & Van vs Fixed + Estimator island -->
  <CostTable />

  <!-- 4. OUR REMOVALS & LOGISTICS SERVICES IN BIRMINGHAM — H2 + 12× H3s (60-90 words, from £X, descriptive links to /services/{slug}/) -->
  <section id="services" class="py-16 sm:py-20 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
          Tailored Relocation Solutions
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mt-1 tracking-tight">
          Our Removals & Logistics Services in Birmingham
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
          From single-room student moves to comprehensive 5-bedroom full-pack domestic house moves and commercial office relocations, discover our 12 specialist services.
        </p>
      </div>

      <ServiceGrid services={services} />
    </div>
  </section>

  <!-- 5. HOW OUR REMOVAL PROCESS WORKS — H2 + 4 Step H3s + Moving on Completion Day H3 -->
  <HowItWorks />

  <!-- 6. INSIDE OUR MODERN 3.5T LUTON FLEET — H2 + 3 Photo blocks H3 + Van size comparison H3 + Protection materials H3 -->
  <FleetShowcase />

  <!-- 7. AREAS WE COVER ACROSS BIRMINGHAM & THE WEST MIDLANDS — H2 + 4 Regional H3s + 37 Town Links + Interactive Corridors Map -->
  <section id="areas-covered" class="py-16 sm:py-20 bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-3xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
          All 37 Towns Connected Daily
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white mt-1 tracking-tight">
          Areas We Cover Across Birmingham & the West Midlands
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
          Explore daily coverage across Birmingham (B1–B48), the Black Country, Coventry, Solihull, and border districts with direct transit along M6, M5, M42, and A38(M) corridors.
        </p>
      </div>

      <AreaCoverageMap />
    </div>
  </section>


  <!-- 9. JIMMYS REMOVALS VS CASUAL MOVERS VS DIY VAN HIRE — H2 + Crawlable Comparison Table -->
  <ComparisonTable title="Jimmys Removals vs Casual Movers vs DIY Van Hire" />

  <!-- 10. VERIFIED CUSTOMER REVIEWS — H2 + Linked to Google Business Profile -->
  <Testimonials testimonials={testimonials} title="Verified Customer Reviews" />

  <!-- 11. ABOUT JIMMYS REMOVALS AND LOGISTICS LTD — H2 + E-E-A-T facts + MAP -->
  <AboutEeatBlock />

  <!-- 12. MOVING HOUSE GUIDES & ADVICE — H2 + 4 Teaser Cards H3s linking to /moving-guides/ -->
  <GuidesTeaser />

  <!-- 13. HOUSE REMOVALS BIRMINGHAM FAQS — H2 + 16 FAQs, Cost Qs First, 6 Open by Default, All in Initial HTML -->
  <FAQ faqs={faqsData} title="House Removals Birmingham FAQs" />

  <!-- 14. GET YOUR FREE BIRMINGHAM REMOVALS QUOTE — Final CTA + NAP + Operating Hours -->
  <CTABand
    variant="quote"
    heading="Get Your Free Birmingham Removals Quote"
    subheading="Speak directly with our Birmingham operations team for instant availability, advice, and a guaranteed fixed quotation."
    primaryCtaText="Get a Free Quote"
    primaryCtaHref="/get-a-quote/"
  />
</BaseLayout>
