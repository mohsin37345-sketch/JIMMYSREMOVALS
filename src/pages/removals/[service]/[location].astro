---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import CleanAirZoneNotice from 'theme/components/CleanAirZoneNotice.astro';
import FAQ from 'theme/components/FAQ.astro';
import CTABand from 'theme/components/CTABand.astro';
import Icon from 'theme/components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const serviceAreas = await getCollection('serviceAreas');
  const services = await getCollection('services');
  const locations = await getCollection('locations');

  return serviceAreas.map((sa) => {
    const svc = services.find((s) => s.id === sa.data.service);
    const loc = locations.find((l) => l.id === sa.data.location);

    // Other dedicated services in this location
    const otherLocalDedicated = serviceAreas
      .filter((other) => other.data.location === sa.data.location && other.data.service !== sa.data.service)
      .map((other) => {
        const otherSvc = services.find((s) => s.id === other.data.service);
        return {
          title: `${otherSvc?.data.shortTitle || other.data.service} in ${loc?.data.town || ''}`,
          href: `/removals/${other.data.service}/${sa.data.location}/`
        };
      });

    // Other towns where this specific service operates
    const otherTownsWithService = serviceAreas
      .filter((other) => other.data.service === sa.data.service && other.data.location !== sa.data.location)
      .map((other) => {
        const otherLoc = locations.find((l) => l.id === other.data.location);
        return {
          title: `${svc?.data.shortTitle || ''} in ${otherLoc?.data.town || other.data.location}`,
          href: `/removals/${sa.data.service}/${other.data.location}/`
        };
      });

    return {
      params: {
        service: sa.data.service,
        location: sa.data.location
      },
      props: {
        item: sa.data,
        service: svc ? { ...svc.data, slug: svc.id } : null,
        location: loc ? { ...loc.data, slug: loc.id } : null,
        otherLocalDedicated,
        otherTownsWithService
      }
    };
  });
}

const { item, service, location, otherLocalDedicated = [], otherTownsWithService = [] } = Astro.props;

if (!service || !location) {
  throw new Error(`Missing service or location data for ${Astro.url.pathname}`);
}

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Removals', item: '/removals/' },
  { name: service.shortTitle, item: `/removals/${service.slug}/` },
  { name: location.town, item: `/removals/${service.slug}/${location.slug}/` }
];

const metaTitle = `${service.shortTitle} ${location.town} | Jimmys Removals`;
const metaDesc = `Professional ${service.shortTitle.toLowerCase()} in ${location.town} (${location.postcodes.slice(0, 3).join(', ')}). 100% CAZ compliant, £50k Goods in Transit cover, DBS-checked crew. Get a quote today.`;

const serviceData = {
  name: `${service.title} in ${location.town}`,
  description: item.uniqueIntro,
  priceFrom: service.priceFrom,
  url: `/removals/${service.slug}/${location.slug}/`
};
---

<BaseLayout
  title={metaTitle}
  description={metaDesc}
  schemaType="Service"
  breadcrumbs={breadcrumbs}
  faqs={item.faqs}
  serviceData={serviceData}
>
  <Hero
    variant="service"
    title={`${service.shortTitle} in ${location.town}`}
    subtitle={`Dedicated, fully insured ${service.shortTitle.toLowerCase()} tailored to ${location.town} and surrounding West Midlands communities.`}
    badge={`${location.town} Removals Specialist`}
    priceFrom={service.priceFrom}
    priceUnit={service.priceUnit}
  />

  <TrustStrip />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-16">
    <Breadcrumbs items={breadcrumbs} />

    {location.cleanAirZone.enabled && (
      <CleanAirZoneNotice variant="compact" />
    )}

    <!-- Local Service Overview -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-8 space-y-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
            {service.shortTitle} Tailored for {location.town} Residents & Businesses
          </h2>
          <p class="mt-4 text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            {item.uniqueIntro}
          </p>
        </div>

        <!-- Local Angle Callout -->
        <div class="p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-slate-800 dark:text-slate-200">
          <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-2">
            <Icon name="map-pin" class="w-5 h-5 text-amber-500" />
            <span>Local Access & Route Knowledge: {location.town}</span>
          </h3>
          <p class="text-sm leading-relaxed">
            {item.localAngle}
          </p>
        </div>

        <!-- Case Study -->
        {item.caseStudy && (
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <div class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 mb-3">
              Recent Local Job
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
              {item.caseStudy.title}
            </h3>
            <div class="space-y-2 text-sm text-slate-600 dark:text-slate-300">
              <p><strong>Challenge:</strong> {item.caseStudy.scenario}</p>
              <p><strong>Outcome:</strong> {item.caseStudy.outcome}</p>
            </div>
          </div>
        )}

        <!-- Service Inclusions -->
        <div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4">
            What's Included With Every {service.shortTitle} Booking
          </h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {service.whatsIncluded.map((inc: string) => (
              <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
                <span class="text-emerald-500 mt-0.5 shrink-0"><Icon name="check" class="w-4 h-4" /></span>
                <span>{inc}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-4 space-y-6">
        <!-- Quick Quote Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">
            Moving to or from {location.town}?
          </h3>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Postcodes served: {location.postcodes.join(', ')}
          </p>
          <div class="text-2xl font-extrabold text-slate-900 dark:text-white">
            From £{service.priceFrom} <span class="text-xs font-normal text-slate-500 dark:text-slate-400">/ {service.priceUnit}</span>
          </div>
          <a
            href="/get-a-quote/"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-md transition-colors"
          >
            <span>Request {location.town} Quote</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
        </div>

        <!-- Links to Town Page, Local Services & General Services -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4 text-sm">
          <div>
            <div class="font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-1.5">
              <Icon name="map-pin" class="w-4 h-4 text-amber-500" />
              <span>{location.town} Removals</span>
            </div>
            <ul class="space-y-1.5 text-xs">
              <li>
                <a href={`/areas/${location.slug}/`} class="text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1.5 font-medium">
                  <Icon name="chevron-right" class="w-3 h-3 shrink-0" />
                  <span>All {location.town} Services & Town Guide</span>
                </a>
              </li>
              {otherLocalDedicated.map((ols) => (
                <li>
                  <a href={ols.href} class="text-slate-600 dark:text-slate-300 hover:text-amber-500 flex items-center gap-1.5">
                    <Icon name="chevron-right" class="w-3 h-3 shrink-0 text-slate-400" />
                    <span>{ols.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="pt-3 border-t border-slate-200 dark:border-slate-800">
            <div class="font-bold text-slate-900 dark:text-white mb-2 flex items-center gap-1.5">
              <Icon name="truck" class="w-4 h-4 text-amber-500" />
              <span>{service.shortTitle} Hubs</span>
            </div>
            <ul class="space-y-1.5 text-xs">
              <li>
                <a href={`/removals/${service.slug}/`} class="text-amber-600 dark:text-amber-400 hover:underline flex items-center gap-1.5 font-medium">
                  <Icon name="chevron-right" class="w-3 h-3 shrink-0" />
                  <span>Main {service.shortTitle} Service Page</span>
                </a>
              </li>
              {otherTownsWithService.slice(0, 5).map((ots) => (
                <li>
                  <a href={ots.href} class="text-slate-600 dark:text-slate-300 hover:text-amber-500 flex items-center gap-1.5">
                    <Icon name="chevron-right" class="w-3 h-3 shrink-0 text-slate-400" />
                    <span>{ots.title}</span>
                  </a>
                </li>
              ))}
              <li>
                <a href="/areas/" class="text-slate-500 hover:text-amber-500 flex items-center gap-1.5">
                  <Icon name="chevron-right" class="w-3 h-3 shrink-0 text-slate-400" />
                  <span>All 37 West Midlands Areas</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Local FAQs -->
    <FAQ
      title={`Frequently Asked Questions: ${service.shortTitle} in ${location.town}`}
      subtitle={`Answers to common questions about moving in ${location.town}.`}
      items={item.faqs}
    />

    <!-- Cross-Linking Hub Grid: Other Services & Other Towns -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Other Services in this location -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <Icon name="truck" class="w-4 h-4 text-amber-500" />
          <span>More Moving Services in {location.town}</span>
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href={`/areas/${location.slug}/`} class="font-bold text-amber-600 dark:text-amber-400 hover:underline flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700">
              <span>View Full {location.town} Coverage & Local Notes</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </li>
          {otherLocalDedicated.map((ols) => (
            <li>
              <a href={ols.href} class="flex items-center justify-between p-2 rounded-lg hover:bg-white dark:hover:bg-slate-800 transition text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400">
                <span>{ols.title}</span>
                <Icon name="chevron-right" class="w-3.5 h-3.5 text-slate-400" />
              </a>
            </li>
          ))}
          <li>
            <a href="/removals/" class="flex items-center justify-between p-2 rounded-lg text-slate-500 hover:text-amber-600">
              <span>All 12 Removals & Logistics Services</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Other Towns for this service -->
      <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <Icon name="map-pin" class="w-4 h-4 text-amber-500" />
          <span>{service.shortTitle} in Other West Midlands Towns</span>
        </h3>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a href={`/removals/${service.slug}/`} class="font-bold text-amber-600 dark:text-amber-400 hover:underline flex items-center justify-between p-2.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700">
              <span>General {service.shortTitle} Overview & Prices</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </li>
          {otherTownsWithService.map((ots) => (
            <li>
              <a href={ots.href} class="flex items-center justify-between p-2 rounded-lg hover:bg-white dark:hover:bg-slate-800 transition text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400">
                <span>{ots.title}</span>
                <Icon name="chevron-right" class="w-3.5 h-3.5 text-slate-400" />
              </a>
            </li>
          ))}
          <li>
            <a href="/areas/" class="flex items-center justify-between p-2 rounded-lg text-slate-500 hover:text-amber-600">
              <span>All 37 West Midlands Towns & Coverage Map</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- CTABand -->
    <CTABand
      variant="quote"
      heading={`Book Your ${service.shortTitle} in ${location.town}`}
      subheading="Get a clear, fixed-price quote from our West Midlands removals team with zero Clean Air Zone fees."
      primaryCtaText={`Get a Quote for ${location.town}`}
      primaryCtaHref="/get-a-quote/"
    />
  </div>
</BaseLayout>
