---
import AreaLayout from 'theme/layouts/AreaLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations
    .filter((loc) => !loc.data.region)
    .map((loc) => ({
      params: { town: loc.id },
      props: {
        location: {
          ...loc.data,
          slug: loc.id
        }
      }
    }));
}

const { location } = Astro.props;
---

<AreaLayout location={location} />
