---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ServiceGrid from 'theme/components/ServiceGrid.astro';
import CleanAirZoneNotice from 'theme/components/CleanAirZoneNotice.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import CTABand from 'theme/components/CTABand.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Removals Services', item: '/removals/' }
];

const servicesCollection = await getCollection('services');

const services = servicesCollection.map((svc) => ({
  title: svc.data.title,
  slug: svc.id,
  shortTitle: svc.data.shortTitle,
  summary: svc.data.summary,
  priceFrom: svc.data.priceFrom,
  priceUnit: svc.data.priceUnit,
  icon: svc.data.icon,
  benefits: svc.data.benefits
}));
---

<BaseLayout
  title="Removals & Logistics Services Birmingham & West Midlands | Jimmys"
  description="Professional house, flat, and commercial removals across Birmingham and the West Midlands. Full packing, man & van, specialist piano transport and secure storage."
  breadcrumbs={breadcrumbs}
>
  <Hero
    variant="page"
    title="Professional Removals & Logistics Services"
    subtitle="From single-bedroom flats to corporate relocations, discover our full suite of moving, packing, and secure transport services across the West Midlands."
    badge="12 Specialist Services"
  />

  <TrustStrip />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-16">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Services Grid -->
    <section>
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl">
          Complete Moving Solutions Tailored to You
        </h2>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-300">
          Every move is handled by our in-house, uniformed crew with full £50,000 Goods in Transit and £2,000,000 Public Liability insurance cover.
        </p>
      </div>

      <ServiceGrid services={services} />
    </section>

    <!-- Clean Air Zone fleet notice -->
    <CleanAirZoneNotice variant="compact" />

    <!-- Process -->
    <HowItWorks />

    <!-- Quote CTA -->
    <CTABand
      variant="quote"
      heading="Ready for a Seamless, Stress-Free Move?"
      subheading="Get an upfront, fixed-price quote with no hidden extras or unexpected moving-day charges."
      primaryCtaText="Get a Fixed-Price Quote"
      primaryCtaHref="/get-a-quote/"
    />
  </div>
</BaseLayout>
