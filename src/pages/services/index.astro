---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ServiceGrid from 'theme/components/ServiceGrid.astro';
import HowItWorks from 'theme/components/HowItWorks.astro';
import CTABand from 'theme/components/CTABand.astro';
import Icon from 'theme/components/Icon.astro';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Services', item: '/services/' }
];

const servicesCollection = await getCollection('services');
const locationsCollection = await getCollection('locations');

const tier1Locations = locationsCollection
  .filter((l) => l.data.tier === 1)
  .sort((a, b) => a.data.town.localeCompare(b.data.town));

const services = servicesCollection.map((svc) => ({
  title: svc.data.title,
  slug: svc.id,
  shortTitle: svc.data.shortTitle,
  summary: svc.data.summary,
  priceFrom: svc.data.priceFrom,
  priceUnit: svc.data.priceUnit,
  icon: svc.data.icon,
  benefits: svc.data.benefits
}));
---

<BaseLayout
  title="Our Removals & Logistics Services | Jimmys Removals Birmingham"
  description="Explore all 12 specialist removals and logistics services from Jimmys Removals. House moves, flat relocations, man and van, office removals, and packing."
  breadcrumbs={breadcrumbs}
>
  <Hero
    variant="page"
    showQuoteForm={true}
    title="Our Removals & Logistics Services in Birmingham"
    subtitle="From single-bedroom flats to 5-bedroom full-pack family moves and corporate office relocations, discover our 12 specialist services across the West Midlands."
    badge="12 Specialist Services"
  />

  <TrustStrip />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-16">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Services Catalog Grid -->
    <section>
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white sm:text-4xl">
          Complete Moving Solutions Tailored to You
        </h2>
        <p class="mt-3 text-base text-slate-600 dark:text-slate-300">
          Every move is handled by our directly employed, DBS-checked movers, fully insured with guaranteed fixed pricing.
        </p>
      </div>

      <ServiceGrid services={services} />
    </section>

    <!-- Process -->
    <HowItWorks />

    <!-- Areas We Cover Across West Midlands -->
    <section class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
            <Icon name="map-pin" class="w-4 h-4" />
            <span>Coverage Network</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
            Areas We Cover Across Birmingham & West Midlands
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 mt-1">
            Our removal vans operate daily across 37 towns with guaranteed fixed quotes and full transit protection.
          </p>
        </div>
        <a
          href="/areas/"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow transition shrink-0 self-start sm:self-auto"
        >
          <span>Interactive Coverage Map</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {tier1Locations.map((loc) => (
          <a
            href={`/areas/${loc.id}/`}
            class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-amber-500 dark:hover:border-amber-500 transition group flex items-center justify-between shadow-sm"
          >
            <div>
              <span class="font-bold text-slate-900 dark:text-white text-xs sm:text-sm group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors block truncate">
                {loc.data.town}
              </span>
              <span class="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5 block truncate">
                {loc.data.county}
              </span>
            </div>
            <Icon name="chevron-right" class="w-4 h-4 text-slate-400 group-hover:text-amber-500 group-hover:translate-x-0.5 transition shrink-0 ml-1" />
          </a>
        ))}
      </div>
    </section>

    <!-- Quote CTA -->
    <CTABand
      variant="quote"
      heading="Get Your Free Birmingham Removals Quote"
      subheading="Speak directly with our Birmingham operations team for instant availability, advice, and a guaranteed fixed quotation."
      primaryCtaText="Get a Free Quote"
      primaryCtaHref="/get-a-quote/"
    />
  </div>
</BaseLayout>
