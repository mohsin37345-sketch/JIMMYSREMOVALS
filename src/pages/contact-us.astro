---
import BaseLayout from 'theme/layouts/BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ContactForm from 'theme/components/ContactForm.astro';
import CTABand from 'theme/components/CTABand.astro';
import Icon from 'theme/components/Icon.astro';
import { siteConfig } from 'src/data/site';

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Contact Us', item: '/contact-us/' }
];
---

<BaseLayout
  title={`Contact Jimmys Removals Birmingham | Phone, WhatsApp & Enquiries`}
  description={`Get in touch with Jimmys Removals. Call ${siteConfig.phone}, message on WhatsApp, or send an enquiry. Based in Birmingham, operating 24 hours, 7 days a week.`}
  schemaType="Contact"
  breadcrumbs={breadcrumbs}
>
  <Hero
    variant="page"
    title="Contact Jimmys Removals & Logistics"
    subtitle="Speak directly with our Birmingham operations desk 24 hours, 7 days a week. We are ready to help plan your move."
    badge="Birmingham Dispatch Desk"
  />

  <TrustStrip />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 space-y-16">
    <Breadcrumbs items={breadcrumbs} />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Direct Contact Details & NAP (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
            Get in Touch
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1">
            We're Here to Help You Move
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
            Have questions about van access, key release delays, or packing services? Contact our Birmingham operations desk directly.
          </p>
        </div>

        <div class="space-y-4">
          <!-- Telephone -->
          <a
            href={`tel:${siteConfig.phoneE164}`}
            class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center gap-4 hover:border-amber-500 transition group"
          >
            <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <Icon name="phone" class="w-6 h-6" />
            </div>
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold block">Telephone</span>
              <span class="text-base font-bold text-slate-900 dark:text-white group-hover:text-amber-600 transition-colors">
                {siteConfig.phone}
              </span>
            </div>
          </a>

          <!-- WhatsApp -->
          <a
            href={`https://wa.me/${siteConfig.whatsappE164.replace('+', '')}?text=${encodeURIComponent('Hello Jimmys Removals, I have an enquiry regarding a house move.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200 dark:border-emerald-800/40 flex items-center gap-4 hover:border-emerald-500 transition group"
          >
            <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <Icon name="whatsapp" class="w-6 h-6" />
            </div>
            <div>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 uppercase tracking-wider font-semibold block">WhatsApp Chat</span>
              <span class="text-base font-bold text-slate-900 dark:text-white">
                Instant Message
              </span>
            </div>
          </a>

          <!-- Email -->
          <a
            href={`mailto:${siteConfig.email}`}
            class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center gap-4 hover:border-amber-500 transition group"
          >
            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <Icon name="box" class="w-6 h-6" />
            </div>
            <div>
              <span class="text-xs text-slate-400 uppercase tracking-wider font-semibold block">Email</span>
              <span class="text-sm font-bold text-slate-900 dark:text-white break-all">
                {siteConfig.email}
              </span>
            </div>
          </a>

          <!-- Address -->
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center shrink-0">
              <Icon name="map" class="w-6 h-6 text-amber-500" />
            </div>
            <div class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">
              <strong class="text-sm text-slate-900 dark:text-white block mb-0.5">Operating Base & Depot</strong>
              {siteConfig.address.streetAddress}<br />
              {siteConfig.address.addressLocality}, {siteConfig.address.addressRegion}<br />
              {siteConfig.address.postalCode}
              {siteConfig.googleBusinessProfileUrl && (
                <div class="pt-2">
                  <a
                    href={siteConfig.googleBusinessProfileUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400 hover:underline"
                  >
                    <span>View on Google Maps</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- Hours -->
        <div class="p-4 bg-amber-50/50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/40 rounded-2xl text-xs space-y-1">
          <strong class="text-slate-900 dark:text-white block font-bold">Operating Hours:</strong>
          <p class="text-slate-600 dark:text-slate-300">
            {siteConfig.openingHoursDisplay}<br />
            <span class="text-slate-400">Removals & deliveries arranged day or night across the West Midlands</span>
          </p>
        </div>
      </div>

      <!-- Contact Form Container (7 cols) -->
      <div class="lg:col-span-7">
        <ContactForm />
      </div>

    </div>
  </div>

  <CTABand />
</BaseLayout>
