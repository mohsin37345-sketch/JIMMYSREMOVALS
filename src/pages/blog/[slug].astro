---
import BlogLayout from 'theme/layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  let posts: any[] = [];
  try {
    posts = await getCollection('blog');
  } catch (e) {
    posts = [];
  }

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post }
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/404/');
}

const { Content, headings } = await render(post);
---

<BlogLayout
  post={{
    title: post.data.title,
    description: post.data.description,
    image: post.data.image,
    imageAlt: post.data.imageAlt,
    date: post.data.date,
    updatedDate: post.data.updatedDate,
    author: post.data.author,
    category: post.data.category,
    tags: post.data.tags,
    readingTimeText: post.data.readingTimeText,
    wordCount: post.data.wordCount,
    relatedServices: post.data.relatedServices,
    relatedLocations: post.data.relatedLocations,
    faqs: post.data.faqs
  }}
  headings={headings}
>
  <Content />
</BlogLayout>
