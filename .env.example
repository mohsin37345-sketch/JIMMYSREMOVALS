# Form Submission Endpoint / Access Key (e.g. Web3Forms or Formspree)
PUBLIC_FORM_ACCESS_KEY=your_form_access_key_here

# Google Analytics 4 Measurement ID
PUBLIC_GA4_ID=G-XXXXXXXXXX

# Consent Management Platform (CookieYes or Cookiebot) ID
PUBLIC_CMP_ID=your_cmp_id_here

# Cloudflare Turnstile CAPTCHA Keys
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAXXXXXXXXXXXXXXX
TURNSTILE_SECRET_KEY=0x4AAAAAAXXXXXXXXXXXXXXX

# Search Console & Webmaster Verification Codes
PUBLIC_GOOGLE_VERIFICATION=your_google_verification_code
PUBLIC_BING_VERIFICATION=your_bing_verification_code
PUBLIC_YANDEX_VERIFICATION=your_yandex_verification_code
