---
import BaseLayout from './BaseLayout.astro';
import Hero from 'theme/components/Hero.astro';
import TrustStrip from 'theme/components/TrustStrip.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import CleanAirZoneNotice from 'theme/components/CleanAirZoneNotice.astro';
import FAQ from 'theme/components/FAQ.astro';
import CTABand from 'theme/components/CTABand.astro';
import RelatedLinks from 'theme/components/RelatedLinks.astro';
import Icon from 'theme/components/Icon.astro';
import { getCollection } from 'astro:content';

export interface Props {
  location: {
    town: string;
    slug: string;
    county: string;
    metaTitle: string;
    metaDescription: string;
    intro: string;
    localKnowledge: string;
    postcodes: string[];
    nearbyAreas: Array<{ name: string; slug: string }>;
    travelInfo: string;
    cleanAirZone: {
      enabled: boolean;
      note: string;
    };
    servicesOffered: string[];
    localFaqs: Array<{ question: string; answer: string; display: boolean }>;
    lat: number;
    lng: number;
    tier: 1 | 2;
  };
}

const { location } = Astro.props;

const allServices = await getCollection('services');
const allServiceAreas = await getCollection('serviceAreas');

// Helper to normalize strings for robust matching
const cleanStr = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]/g, '');

const mappedServices = (location.servicesOffered || []).map((srvName) => {
  const norm = cleanStr(srvName);
  const matched = allServices.find((s) => {
    const sTitle = cleanStr(s.data.title);
    const sShort = cleanStr(s.data.shortTitle);
    const sId = cleanStr(s.id);
    return sTitle.includes(norm) || norm.includes(sShort) || sShort === norm || sId === norm;
  });

  const svcId = matched?.id || srvName.toLowerCase().replace(/\s+/g, '-');
  // Check if dedicated service-location page exists (e.g. /removals/house-removals/coventry/)
  const hasDedicatedPage = allServiceAreas.some(
    (sa) => sa.data.service === svcId && sa.data.location === location.slug
  );

  const targetHref = hasDedicatedPage
    ? `/removals/${svcId}/${location.slug}/`
    : (matched ? `/removals/${matched.id}/` : `/removals/`);

  return {
    name: srvName,
    shortTitle: matched?.data.shortTitle || srvName,
    serviceSlug: svcId,
    hasDedicatedPage,
    targetHref,
    priceFrom: matched?.data.priceFrom,
    priceUnit: matched?.data.priceUnit,
    icon: matched?.data.icon || 'truck',
    summary: matched?.data.summary || `Professional ${srvName.toLowerCase()} solutions tailored to properties across ${location.town} and surrounding areas.`
  };
});

const serviceLinksForSidebar = mappedServices.map((ms) => ({
  title: ms.hasDedicatedPage ? `${location.town} ${ms.shortTitle}` : ms.shortTitle,
  href: ms.targetHref
}));

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Areas Covered', item: '/areas/' },
  { name: `${location.town} Removals`, item: `/areas/${location.slug}/` }
];

const locationData = {
  town: location.town,
  county: location.county,
  postcodes: location.postcodes,
  lat: location.lat,
  lng: location.lng,
  url: `/areas/${location.slug}/`
};

const nearbyLinks = [
  ...location.nearbyAreas.map((a) => ({
    title: `${a.name} Removals`,
    href: `/areas/${a.slug}/`
  })),
  { title: 'All 37 Coverage Areas', href: '/areas/' }
];
---

<BaseLayout
  title={location.metaTitle}
  description={location.metaDescription}
  schemaType="Location"
  breadcrumbs={breadcrumbs}
  faqs={location.localFaqs}
  locationData={locationData}
>
  <!-- Location Hero -->
  <Hero
    variant="location"
    title={`${location.town} House Removals & Logistics`}
    subtitle={`Professional domestic and commercial removals across ${location.town}, ${location.county}. Operating 7 days a week with fully insured crews.`}
    town={location.town}
    county={location.county}
    postcodes={location.postcodes}
    cazEnabled={location.cleanAirZone.enabled}
    cazNote={location.cleanAirZone.note}
  />

  <TrustStrip />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-16">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Intro & Local Knowledge Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-8 space-y-8">
        
        <!-- Unique Town Intro -->
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
            Removals & Moving Services in {location.town}
          </h2>
          <p class="text-sm sm:text-base text-slate-700 dark:text-slate-300 mt-4 leading-relaxed">
            {location.intro}
          </p>
        </div>

        <!-- Clean Air Zone Notice if enabled -->
        <CleanAirZoneNotice
          enabled={location.cleanAirZone.enabled}
          note={location.cleanAirZone.note}
          town={location.town}
        />

        <!-- In-Depth Local Knowledge -->
        <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-4">
          <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <Icon name="map" class="w-5 h-5 text-amber-500" />
            Local Moving Knowledge & Access Considerations
          </h3>
          <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed whitespace-pre-line">
            {location.localKnowledge}
          </div>
        </div>

        <!-- Travel & Arterial Highway Connections -->
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
            <Icon name="truck" class="w-5 h-5" />
          </div>
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white">Arterial Road & Motorway Access</h4>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-1 leading-relaxed">
              {location.travelInfo}
            </p>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        <!-- Fast Quote CTA -->
        <div class="p-6 bg-slate-900 text-white rounded-2xl border border-slate-800 space-y-4 shadow-xl">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">
            Local Operations
          </span>
          <h3 class="text-lg font-bold">
            Moving to or from {location.town}?
          </h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Get an instant, itemised fixed quote with no deposit required. We operate 7 days a week.
          </p>
          <a
            href="/get-a-quote/"
            class="w-full py-3 px-4 bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs rounded-xl shadow transition block text-center interactive-btn"
          >
            Get a Free Quote in {location.town}
          </a>
        </div>

        <!-- Services in This Town -->
        {serviceLinksForSidebar.length > 0 && (
          <RelatedLinks
            title={`Services in ${location.town}`}
            links={serviceLinksForSidebar}
            currentHref=""
          />
        )}

        <!-- Nearby Areas -->
        {nearbyLinks.length > 0 && (
          <RelatedLinks
            title={`Nearby Coverage Areas`}
            links={nearbyLinks}
            currentHref={`/areas/${location.slug}/`}
          />
        )}
      </aside>
    </div>

    <!-- Services Offered in This Town with Internal Links -->
    <div class="space-y-6">
      <div class="text-center max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
          <Icon name="truck" class="w-3.5 h-3.5" />
          <span>Local Services Directory</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
          Removal Services Available in {location.town}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Explore our fully insured domestic, commercial, and student relocation services tailored to {location.town}.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {mappedServices.map((item) => (
          <a
            href={item.targetHref}
            class="group p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-amber-500 dark:hover:border-amber-500 hover:shadow-lg transition-all duration-200 flex flex-col justify-between interactive-card"
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center group-hover:scale-110 transition-transform">
                  <Icon name={item.icon} class="w-5 h-5" />
                </div>
                {item.hasDedicatedPage && (
                  <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400">
                    Dedicated Hub
                  </span>
                )}
              </div>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                {item.hasDedicatedPage ? `${item.shortTitle} in ${location.town}` : `${item.name}`}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">
                {item.summary}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
              {item.priceFrom ? (
                <div>
                  <span class="text-slate-400 text-[10px] block">From</span>
                  <span class="font-extrabold text-slate-900 dark:text-white text-xs">£{item.priceFrom}</span>
                  <span class="text-slate-400 text-[10px]"> /{item.priceUnit}</span>
                </div>
              ) : (
                <span class="text-slate-400 text-[11px]">Fixed Quote</span>
              )}
              <span class="font-bold text-amber-600 dark:text-amber-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform text-xs">
                <span>Explore</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </span>
            </div>
          </a>
        ))}
      </div>

      <!-- Additional Services Link Strip -->
      <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm">
        <div class="flex items-center gap-3 text-slate-600 dark:text-slate-300">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
            <Icon name="box" class="w-4 h-4" />
          </div>
          <span>Need specialist piano transport, student moves, or clearance in {location.town}?</span>
        </div>
        <a
          href="/removals/"
          class="inline-flex items-center gap-1.5 font-bold text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition shrink-0"
        >
          <span>View All 12 Moving Services</span>
          <Icon name="chevron-right" class="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- Local Town FAQs -->
    <FAQ faqs={location.localFaqs} title={`${location.town} Moving FAQs`} />
  </div>

  <CTABand heading={`Book Your ${location.town} Removal Today`} />
</BaseLayout>
