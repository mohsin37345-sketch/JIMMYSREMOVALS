---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import TableOfContents from 'theme/components/TableOfContents.astro';
import { formatDate } from 'theme/utils/formatDate';

export interface Props {
  title: string;
  description: string;
  lastUpdated: string;
  headings?: Array<{ depth: number; slug: string; text: string }>;
}

const { title, description, lastUpdated, headings = [] } = Astro.props;

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: title, item: Astro.url.pathname }
];
---

<BaseLayout
  title={`${title} | Jimmys Removals`}
  description={description}
  schemaType="Legal"
  breadcrumbs={breadcrumbs}
>
  <div class="bg-slate-50 dark:bg-slate-900/50 border-b border-slate-200 dark:border-slate-800 py-8 lg:py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-4 mb-2">
        {title}
      </h1>
      <p class="text-sm text-slate-500 dark:text-slate-400">
        Last updated: <time datetime={lastUpdated}>{formatDate(lastUpdated)}</time> · Jimmys Removals and Logistics LTD
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      {headings.length > 0 && (
        <aside class="lg:col-span-1">
          <TableOfContents headings={headings} />
        </aside>
      )}

      <article class={`${headings.length > 0 ? 'lg:col-span-3' : 'lg:col-span-4'} prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 leading-relaxed`}>
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>
