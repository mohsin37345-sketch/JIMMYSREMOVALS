---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ContactForm from 'theme/components/ContactForm.astro';
import ImageSlot from 'theme/components/ImageSlot.astro';
import Icon from 'theme/components/Icon.astro';
import { pricingData } from 'src/data/pricing';
import { siteConfig } from 'src/data/site';
import { getCollection } from 'astro:content';

export interface Props {
  service: {
    title: string;
    slug: string;
    shortTitle: string;
    metaTitle: string;
    metaDescription: string;
    heroHeading: string;
    heroSubheading: string;
    icon: string;
    summary: string;
    benefits: string[];
    process: Array<{ step: number; title: string; description: string }>;
    whatsIncluded: string[];
    whatsNotIncluded: string[];
    priceFrom?: number;
    priceUnit?: string;
    priceNotes?: string;
    faqs: Array<{ question: string; answer: string; display: boolean }>;
    relatedServices: string[];
    heroImage?: string;
    gallery?: string[];
    images?: {
      hero?: { src?: string; alt?: string };
      local?: { src?: string; alt?: string };
      team?: { src?: string; alt?: string };
    };
  };
}

const { service } = Astro.props;

const allLocations = await getCollection('locations');
const allServiceAreas = await getCollection('serviceAreas');
const allServices = await getCollection('services');

// Check which locations have dedicated service-area pages for this service
const dedicatedServiceLocations = allServiceAreas
  .filter((sa) => sa.data.service === service.slug)
  .map((sa) => {
    const loc = allLocations.find((l) => l.id === sa.data.location);
    return {
      town: loc?.data.town || sa.data.location,
      slug: sa.data.location,
      county: loc?.data.county || 'West Midlands',
      href: `/removals/${sa.data.location}/${service.slug}/`
    };
  });

// Major regional towns for broad coverage grid
const majorTowns = allLocations
  .filter((loc) => !loc.data.region)
  .sort((a, b) => a.data.town.localeCompare(b.data.town));

// Construct location links: use dedicated service × town page if available, else town hub
const locationGridLinks = majorTowns.slice(0, 16).map((loc) => {
  const hasDedicated = dedicatedServiceLocations.some((dsl) => dsl.slug === loc.id);
  return {
    town: loc.data.town,
    href: hasDedicated ? `/removals/${loc.id}/${service.slug}/` : `/removals/${loc.id}/`,
    isDedicated: hasDedicated
  };
});

// Related services (find details for the 3 related services)
const relatedServicesData = (service.relatedServices || [])
  .map((relSlug) => allServices.find((s) => s.id === relSlug))
  .filter(Boolean)
  .slice(0, 3);

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Services', item: '/services/' },
  { name: service.shortTitle, item: `/services/${service.slug}/` }
];

// Determine pricing block type based on service
const isHouseRemovals = service.slug === 'house-removals';
const isManAndVan = service.slug === 'man-and-van';
const isStorage = service.slug === 'storage';

// Ensure cost FAQ is present and accurate
const costFaqAnswer = isHouseRemovals
  ? 'House removals typically range from £220 to £400 for a 1-bedroom flat, £320 to £600 for a 2-bedroom property, £500 to £850 for a 3-bedroom house, and from £800 for 4 bedrooms or larger. Final pricing depends on property size, inventory volume, access, and transit mileage, with an upfront fixed quote provided before booking.'
  : isManAndVan
  ? 'Man and van services start from £55. Rates depend on vehicle requirements, crew size, hours required, and travel distance, with clear fixed rates agreed in advance.'
  : isStorage
  ? 'Containerised storage starts from £18 per week. Rates depend on storage volume and hire duration, with direct collection and redelivery available across the West Midlands.'
  : `${service.title} is priced per job after a quick survey. Costs depend on specific inventory items, building access, and travel distances, with guaranteed fixed quotes provided before move day.`;

const defaultFaqs = [
  {
    question: `How much does ${service.shortTitle.toLowerCase()} cost?`,
    answer: costFaqAnswer
  },
  {
    question: `What size vans do you use for ${service.shortTitle.toLowerCase()}?`,
    answer: 'We operate 3.5-tonne Luton low-loader box vans equipped with 500kg hydraulic tail lifts, high-grade furniture blankets, and heavy-duty transit ties.'
  },
  {
    question: 'Are your moving crews directly employed and DBS-checked?',
    answer: 'Yes. All Jimmys Removals movers and drivers are directly employed, uniformed, and DBS-checked.'
  },
  {
    question: 'Are your removal services fully insured?',
    answer: 'Yes. Every booking is fully insured from the moment we begin handling your items through to safe room-of-choice placement.'
  },
  {
    question: 'How quickly can you arrange this service?',
    answer: 'We operate 24 hours, 7 days a week. We accommodate planned bookings weeks in advance as well as urgent or same-day relocations subject to van availability.'
  }
];

const mergedFaqs = [
  ...defaultFaqs,
  ...(service.faqs || []).filter(f => f.display && !f.question.includes('{{'))
].slice(0, 12);

// Clean NAP data
const fullBusinessName = siteConfig.legalName;
const tradingName = siteConfig.tradingName;
const companyNumber = siteConfig.companyNumber;
const regOffice = siteConfig.address.fullAddress;
const phone = siteConfig.phone;
const phoneHref = siteConfig.phoneHref;
const email = siteConfig.email;
---

<BaseLayout
  title={service.metaTitle || `${service.title} | Jimmys Removals`}
  description={service.metaDescription || `Professional ${service.shortTitle.toLowerCase()} across Birmingham and the West Midlands. Fully insured, DBS-checked movers, and guaranteed fixed quotes.`}
  breadcrumbs={breadcrumbs}
>
  <!-- ========================================================================= -->
  <!-- S1. HERO SECTION (Strictly no price figures)                              -->
  <!-- ========================================================================= -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-8 pb-16 lg:pb-24 border-b border-slate-800 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6 text-slate-400" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <Icon name={service.icon} class="w-3.5 h-3.5" />
            <span>Birmingham & West Midlands Specialist</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            {service.heroHeading || `${service.title} in Birmingham & the West Midlands`}
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            {service.heroSubheading || `Professional, fully insured ${service.shortTitle.toLowerCase()} delivered by directly employed, DBS-checked movers in modern Luton vans.`}
          </p>

          <!-- Same-Day Delivery Highlight (same as homepage) -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="/services/same-day-delivery/"
              class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 backdrop-blur-md text-xs sm:text-sm text-amber-300 font-bold transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <Icon name="clock" class="w-4 h-4 text-amber-400" />
              <span>Same-Day Delivery Available Across Birmingham & West Midlands</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="#quote-form"
              class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all hover:scale-[1.02] flex items-center gap-2"
            >
              <span>Get a Fixed Quote</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>

            <a
              href={phoneHref}
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition-all flex items-center gap-2"
            >
              <Icon name="phone" class="w-4 h-4 text-amber-400" />
              <span>Call {phone}</span>
            </a>

            {siteConfig.whatsappEnabled && (
              <a
                href={siteConfig.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow transition-all flex items-center gap-2"
              >
                <Icon name="chat" class="w-4 h-4" />
                <span>WhatsApp</span>
              </a>
            )}
          </div>

          <!-- Trust Strip -->
          <div class="pt-6 border-t border-slate-800/80">
            <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-300 font-medium">
              <li class="flex items-center gap-1.5">
                <Icon name="clock" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Open 24 hours, 7 days a week</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="shield-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>DBS-checked crews</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="badge-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fixed quotes</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fully insured</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Hero Quote Form (5 cols) -->
        <div id="quote-form" class="lg:col-span-5 bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white">
          <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Fixed & Guaranteed</span>
            <h3 class="text-xl font-bold mt-1">Get a Fixed {service.shortTitle} Quote</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
              Transparent pricing with no hidden charges. Quick response 24 hours a day.
            </p>
          </div>
          <ContactForm formType="quick-quote" prefilledService={service.title} />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- S2. INTRO SECTION & SERVICE SHOWCASE                                      -->
  <!-- ========================================================================= -->
  <section class="py-14 lg:py-20 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800 relative overflow-hidden">
    <!-- Subtle Background Glow Accents -->
    <div class="absolute top-0 right-0 -mt-16 -mr-16 w-80 h-80 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -mb-16 -ml-16 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Left Column: Editorial Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" data-nosimilarity="true">
            <Icon name={service.icon} class="w-3.5 h-3.5" />
            <span>Specialist Moving Service</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
            Professional {service.shortTitle} Tailored to Your Schedule
          </h2>

          <div class="prose prose-slate dark:prose-invert max-w-none text-base sm:text-lg leading-relaxed space-y-4">
            <p class="font-medium text-slate-900 dark:text-slate-100">
              Professional {service.shortTitle.toLowerCase()} across Birmingham and the West Midlands provide dependable, careful transport tailored to your schedule.
            </p>
            <p class="text-slate-700 dark:text-slate-300">
              {service.summary}
            </p>
            <p class="text-slate-700 dark:text-slate-300" data-nosimilarity="true">
              Operated from our base in east Birmingham, our 3.5-tonne Luton vans feature hydraulic tail lifts, high-tensile lashing rails, and thick quilted furniture blankets. Our directly employed movers handle every item with precision, ensuring that from initial collection to final room placement, your belongings remain protected throughout transit.
            </p>
          </div>

          <!-- Modern UX Feature Highlights (3 Interactive Micro-Cards) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2" data-nosimilarity="true">
            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="truck" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">Luton Van Fleet</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Equipped with tail-lifts & protective transit blankets
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="shield-check" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">DBS Verified</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Directly employed, experienced moving teams
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="badge-check" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">Guaranteed</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Clear fixed quote with no hidden extras
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Showcase with ImageSlot 1 (5 cols) -->
        <div class="lg:col-span-5 space-y-3">
          <div class="relative group rounded-3xl overflow-hidden shadow-xl border border-slate-200/80 dark:border-slate-800 bg-slate-100 dark:bg-slate-800">
            <ImageSlot
              src={service.images?.hero?.src || service.heroImage}
              alt={service.images?.hero?.alt || `Jimmys Removals team providing ${service.shortTitle.toLowerCase()} across Birmingham`}
              aspect="4/3"
              slotId="hero"
              loading="eager"
              fetchpriority="high"
            />

            <!-- Glassmorphic floating card at the bottom of the photo -->
            <div class="absolute bottom-3 left-3 right-3 p-3.5 rounded-2xl bg-slate-950/85 backdrop-blur-md border border-white/10 text-white flex items-center justify-between shadow-lg" data-nosimilarity="true">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center">
                  <Icon name={service.icon} class="w-4 h-4" />
                </div>
                <div>
                  <p class="text-xs font-bold leading-tight">{service.shortTitle}</p>
                  <p class="text-[11px] text-slate-300">Birmingham & West Midlands</p>
                </div>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500 text-slate-950 shadow-sm">
                Fully Insured
              </span>
            </div>
          </div>

          <!-- Micro caption below image -->
          <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 px-1" data-nosimilarity="true">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Available day & night across 37 towns</span>
            </span>
            <span>Open 24 hours, 7 days</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- S3. WHO THIS SERVICE IS FOR                                               -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Who Our {service.shortTitle} Service Is Designed For
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2">
          Tailored moving solutions for diverse residential and commercial situations.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-xs">01</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Homeowners Moving House</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Families relocating between terraced, semi-detached, or detached homes who require methodical packing, loading, and on-time key exchange.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-xs">02</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Flats & Apartments</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Tenants and owners moving in or out of upper-floor apartments with stairwells, lifts, and dedicated loading bay reservations.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-xs">03</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Businesses & Offices</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Companies relocating equipment, office desks, and archives during evenings or weekends with minimal operational downtime.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-xs">04</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Individual Furniture Relocation</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Customers needing heavy wardrobes, solid oak suites, or large kitchen appliances transported securely to a new home.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- S4. WHAT'S INCLUDED & NOT INCLUDED                                        -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        <div class="lg:col-span-7 space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Clear Inclusions</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
              What Is Included with {service.shortTitle}
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {service.whatsIncluded.map((item) => (
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-start gap-2.5">
                <Icon name="check-circle" class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" />
                <span class="text-xs text-slate-700 dark:text-slate-300 font-medium">{item}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="lg:col-span-5 space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Service Boundaries</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
              What Is Not Included
            </h2>
          </div>

          <div class="space-y-3">
            {service.whatsNotIncluded.map((item) => (
              <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 flex items-start gap-2.5">
                <Icon name="x-circle" class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" />
                <span class="text-xs text-slate-600 dark:text-slate-400">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- S5. COMMON CHALLENGES WE HANDLE                                           -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Challenges We Handle During {service.shortTitle}
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2">
          Experienced movers equipped to handle unexpected logistical hurdles calmly and safely.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2">
          <h3 class="text-base font-bold text-slate-900 dark:text-white">1. Tight Angles & Stairwells</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
