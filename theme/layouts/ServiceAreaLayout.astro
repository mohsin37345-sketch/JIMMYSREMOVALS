---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ContactForm from 'theme/components/ContactForm.astro';
import ImageSlot from 'theme/components/ImageSlot.astro';
import Icon from 'theme/components/Icon.astro';
import { pricingData } from 'src/data/pricing';
import { siteConfig } from 'src/data/site';
import { getCollection } from 'astro:content';

export interface Props {
  serviceArea: {
    service: string;
    location: string;
    uniqueIntro: string;
    localAngle?: string;
    faqs?: Array<{ question: string; answer: string; display: boolean }>;
    images?: {
      hero?: { src?: string; alt?: string };
      local?: { src?: string; alt?: string };
      team?: { src?: string; alt?: string };
    };
  };
  service: any;
  location: any;
}

const { serviceArea, service, location } = Astro.props;

const isBirmingham = location.slug.toLowerCase() === 'birmingham';
const townName = location.town;
const serviceTitle = service.title;
const serviceShort = service.shortTitle;

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Areas Covered', item: '/areas/' },
  { name: `${townName} Removals`, item: `/removals/${location.slug}/` },
  { name: serviceShort, item: `/removals/${location.slug}/${service.slug}/` }
];

// Related services
const allServices = await getCollection('services');
const relatedServicesData = (service.relatedServices || [])
  .map((relSlug: string) => allServices.find((s) => s.id === relSlug))
  .filter(Boolean)
  .slice(0, 3);

// Determine pricing logic
const isHouseRemovals = service.slug === 'house-removals';
const isManAndVan = service.slug === 'man-and-van';
const isStorage = service.slug === 'storage';

const costFaqAnswer = isHouseRemovals
  ? `House removals in ${townName} typically range from £220 to £400 for a 1-bedroom flat, £320 to £600 for a 2-bedroom property, £500 to £850 for a 3-bedroom house, and from £800 for 4 bedrooms or larger. Final pricing depends on property size, volume, access, and transit mileage, with a guaranteed fixed quote provided before booking.`
  : isManAndVan
  ? `Man and van services in ${townName} start from £55. Rates depend on vehicle capacity, crew size, hours required, and travel distance, with fixed pricing agreed in advance.`
  : isStorage
  ? `Storage for ${townName} residents starts from £18 per week. Rates depend on storage unit dimensions and duration, with direct collection and delivery across the West Midlands.`
  : `${serviceTitle} in ${townName} is priced per job after a quick survey. Pricing is based on item inventory, access conditions, and travel distances, with guaranteed fixed quotes provided upfront.`;

const defaultFaqs = [
  {
    question: `How much does ${serviceShort.toLowerCase()} cost in ${townName}?`,
    answer: costFaqAnswer
  },
  {
    question: `What vans do you use for ${serviceShort.toLowerCase()} in ${townName}?`,
    answer: `We operate 3.5-tonne Luton low-loader box vans equipped with 500kg hydraulic tail lifts, high-grade furniture blankets, and heavy-duty transit ties, providing ideal capacity for ${townName} residential streets.`
  },
  {
    question: `Are your moving crews directly employed and DBS-checked?`,
    answer: 'Yes. All Jimmys Removals movers and drivers are directly employed, uniformed, and DBS-checked.'
  },
  {
    question: `Are your ${serviceShort.toLowerCase()} services in ${townName} fully insured?`,
    answer: `Yes. Every move in ${townName} is fully insured from collection through to final room placement.`
  }
];

if (isBirmingham) {
  defaultFaqs.unshift({
    question: 'Are Clean Air Zone charges added to my quote in Birmingham?',
    answer: 'No Clean Air Zone charges are added to your quote. We operate inside the A4540 Middleway ring road with zero CAZ surcharges for our customers.'
  });
}

const mergedFaqs = [
  ...(serviceArea.faqs || []).filter(f => f.display && !f.question.includes('{{')),
  ...defaultFaqs
].slice(0, 10);

// Check if testimonial is valid
const hasValidReview = location.testimonial &&
  location.testimonial.text &&
  !location.testimonial.text.includes('{{') &&
  !location.testimonial.name.includes('{{');

// Clean NAP data
const fullBusinessName = siteConfig.legalName;
const tradingName = siteConfig.tradingName;
const companyNumber = siteConfig.companyNumber;
const regOffice = siteConfig.address.fullAddress;
const phone = siteConfig.phone;
const phoneHref = siteConfig.phoneHref;
const email = siteConfig.email;
---

<BaseLayout
  title={`${serviceShort} ${townName} | Jimmys Removals`}
  description={`Professional ${serviceShort.toLowerCase()} in ${townName}. Directly employed DBS-checked movers, 3.5-tonne Luton vans with tail lifts, and guaranteed fixed quotes.`}
  breadcrumbs={breadcrumbs}
>
  <!-- ========================================================================= -->
  <!-- 1. A1. HERO SECTION                                                       -->
  <!-- ========================================================================= -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-8 pb-16 lg:pb-24 border-b border-slate-800 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6 text-slate-400" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <Icon name={service.icon || 'truck'} class="w-3.5 h-3.5" />
            <span>{townName} · {serviceShort}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            {serviceShort} in {townName}
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed" data-nosimilarity="true">
            Professional, fully insured {serviceShort.toLowerCase()} across {townName} and surrounding districts. Uniformed, DBS-checked movers operating modern 3.5-tonne Luton vans with guaranteed fixed quotes.
          </p>

          <!-- Same-Day Delivery Highlight (same as homepage) -->
          <div class="flex flex-wrap items-center gap-3 pt-1" data-nosimilarity="true">
            <a
              href="/services/same-day-delivery/"
              class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 backdrop-blur-md text-xs sm:text-sm text-amber-300 font-bold transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <Icon name="clock" class="w-4 h-4 text-amber-400" />
              <span>Same-Day Delivery Available Across Birmingham & West Midlands</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="#quote-form"
              class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all hover:scale-[1.02] flex items-center gap-2"
            >
              <span>Get a Fixed Quote</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>

            <a
              href={phoneHref}
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition-all flex items-center gap-2"
            >
              <Icon name="phone" class="w-4 h-4 text-amber-400" />
              <span>Call {phone}</span>
            </a>

            {siteConfig.whatsappEnabled && (
              <a
                href={siteConfig.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow transition-all flex items-center gap-2"
              >
                <Icon name="chat" class="w-4 h-4" />
                <span>WhatsApp</span>
              </a>
            )}
          </div>

          <!-- Trust Strip -->
          <div class="pt-6 border-t border-slate-800/80" data-nosimilarity="true">
            <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-300 font-medium">
              <li class="flex items-center gap-1.5">
                <Icon name="clock" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Open 24 hours, 7 days a week</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="shield-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>DBS-checked crews</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="badge-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fixed quotes</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fully insured</span>
              </li>
              {isBirmingham && (
                <li class="flex items-center gap-1.5 text-amber-400">
                  <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                  <span>Zero CAZ surcharges</span>
                </li>
              )}
            </ul>
          </div>
        </div>

        <!-- Hero Quote Form (5 cols) -->
        <div id="quote-form" data-nosimilarity="true" class="lg:col-span-5 bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white">
          <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Guaranteed Fixed Quote</span>
            <h3 class="text-xl font-bold mt-1">Book Your {townName} Move</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
              Fixed pricing with no hidden charges. Punctual arrivals day and night.
            </p>
          </div>
          <ContactForm formType="quick-quote" prefilledLocation={townName} prefilledService={serviceTitle} />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. A2. INTRO SECTION & SERVICE SHOWCASE                                   -->
  <!-- ========================================================================= -->
  <section class="py-14 lg:py-20 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800 relative overflow-hidden">
    <!-- Subtle Background Glow Accents -->
    <div class="absolute top-0 right-0 -mt-16 -mr-16 w-80 h-80 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -mb-16 -ml-16 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Left Column: Editorial Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" data-nosimilarity="true">
            <Icon name="truck" class="w-3.5 h-3.5" />
            <span>Local Service Specialist</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
            Professional {serviceShort} Across {townName}
          </h2>

          <div class="prose prose-slate dark:prose-invert max-w-none text-base sm:text-lg leading-relaxed space-y-4">
            <p class="font-medium text-slate-900 dark:text-slate-100" data-nosimilarity="true">
              Professional {serviceShort.toLowerCase()} in {townName} provides local residents and businesses with dependable, punctual, and fully insured transport.
            </p>
            <p class="text-slate-700 dark:text-slate-300">
              {serviceArea.uniqueIntro}
            </p>
            {serviceArea.localAngle && (
              <p class="text-slate-700 dark:text-slate-300">
                {serviceArea.localAngle}
              </p>
            )}
          </div>

          <!-- Modern UX Feature Highlights (3 Interactive Micro-Cards) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2" data-nosimilarity="true">
            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="truck" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">3.5T Luton</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Equipped with tail-lift & protective ties
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="shield-check" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">DBS Movers</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Directly employed, experienced staff
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="badge-check" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">Fixed Price</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Transparent quotes agreed in advance
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Showcase with ImageSlot 1 (5 cols) -->
        <div class="lg:col-span-5 space-y-3">
          <div class="relative group rounded-3xl overflow-hidden shadow-xl border border-slate-200/80 dark:border-slate-800 bg-slate-100 dark:bg-slate-800">
            <ImageSlot
              src={serviceArea.images?.hero?.src || service.heroImage}
              alt={serviceArea.images?.hero?.alt || `Jimmys Removals ${serviceShort.toLowerCase()} in ${townName}`}
              aspect="4/3"
              slotId="hero"
              loading="eager"
              fetchpriority="high"
            />

            <!-- Glassmorphic floating card at the bottom of the photo -->
            <div class="absolute bottom-3 left-3 right-3 p-3.5 rounded-2xl bg-slate-950/85 backdrop-blur-md border border-white/10 text-white flex items-center justify-between shadow-lg" data-nosimilarity="true">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center">
                  <Icon name="truck" class="w-4 h-4" />
                </div>
                <div>
                  <p class="text-xs font-bold leading-tight">{serviceShort}</p>
                  <p class="text-[11px] text-slate-300">{townName} Relocation</p>
                </div>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500 text-slate-950 shadow-sm">
                Fully Insured
              </span>
            </div>
          </div>

          <!-- Micro caption below image -->
          <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 px-1" data-nosimilarity="true">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Local {townName} crew</span>
            </span>
            <span>Open 24 hours, 7 days</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. S4. WHAT'S INCLUDED                                                    -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          What Is Included with {serviceShort} in {townName}
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2">
          Clear moving inclusions and dedicated protection for all your belongings.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {(service.whatsIncluded || [
          'Equipped 3.5-tonne Luton van with tail lift',
          'Uniformed, DBS-checked moving crew',
          'Heavy furniture transit blankets and load straps',
          'Floor runners protecting carpets and hallways',
          'Room-of-choice positioning at destination',
          'Fully insured transport across the West Midlands',
          'Written guaranteed fixed quotes',
          '24/7 availability for planned and urgent moves'
        ]).map((item: string) => (
          <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
            <div class="flex items-center gap-2 text-amber-500 font-bold text-sm">
              <Icon name="check-circle" class="w-4 h-4 shrink-0" />
              <span>Inclusion</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. A3. LOCAL CHALLENGES & LOCAL CONTEXT + IMAGE SLOT 2                    -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Local Coordination</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
              Handling Moving Logistics in {townName}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2">
              From residential street parking to apartment lift bookings, our experienced movers navigate {townName} with precision.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1.5">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Street Parking Management</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                We position our 3.5-tonne Luton vans safely curbside, ensuring minimal disruption to neighbours while maintaining direct loading access.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1.5">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Apartment & Multi-Floor Access</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                We coordinate with building management for lift access and protect communal entrance hallways with non-slip floor runners.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1.5">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Heavy Furniture Handling</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                Our 500kg hydraulic tail lifts and heavy-duty dollies allow safe loading of solid timber wardrobes and domestic appliances.
              </p>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1.5">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Strategic Departure Timing</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                We plan travel routes to avoid peak regional road congestion, ensuring your move reaches {townName} on schedule.
              </p>
            </div>
          </div>
        </div>

        <!-- Image Slot 2: Local (4/3) -->
        <div class="lg:col-span-5">
          <ImageSlot
            src={serviceArea.images?.local?.src}
            alt={serviceArea.images?.local?.alt || `Luton van operating in ${townName} for ${serviceShort.toLowerCase()}`}
            aspect="4/3"
            slotId="local"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. A7. PRICING SECTION (Isolated pricing)                                 -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Guaranteed Value</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          {serviceShort} Pricing for {townName}
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
          {isHouseRemovals ? pricingData.houseRemovals.summary : 'Clear, binding fixed quotes provided before move day.'}
        </p>
      </div>

      {isHouseRemovals ? (
        <div class="overflow-x-auto rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm mb-8">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-100/60 dark:bg-slate-700/50 text-slate-900 dark:text-white text-xs font-bold uppercase tracking-wider">
                <th class="py-3.5 px-4 sm:px-6">Property Size</th>
                <th class="py-3.5 px-4 sm:px-6">Guide Price Range</th>
                <th class="py-3.5 px-4 sm:px-6">Scope & What It Covers</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/60 text-xs sm:text-sm">
              {pricingData.houseRemovals.tiers.map((tier) => (
                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors">
                  <td class="py-3.5 px-4 sm:px-6 font-bold text-slate-900 dark:text-white">
                    {tier.propertyType}
                  </td>
                  <td class="py-3.5 px-4 sm:px-6 font-extrabold text-amber-600 dark:text-amber-400">
                    {tier.guideRange}
                  </td>
                  <td class="py-3.5 px-4 sm:px-6 text-slate-600 dark:text-slate-300">
                    {tier.description}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : isManAndVan ? (
        <div class="p-8 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-center max-w-xl mx-auto mb-8 shadow-sm space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Starting Rate</span>
          <div class="text-4xl font-extrabold text-amber-600 dark:text-amber-400">from £55</div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            {pricingData.manAndVan.summary}
          </p>
        </div>
      ) : isStorage ? (
        <div class="p-8 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-center max-w-xl mx-auto mb-8 shadow-sm space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Starting Rate</span>
          <div class="text-4xl font-extrabold text-amber-600 dark:text-amber-400">from £18 per week</div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            {pricingData.storage.summary}
          </p>
        </div>
      ) : (
        <div class="p-8 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-center max-w-xl mx-auto mb-8 shadow-sm space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Personalised Pricing</span>
          <div class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Priced per job after a quick survey</div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Calculated according to item quantities, volume, floor access, and journey distance.
          </p>
        </div>
      )}

      <!-- Price Factors & Fixed Price Promise -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-2xl border border-slate-200 dark:border-slate-700">
        <div>
          <h3 class="text-base font-bold text-slate-900 dark:text-white mb-3">What Affects Your Quote</h3>
          <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-300">
            {pricingData.priceFactors.slice(0, 5).map((factor) => (
              <li class="flex items-start gap-2">
                <Icon name="check-circle" class="w-3.5 h-3.5 text-amber-500 shrink-0 mt-0.5" />
                <span><strong class="text-slate-900 dark:text-white">{factor.title}:</strong> {factor.description}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col justify-between border-t md:border-t-0 md:border-l border-slate-100 dark:border-slate-700 pt-6 md:pt-0 md:pl-6">
          <div class="space-y-3">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400">
              <Icon name="badge-check" class="w-4 h-4" />
              <span>Guaranteed Fixed Quote</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {pricingData.fixedPricePromise}
            </p>
            <p class="text-[11px] text-slate-400 dark:text-slate-500 italic">
              {pricingData.disclaimer}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-700">
            <a
              href="#quote-form"
              class="inline-block px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-xs shadow transition text-center"
            >
              Get Your Fixed Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 6. S6. OUR PROCESS (4 Numbered Steps)                                     -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Straightforward Execution</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          How We Deliver {serviceShort} in {townName}
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { step: '01', title: 'Survey & Quote', desc: 'Tell us what needs moving for a guaranteed fixed written quote.' },
          { step: '02', title: 'Preparation', desc: 'We confirm times and coordinate any parking dispensations or lift bookings.' },
          { step: '03', title: 'Loading & Transit', desc: 'Our uniformed movers blanket-wrap, load, and strap your goods inside our Luton van.' },
          { step: '04', title: 'Room Placement', desc: 'We unload directly into your designated rooms at your new address.' }
        ].map((item) => (
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 relative shadow-sm">
            <span class="text-2xl font-black text-amber-500/30 dark:text-amber-400/20 block mb-2">{item.step}</span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-1.5">{item.title}</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 7. A10. AREAS AND POSTCODES COVERED                                       -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-3">
        Postcodes We Cover for {serviceShort} in {townName}
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mb-6">
        Daily operations across all residential and business postcodes in {townName}.
      </p>

      <div class="flex flex-wrap justify-center gap-2">
        {(location.postcodes || []).map((pc: string) => (
          <span class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 text-xs font-bold text-slate-800 dark:text-slate-200">
            {pc}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 8. S9. RELATED SERVICES (3 Descriptive links)                             -->
  <!-- ========================================================================= -->
  {relatedServicesData.length > 0 && (
    <section class="py-12 lg:py-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800" data-nosimilarity="true">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
            Related Moving Services in {townName}
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
            Explore additional moving solutions tailored to your requirements.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedServicesData.map((rel: any) => (
            <a
              href={`/services/${rel.id}/`}
              class="group p-6 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-amber-500 dark:hover:border-amber-500 transition-all flex flex-col justify-between"
            >
              <div>
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
                  <Icon name={rel.data.icon} class="w-5 h-5" />
                </div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-amber-500 transition-colors">
                  {rel.data.title}
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-300 mt-2 leading-relaxed line-clamp-3">
                  {rel.data.summary}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between text-xs font-semibold text-amber-600 dark:text-amber-400">
                <span>View Service</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ========================================================================= -->
  <!-- 9. A12. WHY CHOOSE US (6 Pillars using Section 1 facts) + IMAGE SLOT 3    -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Verified Standards</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
              Why Choose Jimmys Removals in {townName}
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Directly Employed Movers</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300">All porters are uniformed, directly employed, and DBS-checked.</p>
            </div>

            <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Luton Vans with Tail Lifts</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300">Equipped with 500kg hydraulic tail lifts and heavy-duty strapping.</p>
            </div>

            <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Fully Insured</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300">Complete insurance protection provided for every move we undertake.</p>
            </div>

            <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Guaranteed Fixed Quotes</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300">The quote you receive is clear and fixed before moving day begins.</p>
            </div>

            <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Open 24 Hours, 7 Days</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300">Round-the-clock operations accommodate your exact moving schedule.</p>
            </div>

            <div class="p-4 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-1">
              <h3 class="text-sm font-bold text-slate-900 dark:text-white">Fast West Midlands Access</h3>
              <p class="text-xs text-slate-600 dark:text-slate-300">Based in Birmingham with fast access across the M6, M42, and M5.</p>
            </div>
          </div>
        </div>

        <!-- Image Slot 3: Team (4/3) -->
        <div class="lg:col-span-5">
          <ImageSlot
            src={serviceArea.images?.team?.src}
            alt={serviceArea.images?.team?.alt || `Uniformed Jimmys Removals movers providing ${serviceShort.toLowerCase()} in ${townName}`}
            aspect="4/3"
            slotId="team"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 10. A13. REVIEWS (Conditioned on presence)                                -->
  <!-- ========================================================================= -->
  {hasValidReview && location.testimonial && (
    <section class="py-12 lg:py-16 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Verified Client</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1 mb-6">
          Customer Experience in {townName}
        </h2>
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-left space-y-3">
          <p class="text-sm text-slate-700 dark:text-slate-200 italic">"{location.testimonial.text}"</p>
          <div class="text-xs font-bold text-slate-900 dark:text-white pt-2 border-t border-slate-200 dark:border-slate-700">
            {location.testimonial.name} · {townName}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ========================================================================= -->
  <!-- 11. A14. FAQS (Matching Section 5 figures)                                -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Frequently Asked</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">
          {serviceShort} in {townName} FAQs
        </h2>
      </div>

      <div class="space-y-4">
        {mergedFaqs.map((faq, index) => (
          <details class="group p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-all [&_summary::-webkit-details-marker]:hidden" open={index === 0}>
            <summary class="flex items-center justify-between cursor-pointer font-bold text-sm sm:text-base text-slate-900 dark:text-white gap-4">
              <span>{faq.question}</span>
              <span class="text-amber-500 shrink-0 group-open:rotate-180 transition-transform">
                <Icon name="chevron-down" class="w-5 h-5" />
              </span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-700 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 12. A16. FINAL CTA                                                        -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 text-white text-center" data-nosimilarity="true">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
        Ready to Book {serviceShort} in {townName}?
      </h2>
      <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Get an upfront guaranteed fixed quote today. Our directly employed movers are available 24 hours, 7 days a week.
      </p>

      <div class="flex flex-wrap justify-center items-center gap-4 pt-2">
        <a
          href="#quote-form"
          class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all hover:scale-[1.02]"
        >
          Get a Fixed Quote
        </a>
        <a
          href={phoneHref}
          class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition"
        >
          Call {phone}
        </a>
      </div>

      <p class="text-xs text-slate-400">
        Open 24 hours, 7 days a week · Direct communication with our West Midlands operations base
      </p>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 13. A17. MAP & EXACT NAP BLOCK                                            -->
  <!-- ========================================================================= -->
  <section class="py-12 bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 sm:p-8 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm text-slate-600 dark:text-slate-300 space-y-3">
        <h3 class="text-base font-bold text-slate-900 dark:text-white">Business Verification & Registered Office</h3>
        <p>
          <strong class="text-slate-900 dark:text-white">{fullBusinessName}</strong> (trading as {tradingName}) is a private limited company registered in England & Wales under Companies House registration number <strong>{companyNumber}</strong>.
        </p>
        <p>
          <strong>Registered Office:</strong> {regOffice} · <strong>Phone:</strong> <a href={phoneHref} class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">{phone}</a> · <strong>Email:</strong> <a href={`mailto:${email}`} class="text-amber-600 dark:text-amber-400 font-semibold hover:underline">{email}</a>
        </p>
        <p>
          <strong>Operating Hours:</strong> Open 24 hours, 7 days a week.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
