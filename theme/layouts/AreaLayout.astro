---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from 'theme/components/Breadcrumbs.astro';
import ContactForm from 'theme/components/ContactForm.astro';
import ImageSlot from 'theme/components/ImageSlot.astro';
import Icon from 'theme/components/Icon.astro';
import { pricingData } from 'src/data/pricing';
import { siteConfig } from 'src/data/site';
import { getCollection } from 'astro:content';

export interface Props {
  location: {
    town: string;
    slug: string;
    county: string;
    metaTitle: string;
    metaDescription: string;
    heroHeading?: string;
    intro: string;
    localKnowledge: string;
    postcodes: string[];
    nearbyAreas: Array<{ name: string; slug: string }>;
    travelInfo?: string;
    cleanAirZone?: {
      enabled: boolean;
      note?: string;
    };
    servicesOffered?: string[];
    localFaqs?: Array<{ question: string; answer: string; display: boolean }>;
    testimonial?: {
      name: string;
      text: string;
      service: string;
      date: string;
    };
    lat?: number;
    lng?: number;
    tier?: 1 | 2;
    heroImage?: string;
    images?: {
      hero?: { src?: string; alt?: string };
      local?: { src?: string; alt?: string };
      team?: { src?: string; alt?: string };
    };
  };
}

const { location } = Astro.props;

const isBirmingham = location.slug.toLowerCase() === 'birmingham';

// Fetch all service areas to check which dedicated /removals/{town}/{service}/ pages exist
const allServiceAreas = await getCollection('serviceAreas');

// 10 Core Services list
const coreServices = [
  { id: 'house-removals', title: 'House Removals', icon: 'home', desc: `Full home removals across ${location.town} in equipped 3.5-tonne Luton vans.` },
  { id: 'flat-removals', title: 'Flat Removals', icon: 'building', desc: `Apartment and upper-floor flat moves with lift coordination and careful handling.` },
  { id: 'man-and-van', title: 'Man and Van', icon: 'truck', desc: `Flexible transport with a 3.5-tonne Luton van and an experienced mover.` },
  { id: 'packing-services', title: 'Packing Services', icon: 'box', desc: `Full or fragile packing using double-walled boxes, tissue paper, and bubble wrap.` },
  { id: 'storage', title: 'Storage Solutions', icon: 'archive', desc: `Secure containerised storage with direct collection and redelivery.` },
  { id: 'furniture-removals', title: 'Furniture Removals', icon: 'couch', desc: `Single items, heavy suites, and room-of-choice delivery with hydraulic tail lifts.` },
  { id: 'furniture-dismantling', title: 'Furniture Dismantling', icon: 'wrench', desc: `Careful disassembly and reassembly of wardrobes, bed frames, and flat-pack units.` },
  { id: 'office-removals', title: 'Office Removals', icon: 'briefcase', desc: `Commercial office relocations planned around your working hours.` },
  { id: 'student-removals', title: 'Student Removals', icon: 'academic', desc: `Term-time relocations between halls, shared student houses, and home.` },
  { id: 'same-day-delivery', title: 'Same Day Delivery', icon: 'clock', desc: `Urgent point-to-point dispatch across the West Midlands, subject to vehicle availability.` }
];

const serviceCards = coreServices.map((svc) => {
  const hasDedicatedPage = allServiceAreas.some(
    (sa) => sa.data.service === svc.id && sa.data.location === location.slug
  );
  return {
    ...svc,
    href: hasDedicatedPage ? `/removals/${location.slug}/${svc.id}/` : `/services/${svc.id}/`,
    isDedicated: hasDedicatedPage
  };
});

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Areas Covered', item: '/areas/' },
  { name: `${location.town} Removals`, item: `/removals/${location.slug}/` }
];

// Ensure FAQs include cost FAQ and town-specific questions
const defaultFaqs = [
  {
    question: `How much do house removals cost in ${location.town}?`,
    answer: `House removals in ${location.town} typically range from £220 to £400 for a 1-bedroom flat, £320 to £600 for a 2-bedroom property, £500 to £850 for a 3-bedroom house, and from £800 for 4 bedrooms or larger. Final pricing depends on property size, volume, access, and travel distance, with a guaranteed fixed quote provided before booking.`
  },
  {
    question: `What size vans do you use for moves in ${location.town}?`,
    answer: `We operate 3.5-tonne Luton low-loader box vans equipped with 500kg hydraulic tail lifts, high-grade furniture blankets, and heavy-duty transit ties. These vans offer ample capacity while maintaining the maneuverability needed for residential roads.`
  },
  {
    question: `Are your removal teams directly employed and DBS-checked?`,
    answer: `Yes. All Jimmys Removals porters and drivers are directly employed, uniformed, and DBS-checked. We never subcontract your move to unverified third-party transport workers.`
  },
  {
    question: `What happens if there is a delay in key handover on completion day?`,
    answer: `We understand that solicitor and banking delays can happen on completion day. Our operations team maintains close communication with you throughout the day to ensure a smooth transition with zero hidden fees.`
  },
  {
    question: `How far in advance should I book my move in ${location.town}?`,
    answer: `We recommend booking 1 to 3 weeks in advance to secure your preferred date, especially for Fridays and month-end dates. However, we operate 24 hours, 7 days a week, and accommodate short-notice or same-day moves whenever vehicle scheduling allows.`
  },
  {
    question: `Do you provide packing materials and wardrobe boxes?`,
    answer: `Yes. We supply double-walled corrugated cardboard cartons, wardrobe boxes with hanging rails, bubble wrap, packing paper, and tape. We also offer full and fragile-only packing services.`
  },
  {
    question: `Can you dismantle and reassemble large furniture?`,
    answer: `Yes. Our movers carry comprehensive tool kits to disassemble and reassemble wardrobes, divan and framed beds, dining tables, and flat-pack units.`
  },
  {
    question: `How do you protect carpets and door frames during the move?`,
    answer: `Our crew lays down heavy-duty non-slip floor runners across main entrance hallways, stairs, and landings, and uses padded covers for door frames and banisters.`
  }
];

if (isBirmingham) {
  defaultFaqs.unshift({
    question: 'Are there Clean Air Zone charges for removals in Birmingham?',
    answer: 'No Clean Air Zone charges are added to your quote. We operate inside the A4540 Middleway ring road with zero CAZ surcharges for our customers.'
  });
}

const mergedFaqs = [
  ...(location.localFaqs || []).filter(f => f.display && !f.question.includes('{{')),
  ...defaultFaqs
].slice(0, 12);

// Check if testimonial is valid and doesn't contain placeholders
const hasValidReview = location.testimonial &&
  location.testimonial.text &&
  !location.testimonial.text.includes('{{') &&
  !location.testimonial.name.includes('{{');

// Clean NAP data
const fullBusinessName = siteConfig.legalName;
const tradingName = siteConfig.tradingName;
const companyNumber = siteConfig.companyNumber;
const regOffice = siteConfig.address.fullAddress;
// Town-tailored challenges, scenarios, and property types
const nearbyList = location.nearbyAreas && location.nearbyAreas.length > 0
  ? location.nearbyAreas.map((a) => a.name).join(', ')
  : 'the wider West Midlands';
const postcodeSummary = location.postcodes && location.postcodes.length > 0
  ? location.postcodes.slice(0, 3).join(', ')
  : location.town;

const localChallenges = [
  {
    num: 1,
    title: `Kerbside Parking & Access in ${location.town}`,
    desc: `Residential turnings across ${location.town} (${postcodeSummary}) frequently feature parked vehicles on both kerbsides. Our drivers position 3.5-tonne Luton vans safely without blocking through-traffic or neighbours' driveways.`
  },
  {
    num: 2,
    title: `Apartment Lifts & Concierge Protocols`,
    desc: `Multi-storey flat moves require coordinated lift allocation. For properties in ${location.town}, we liaise directly with building concierges to reserve service lift windows and stage packed boxes for rapid loading.`
  },
  {
    num: 3,
    title: `Regional Route Planning for ${location.town}`,
    desc: location.travelInfo 
      ? `Our logistics team schedules departure times around key arterial corridors: ${location.travelInfo} to steer clear of peak morning congestion.`
      : `We monitor live traffic on regional trunk roads and motorway junctions serving ${location.town} to maintain punctual arrival schedules.`
  },
  {
    num: 4,
    title: `Narrow Stairwells & Heritage Doorways`,
    desc: `Older residences across ${location.town} often present steep stairs and tight vestibule angles. Our porters apply protective neoprene wraps to banisters and door frames, dismantling modular furniture as needed.`
  },
  {
    num: 5,
    title: `Heavy Kitchen Appliances & Range Cookers`,
    desc: `American fridge-freezers, range ovens, and washing machines in ${location.town} homes are manoeuvred safely with heavy-duty dollies and lifted smoothly via 500kg electric vehicle tail lifts.`
  },
  {
    num: 6,
    title: `Completion Day Handover Flexibility`,
    desc: `If bank funds or estate agent key releases face afternoon delays in ${location.town}, our crew remains dedicated to your booking, waiting on site so you are safely unpacked before nightfall.`
  }
];

const localScenarios = [
  {
    title: `1. Full House Relocations in ${location.town}`,
    desc: `From semi-detached family homes to detached residences across ${location.town} (${postcodeSummary}), our teams coordinate systematic room-by-room loading, furniture wrapping, and wardrobe dismantling.`
  },
  {
    title: `2. Flats & Apartment Moves`,
    desc: `Relocating to or from apartments in ${location.town}. We coordinate with building management, manage lift time slots, and protect communal corridors with heavy-duty carpet runners.`
  },
  {
    title: `3. Student & Room Relocations`,
    desc: `Budget-conscious room moves connecting students and young professionals in ${location.town} with universities across the region, transporting study desks, trunks, and boxed possessions.`
  },
  {
    title: `4. Commercial & Office Moves in ${location.town}`,
    desc: `Relocating local offices, commercial premises, or retail shops in ${location.town}. We move workstations, file cabinets, and IT equipment during evenings or weekends to maintain business continuity.`
  },
  {
    title: `5. Urgent Same-Day Removals`,
    desc: `Facing an unexpected move deadline or rapid exchange in ${location.town}? Operating 24 hours, 7 days a week with West Midlands depots, we accommodate emergency moves subject to fleet availability.`
  },
  {
    title: `6. Single Item & Heavy Furniture Transport`,
    desc: `Need an individual sofa suite, solid oak table, or piano moved between ${location.town} and ${nearbyList}? We provide tailored transport with tail-lift loading.`
  }
];

const localPropertyTypes = [
  {
    title: `Period Terraces & Cottages in ${location.town}`,
    desc: `Character homes with narrow hallways and stepped entrances across ${location.town}. Our porters use neoprene floor runners and padded banister sleeves to protect heritage woodwork.`
  },
  {
    title: `Semi-Detached Houses across ${location.town}`,
    desc: `Traditional family homes with shared driveways and gardens. We load systematically so high-priority rooms (kitchens, master bedrooms) are unloaded first at your new address.`
  },
  {
    title: `Modern Detached Homes in ${location.town}`,
    desc: `Executive detached properties in residential developments. We supply dedicated multi-van Luton capacity to complete whole-home relocations in a single smooth operation.`
  },
  {
    title: `Apartments & Conversions in ${location.town}`,
    desc: `Contemporary residential apartments and loft apartments. We handle access codes, concierge protocols, and lift protection across ${location.town}.`
  }
];

const phone = siteConfig.phone;
const phoneHref = siteConfig.phoneHref;
const email = siteConfig.email;
---

<BaseLayout
  title={location.metaTitle || `Removals in ${location.town} | Jimmys Removals`}
  description={location.metaDescription || `Professional house removals, flat moves, and packing services across ${location.town}. DBS-checked movers, Luton vans, and guaranteed fixed quotes.`}
  breadcrumbs={breadcrumbs}
>
  <!-- ========================================================================= -->
  <!-- A1. HERO SECTION                                                          -->
  <!-- ========================================================================= -->
  <section class="relative bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900 text-white pt-8 pb-16 lg:pb-24 border-b border-slate-800 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} class="mb-6 text-slate-400" />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
            <Icon name="map-pin" class="w-3.5 h-3.5" />
            <span>{location.town}, {location.county}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            {location.heroHeading || `House Removals & Moving Services in ${location.town}`}
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed" data-nosimilarity="true">
            Reliable, fully insured removals across {location.town} and the West Midlands. Directly employed, DBS-checked movers operating modern 3.5-tonne Luton vans with guaranteed fixed quotes.
          </p>

          <!-- Same-Day Delivery Highlight (same as homepage) -->
          <div class="flex flex-wrap items-center gap-3 pt-1" data-nosimilarity="true">
            <a
              href="/services/same-day-delivery/"
              class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 backdrop-blur-md text-xs sm:text-sm text-amber-300 font-bold transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
              <Icon name="clock" class="w-4 h-4 text-amber-400" />
              <span>Same-Day Delivery Available Across Birmingham & West Midlands</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
            </a>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <a
              href="#quote-form"
              class="px-5 py-3 rounded-xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all hover:scale-[1.02] flex items-center gap-2"
            >
              <span>Get a Fixed Quote</span>
              <Icon name="arrow-right" class="w-4 h-4" />
            </a>

            <a
              href={phoneHref}
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm border border-slate-700 transition-all flex items-center gap-2"
            >
              <Icon name="phone" class="w-4 h-4 text-amber-400" />
              <span>Call {phone}</span>
            </a>

            {siteConfig.whatsappEnabled && (
              <a
                href={siteConfig.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow transition-all flex items-center gap-2"
              >
                <Icon name="chat" class="w-4 h-4" />
                <span>WhatsApp</span>
              </a>
            )}
          </div>

          <!-- Trust Strip -->
          <div class="pt-6 border-t border-slate-800/80" data-nosimilarity="true">
            <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-300 font-medium">
              <li class="flex items-center gap-1.5">
                <Icon name="clock" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Open 24 hours, 7 days a week</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="shield-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>DBS-checked crews</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="badge-check" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fixed quotes</span>
              </li>
              <li class="flex items-center gap-1.5">
                <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                <span>Fully insured</span>
              </li>
              {isBirmingham && (
                <li class="flex items-center gap-1.5 text-amber-400">
                  <Icon name="check-circle" class="w-4 h-4 text-amber-400 shrink-0" />
                  <span>Zero CAZ surcharges</span>
                </li>
              )}
            </ul>
          </div>
        </div>

        <!-- Hero Quote Form (5 cols) -->
        <div id="quote-form" data-nosimilarity="true" class="lg:col-span-5 bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white">
          <div class="mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">Fast & Transparent</span>
            <h3 class="text-xl font-bold mt-1">Get Your Guaranteed Move Quote</h3>
            <p class="text-xs text-slate-600 dark:text-slate-300 mt-1">
              Fixed pricing with no hidden charges. We respond promptly day and night.
            </p>
          </div>
          <ContactForm formType="quick-quote" prefilledLocation={location.town} />
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- A2. INTRO SECTION & FLEET SHOWCASE                                        -->
  <!-- ========================================================================= -->
  <section class="py-14 lg:py-20 bg-white dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800 relative overflow-hidden">
    <!-- Subtle Background Glow Accents -->
    <div class="absolute top-0 right-0 -mt-16 -mr-16 w-80 h-80 bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -mb-16 -ml-16 w-80 h-80 bg-blue-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Left Column: Editorial Content (7 cols) -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20" data-nosimilarity="true">
            <Icon name="truck" class="w-3.5 h-3.5" />
            <span>Dedicated Local Moving Fleet</span>
          </div>

          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
            Professional Moving & Logistics Across {location.town}
          </h2>

          <div class="prose prose-slate dark:prose-invert max-w-none text-base sm:text-lg leading-relaxed space-y-4">
            <p class="font-medium text-slate-900 dark:text-slate-100" data-nosimilarity="true">
              Removals in {location.town} require careful planning, punctual scheduling, and movers who understand the unique layout of local streets, housing estates, and transport corridors.
            </p>
            <p class="text-slate-700 dark:text-slate-300">
              {location.intro}
            </p>
            {location.localKnowledge && (
              <p class="text-slate-700 dark:text-slate-300">
                {location.localKnowledge}
              </p>
            )}
          </div>

          <!-- Modern UX Feature Highlights (3 Interactive Micro-Cards) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2" data-nosimilarity="true">
            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="truck" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">3.5T Luton Vans</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Hydraulic tail-lifts & padded cargo tie rails
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="shield-check" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">DBS Movers</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Directly employed, uniformed staff
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between group hover:border-amber-500/50 transition-all">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="w-7 h-7 rounded-lg bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-xs">
                  <Icon name="badge-check" class="w-3.5 h-3.5" />
                </span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">Fixed Price</span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
                Guaranteed quote with zero hidden extras
              </p>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Showcase with ImageSlot 1 (5 cols) -->
        <div class="lg:col-span-5 space-y-3">
          <div class="relative group rounded-3xl overflow-hidden shadow-xl border border-slate-200/80 dark:border-slate-800 bg-slate-100 dark:bg-slate-800">
            <ImageSlot
              src={location.images?.hero?.src || location.heroImage}
              alt={location.images?.hero?.alt || `Jimmys Removals Luton van ready for a house move in ${location.town}`}
              aspect="4/3"
              slotId="hero"
              loading="eager"
              fetchpriority="high"
            />

            <!-- Glassmorphic floating card at the bottom of the photo -->
            <div class="absolute bottom-3 left-3 right-3 p-3.5 rounded-2xl bg-slate-950/85 backdrop-blur-md border border-white/10 text-white flex items-center justify-between shadow-lg" data-nosimilarity="true">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center">
                  <Icon name="shield" class="w-4 h-4" />
                </div>
                <div>
                  <p class="text-xs font-bold leading-tight">Jimmys Removals & Logistics</p>
                  <p class="text-[11px] text-slate-300">{location.town} & West Midlands</p>
                </div>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500 text-slate-950 shadow-sm">
                Fully Insured
              </span>
            </div>
          </div>

          <!-- Micro caption below image -->
          <div class="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400 px-1" data-nosimilarity="true">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              <span>Clean, equipped Luton low-loaders</span>
            </span>
            <span>Open 24 hours, 7 days</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- A3. LOCAL CHALLENGES, LOCAL FIXES                                         -->
  <!-- ========================================================================= -->
  <section class="py-12 lg:py-16 bg-slate-50 dark:bg-slate-950/50 border-b border-slate-200 dark:border-slate-800" data-nosimilarity="true">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Local Moving Challenges in {location.town} & How We Solve Them
        </h2>
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400 mt-2">
          From street parking limits to apartment lift bookings, our experienced teams prepare for every local detail.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {localChallenges.map((c) => (
