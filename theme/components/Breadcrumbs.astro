---
import Icon from './Icon.astro';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

{items.length > 0 && (
  <nav class={`flex text-xs sm:text-sm text-slate-500 dark:text-slate-400 ${className}`} aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 sm:space-x-2 flex-wrap">
      {items.map((crumb, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="inline-flex items-center">
            {idx > 0 && (
              <span class="mx-1 text-slate-300 dark:text-slate-600">
                <Icon name="chevron-right" class="w-3 h-3" />
              </span>
            )}
            {isLast ? (
              <span class="font-semibold text-slate-800 dark:text-slate-200" aria-current="page">
                {crumb.name}
              </span>
            ) : (
              <a
                href={crumb.item}
                class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors"
              >
                {crumb.name}
              </a>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
