---
import Icon from './Icon.astro';

export interface Props {
  idPrefix?: string;
  defaultFrom?: string;
  defaultTo?: string;
  placeholderFrom?: string;
  placeholderTo?: string;
  serviceName?: string;
  buttonText?: string;
}

const {
  idPrefix = 'inline',
  defaultFrom = '',
  defaultTo = '',
  placeholderFrom = 'e.g. B15 2TT or Harborne',
  placeholderTo = 'e.g. B91 3AB or Solihull',
  serviceName,
  buttonText = 'Get My Free Quote'
} = Astro.props;
---

<form
  id={`${idPrefix}-quote-form`}
  action="/get-a-quote/"
  method="GET"
  class="space-y-4"
>
  {serviceName && <input type="hidden" name="service" value={serviceName} />}
  <div>
    <label for={`${idPrefix}-from-postcode`} class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
      Moving From (Postcode)
    </label>
    <div class="relative">
      <input
        type="text"
        id={`${idPrefix}-from-postcode`}
        name="from"
        value={defaultFrom}
        placeholder={placeholderFrom}
        required
        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500"
      />
    </div>
  </div>

  <div>
    <label for={`${idPrefix}-to-postcode`} class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
      Moving To (Postcode)
    </label>
    <div class="relative">
      <input
        type="text"
        id={`${idPrefix}-to-postcode`}
        name="to"
        value={defaultTo}
        placeholder={placeholderTo}
        required
        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500"
      />
    </div>
  </div>

  <div>
    <label for={`${idPrefix}-contact-info`} class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">
      Phone Number or Email
    </label>
    <div class="relative">
      <input
        type="text"
        id={`${idPrefix}-contact-info`}
        name="contact"
        placeholder="e.g. 07123 456789 or name@example.co.uk"
        required
        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500"
      />
    </div>
  </div>

  <button
    type="submit"
    class="w-full py-3.5 px-4 bg-gradient-to-r from-amber-500 via-amber-600 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-white font-bold text-sm rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 interactive-btn cursor-pointer"
  >
    <span>{buttonText}</span>
    <Icon name="chevron-right" class="w-4 h-4" />
  </button>

  <p class="text-[11px] text-slate-400 text-center">
    Free, no-obligation moving quote. No spam guaranteed.
  </p>
</form>

<script is:inline define:vars={{ formId: `${idPrefix}-quote-form` }}>
  (function() {
    const f = document.getElementById(formId);
    if (!f) return;
    f.addEventListener('submit', function(e) {
      const fromVal = f.elements['from']?.value || '';
      const toVal = f.elements['to']?.value || '';
      const contactVal = f.elements['contact']?.value || '';
      const serviceVal = f.elements['service']?.value || '';

      const formData = new FormData();
      formData.append('_subject', `New Quick Quote Enquiry (From ${fromVal} to ${toVal}) - Jimmys Removals`);
      formData.append('_template', 'table');
      formData.append('_captcha', 'false');
      formData.append('moving_from', fromVal);
      formData.append('moving_to', toVal);
      formData.append('contact_info', contactVal);
      if (serviceVal) formData.append('service_requested', serviceVal);

      try {
        fetch('https://formsubmit.co/ajax/jimmyslogisticsandremovals@gmail.com', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' },
          keepalive: true
        });
      } catch (err) {}
    });
  })();
</script>
