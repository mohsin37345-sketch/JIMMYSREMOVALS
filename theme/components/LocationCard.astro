---
import Icon from './Icon.astro';

export interface Props {
  town: string;
  slug: string;
  county: string;
  tier: 1 | 2;
  postcodes?: string[];
  cazEnabled?: boolean;
  cleanAirZone?: boolean;
  intro?: string;
}

const {
  town,
  slug,
  county,
  tier,
  postcodes = [],
  cazEnabled = false,
  cleanAirZone = false,
  intro
} = Astro.props;

const isCaz = cazEnabled || cleanAirZone;
---

<article class="group relative p-5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:border-amber-500/50 transition-all flex flex-col justify-between interactive-card">
  <div>
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
        {county}
      </span>
      <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${
        tier === 1 
          ? 'bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400' 
          : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
      }`}>
        Tier {tier}
      </span>
    </div>

    <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
      <a href={`/areas/${slug}/`} class="after:absolute after:inset-0">
        {town} Removals
      </a>
    </h3>

    {intro && (
      <p class="text-xs text-slate-600 dark:text-slate-400 mt-2 line-clamp-2 leading-relaxed">
        {intro}
      </p>
    )}

    {isCaz && (
      <div class="mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Clean Air Zone Compliant</span>
      </div>
    )}
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
    <div class="text-slate-400 text-[11px] truncate max-w-[150px]">
      {postcodes.slice(0, 3).join(', ')}{postcodes.length > 3 ? '...' : ''}
    </div>
    <span class="font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
      Explore <Icon name="chevron-right" class="w-3 h-3" />
    </span>
  </div>
</article>
