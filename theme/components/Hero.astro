---
import { siteConfig } from 'src/data/site';
import Icon from './Icon.astro';
import QuoteFormInline from './QuoteFormInline.astro';

export interface Props {
  variant?: 'home' | 'service' | 'location' | 'blog' | 'legal' | 'page';
  title: string;
  subtitle?: string;
  badge?: string;
  priceFrom?: number;
  priceUnit?: string;
  cazEnabled?: boolean;
  cazNote?: string;
  town?: string;
  county?: string;
  postcodes?: string[];
  readingTimeText?: string;
  author?: string;
  date?: string;
}

const {
  variant = 'home',
  title,
  subtitle,
  badge,
  priceFrom,
  priceUnit = 'fixed quote',
  cazEnabled,
  cazNote,
  town,
  county,
  postcodes = [],
  readingTimeText,
  author,
  date
} = Astro.props;
---

<section
  class="relative overflow-hidden text-white py-14 lg:py-24"
  style="background: radial-gradient(ellipse at 85% 15%, rgba(245, 158, 11, 0.28) 0%, transparent 45%), radial-gradient(ellipse at 15% 35%, rgba(99, 102, 241, 0.25) 0%, transparent 40%), radial-gradient(ellipse at 50% 85%, rgba(56, 189, 248, 0.15) 0%, transparent 50%), linear-gradient(140deg, #1e293b 0%, #293548 35%, #1e2238 70%, #171d2d 100%);"
>
  <!-- Dynamic Modern Ambient Glows (Smooth Aurora, Zero Grid Squares) -->
  <div class="absolute -top-32 -left-20 w-[550px] h-[550px] bg-indigo-500/20 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="absolute top-10 right-0 w-[500px] h-[500px] bg-amber-500/20 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute -bottom-32 left-1/3 w-[600px] h-[600px] bg-sky-500/15 rounded-full blur-[150px] pointer-events-none"></div>

  <!-- Soft Modern Organic Waves (Zero Squares, Smooth Transport Corridors) -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-60" preserveAspectRatio="none" viewBox="0 0 1440 600" aria-hidden="true">
    <defs>
      <linearGradient id="hero-wave-amber" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.6" />
        <stop offset="50%" stop-color="#f59e0b" stop-opacity="0.4" />
        <stop offset="100%" stop-color="#818cf8" stop-opacity="0.1" />
      </linearGradient>
      <linearGradient id="hero-wave-indigo" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.5" />
        <stop offset="50%" stop-color="#818cf8" stop-opacity="0.3" />
        <stop offset="100%" stop-color="#fbbf24" stop-opacity="0.05" />
      </linearGradient>
    </defs>
    <!-- Organic curved transit corridor lines -->
    <path d="M-100,160 C340,60 760,380 1540,160" fill="none" stroke="url(#hero-wave-amber)" stroke-width="1.5" />
    <path d="M-100,260 C380,160 820,480 1540,260" fill="none" stroke="url(#hero-wave-amber)" stroke-width="1.2" stroke-dasharray="8 6" opacity="0.7" />
    <path d="M-50,500 C420,300 920,420 1500,120" fill="none" stroke="url(#hero-wave-indigo)" stroke-width="1.5" stroke-dasharray="6 6" opacity="0.6" />
    <path d="M120,-60 C480,260 740,80 1240,700" fill="none" stroke="url(#hero-wave-indigo)" stroke-width="1.5" opacity="0.5" />
  </svg>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {variant === 'home' && (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left column: Value Proposition & CTAs -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-amber-500/20 via-amber-400/15 to-blue-500/20 border border-amber-400/50 text-amber-300 text-xs sm:text-sm font-bold backdrop-blur-md shadow-sm">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <Icon name="shield" class="w-4 h-4 text-amber-400" />
            <span>Birmingham & West Midlands Relocations</span>
          </div>

          <h1 class="text-3xl sm:text-5xl xl:text-6xl font-black tracking-tight text-white leading-[1.14]">
            Stress-Free House Removals & Logistics in <span class="bg-gradient-to-r from-amber-400 via-amber-300 to-amber-500 bg-clip-text text-transparent underline decoration-amber-500/40 decoration-wavy decoration-from-font">Birmingham</span>
          </h1>

          <p class="text-base sm:text-lg text-blue-100/90 max-w-2xl leading-relaxed font-normal">
            Fully insured, DBS-checked removal teams with Clean Air Zone compliant vans. Transparent upfront pricing, zero hidden fees, operating 7 days a week across the entire West Midlands.
          </p>

          <!-- Key Highlights -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2">
            <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 backdrop-blur-md transition-all text-xs sm:text-sm text-white font-semibold shadow-sm">
              <span class="w-5 h-5 rounded-lg bg-amber-400/20 text-amber-300 flex items-center justify-center shrink-0">
                <Icon name="check" class="w-3.5 h-3.5" />
              </span>
              <span>£50k Transit Cover</span>
            </div>
            <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 backdrop-blur-md transition-all text-xs sm:text-sm text-white font-semibold shadow-sm">
              <span class="w-5 h-5 rounded-lg bg-amber-400/20 text-amber-300 flex items-center justify-center shrink-0">
                <Icon name="check" class="w-3.5 h-3.5" />
              </span>
              <span>Zero CAZ Charges</span>
            </div>
            <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 backdrop-blur-md transition-all text-xs sm:text-sm text-white font-semibold shadow-sm col-span-2 sm:col-span-1">
              <span class="w-5 h-5 rounded-lg bg-amber-400/20 text-amber-300 flex items-center justify-center shrink-0">
                <Icon name="check" class="w-3.5 h-3.5" />
              </span>
              <span>7 Days a Week</span>
            </div>
          </div>

          <!-- Direct Phone CTA -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="/get-a-quote/"
              class="px-7 py-3.5 text-base font-extrabold text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-500 hover:from-amber-300 hover:to-amber-400 rounded-xl shadow-xl shadow-amber-500/25 hover:shadow-amber-500/35 transition-all transform hover:-translate-y-0.5 interactive-btn flex items-center gap-2"
            >
              <span>Get a Free Quote</span>
              <Icon name="chevron-right" class="w-4 h-4" />
            </a>
            <a
              href={`tel:${siteConfig.phoneE164}`}
              class="inline-flex items-center gap-2.5 px-5 py-3.5 text-base font-bold text-white bg-white/10 hover:bg-white/20 border border-white/25 rounded-xl backdrop-blur-md transition-all transform hover:-translate-y-0.5 shadow-sm"
            >
              <Icon name="phone" class="w-5 h-5 text-amber-400" />
              <span>{siteConfig.phone}</span>
            </a>
          </div>
        </div>

        <!-- Right column: Fast Quote Conversion Card -->
        <div class="lg:col-span-5">
          <div class="relative p-6 sm:p-8 rounded-3xl bg-white/95 dark:bg-slate-900/95 backdrop-blur-2xl border border-white/80 dark:border-slate-700/80 shadow-[0_25px_60px_rgba(2,24,64,0.35)] text-slate-900 dark:text-white ring-1 ring-blue-500/20 overflow-hidden">
            <!-- Top Gradient Accent Line -->
            <div class="absolute top-0 left-6 right-6 h-1.5 bg-gradient-to-r from-amber-500 via-amber-400 to-blue-500 rounded-b-full"></div>

            <div class="mb-4 pt-1">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-100 text-amber-900 dark:bg-amber-950/70 dark:text-amber-300 mb-1">
                Fast 60-Second Estimate
              </div>
              <h2 class="text-xl sm:text-2xl font-black tracking-tight mt-1 text-slate-900 dark:text-white">Get Your Moving Quote</h2>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
                Direct, transparent pricing with no hidden charges.
              </p>
            </div>
            <QuoteFormInline />
          </div>
        </div>
      </div>
    )}

    {variant === 'service' && (
      <div class="max-w-3xl space-y-6">
        {badge && (
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold">
            {badge}
          </div>
        )}
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {title}
        </h1>
        {subtitle && (
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            {subtitle}
          </p>
        )}
        {priceFrom && (
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800/80 border border-slate-700 text-sm">
            <span class="text-slate-400">Prices from</span>
            <span class="text-xl font-extrabold text-amber-400">£{priceFrom}</span>
            <span class="text-xs text-slate-400">({priceUnit})</span>
          </div>
        )}
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="/get-a-quote/"
            class="px-6 py-3 text-sm font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow transition interactive-btn"
          >
            Get a Free Quote
          </a>
          <a
            href={`tel:${siteConfig.phoneE164}`}
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-white border border-slate-700 hover:bg-slate-800 rounded-lg transition"
          >
            <Icon name="phone" class="w-4 h-4 text-amber-400" />
            <span>Call {siteConfig.phone}</span>
          </a>
        </div>
      </div>
    )}

    {variant === 'location' && (
      <div class="max-w-3xl space-y-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-amber-500/15 text-amber-400 text-xs font-bold uppercase tracking-wider border border-amber-500/30">
            {town}, {county}
          </span>
          {cazEnabled ? (
            <span class="px-3 py-1 rounded-full bg-emerald-950/80 text-emerald-300 text-xs font-semibold border border-emerald-700/60 flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>{cazNote || "Clean Air Zone Compliant Fleet"}</span>
            </span>
          ) : (
            <span class="px-3 py-1 rounded-full bg-slate-800 text-slate-300 text-xs font-semibold border border-slate-700">
              No CAZ Surcharges
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {title}
        </h1>

        {subtitle && (
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            {subtitle}
          </p>
        )}

        {postcodes.length > 0 && (
          <div class="text-xs sm:text-sm text-slate-400 flex flex-wrap items-center gap-2">
            <span class="font-semibold text-slate-300">Postcodes Served:</span>
            {postcodes.map((pc) => (
              <span class="bg-slate-800 text-slate-200 px-2 py-0.5 rounded text-xs font-mono">
                {pc}
              </span>
            ))}
          </div>
        )}

        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a
            href="/get-a-quote/"
            class="px-6 py-3 text-sm font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow transition interactive-btn"
          >
            Get a Free Quote in {town}
          </a>
          <a
            href={`tel:${siteConfig.phoneE164}`}
            class="inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold text-white border border-slate-700 hover:bg-slate-800 rounded-lg transition"
          >
            <Icon name="phone" class="w-4 h-4 text-amber-400" />
            <span>Call {siteConfig.phone}</span>
          </a>
        </div>
      </div>
    )}

    {variant === 'blog' && (
      <div class="max-w-3xl space-y-4">
        {badge && (
          <span class="px-3 py-1 rounded-full bg-amber-500/15 text-amber-400 text-xs font-bold uppercase tracking-wider border border-amber-500/30">
            {badge}
          </span>
        )}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {title}
        </h1>
        {subtitle && (
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            {subtitle}
          </p>
        )}
        <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-400 pt-2">
          {author && <span>By {author}</span>}
          {date && <span>· Published {date}</span>}
          {readingTimeText && <span>· {readingTimeText}</span>}
        </div>
      </div>
    )}

    {(variant === 'legal' || variant === 'page') && (
      <div class="max-w-3xl space-y-3">
        {badge && (
          <span class="inline-block px-3 py-1 rounded-full bg-amber-500/15 text-amber-400 text-xs font-bold uppercase tracking-wider border border-amber-500/30 mb-2">
            {badge}
          </span>
        )}
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
          {title}
        </h1>
        {subtitle && (
          <p class="text-base sm:text-lg text-slate-300">
            {subtitle}
          </p>
        )}
      </div>
    )}

  </div>
</section>
