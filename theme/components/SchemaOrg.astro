---
import { siteConfig } from 'src/data/site';
import socialLinks from 'src/data/social.json';
import navigation from 'src/data/navigation.json';
import { absoluteUrl } from 'theme/utils/absoluteUrl';
import { getCollection } from 'astro:content';

export interface BreadcrumbItem {
  name: string;
  item: string;
}

export interface FaqItem {
  question: string;
  answer: string;
  display?: boolean;
}

export interface ReviewItem {
  name: string;
  town?: string;
  service?: string;
  rating: number;
  date: string;
  body: string;
  verified: boolean;
}

export interface Props {
  type?: 'Home' | 'Service' | 'Location' | 'ServiceArea' | 'About' | 'Contact' | 'Blog' | 'BlogPost' | 'Legal' | 'Generic';
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  serviceData?: {
    name: string;
    description: string;
    priceFrom?: number;
    url: string;
  };
  locationData?: {
    town: string;
    county: string;
    postcodes: string[];
    lat: number | string;
    lng: number | string;
    url: string;
  };
  reviews?: ReviewItem[];
  blogPost?: {
    headline: string;
    description: string;
    image: string;
    datePublished: string;
    dateModified?: string;
    author: string;
    wordCount?: number;
    category?: string;
    url: string;
  };
  blogItems?: Array<{
    title: string;
    url: string;
    position?: number;
  }>;
}

const {
  type = 'Generic',
  breadcrumbs = [],
  faqs = [],
  serviceData,
  locationData,
  reviews: _reviews = [],
  blogPost,
  blogItems = []
} = Astro.props;

const movingCompanyId = `${siteConfig.siteUrl}/#movingcompany`;
const organizationId = `${siteConfig.siteUrl}/#organization`;
const websiteId = `${siteConfig.siteUrl}/#website`;

// Social and Profile URLs for sameAs (including Google Business Profile)
const sameAs = [
  ...Object.values(socialLinks).filter((url) => typeof url === 'string' && url.trim().length > 0),
  ...(siteConfig.googleBusinessProfileUrl && siteConfig.googleBusinessProfileUrl.trim().length > 0
    ? [siteConfig.googleBusinessProfileUrl]
    : [])
];

// All 37 West Midlands coverage towns for schema areaServed
const all37Towns = [
  'Birmingham', 'Solihull', 'Coventry', 'Wolverhampton', 'Dudley', 'Walsall', 'West Bromwich',
  'Sutton Coldfield', 'Stourbridge', 'Halesowen', 'Oldbury', 'Smethwick', 'Tipton', 'Wednesbury',
  'Willenhall', 'Bilston', 'Brierley Hill', 'Kingswinford', 'Rowley Regis', 'Cradley Heath',
  'Bloxwich', 'Aldridge', 'Shirley', 'Nuneaton', 'Bedworth', 'Leamington Spa', 'Tamworth',
  'Lichfield', 'Cannock', 'Bromsgrove', 'Redditch', 'Harborne', 'Moseley', 'Kings Heath',
  'Selly Oak', 'Northfield', 'Erdington'
];

// 1. Organization Schema (Legal entity and compliance identifiers)
const organizationSchema: Record<string, any> = {
  '@type': 'Organization',
  '@id': organizationId,
  name: siteConfig.legalName,
  legalName: siteConfig.legalName,
  url: siteConfig.siteUrl,
  ...(siteConfig.vatNumber ? { vatID: siteConfig.vatNumber } : {}),
  identifier: [
    {
      '@type': 'PropertyValue',
      name: 'Companies House Registration',
      value: siteConfig.companyNumber
    },
    ...(siteConfig.wasteCarrierLicence ? [{
      '@type': 'PropertyValue',
      name: 'Environment Agency Waste Carrier Licence',
      value: siteConfig.wasteCarrierLicence
    }] : [])
  ],
  sameAs: sameAs.length > 0 ? sameAs : undefined
};

// 2. MovingCompany Schema (Specialized schema.org subtype)
const movingCompanySchema: Record<string, any> = {
  '@type': 'MovingCompany',
  '@id': movingCompanyId,
  name: siteConfig.businessName,
  legalName: siteConfig.legalName,
  url: siteConfig.siteUrl,
  parentOrganization: { '@id': organizationId },
  logo: {
    '@type': 'ImageObject',
    url: `${siteConfig.siteUrl}/favicon.svg`
  },
  image: [
    `${siteConfig.siteUrl}/images/moves/luton-van-tail-lift.webp`,
    `${siteConfig.siteUrl}/images/moves/jimmys-removals-birmingham-house-removals-van.webp`,
    `${siteConfig.siteUrl}/images/moves/furniture-packing-blankets.webp`
  ],
  description: `Fixed-price house removals across Birmingham & the West Midlands. Directly employed, DBS-checked movers, fully insured. Guaranteed fixed quotes — ${siteConfig.phone}.`,
  telephone: siteConfig.phoneE164,
  email: siteConfig.email,
  priceRange: siteConfig.priceRange,
  paymentAccepted: 'Cash, Credit Card, Debit Card, Bank Transfer',
  currenciesAccepted: 'GBP',
  hasMap: siteConfig.googleBusinessProfileUrl || undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address.streetAddress,
    addressLocality: siteConfig.address.addressLocality,
    addressRegion: siteConfig.address.addressRegion,
    postalCode: siteConfig.address.postalCode,
    addressCountry: siteConfig.address.addressCountry
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: siteConfig.geo.latitude,
    longitude: siteConfig.geo.longitude
  },
  openingHoursSpecification: siteConfig.openingHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes
  })),
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'West Midlands' },
    ...all37Towns.map((town) => ({ '@type': 'City', name: town }))
  ],
  sameAs: sameAs.length > 0 ? sameAs : undefined,
  ...(siteConfig.aggregateRating ? {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: siteConfig.aggregateRating.ratingValue,
      reviewCount: siteConfig.aggregateRating.reviewCount,
      bestRating: '5',
      worstRating: '1'
    }
  } : {}),
  ...(_reviews && _reviews.length > 0 ? {
    review: _reviews.map((rev) => ({
      '@type': 'Review',
      author: {
        '@type': 'Person',
        name: rev.name
      },
      datePublished: rev.date,
      reviewBody: rev.body,
      reviewRating: {
        '@type': 'Rating',
        ratingValue: rev.rating,
        bestRating: '5',
        worstRating: '1'
      }
    }))
  } : {})
};

// 3. WebSite Schema
const websiteSchema: Record<string, any> = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: siteConfig.siteUrl,
  name: siteConfig.legalName,
  publisher: { '@id': organizationId },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteConfig.siteUrl}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

// 4. SiteNavigationElement Graph
const navigationElements = navigation.mainNav.map((item, index) => ({
  '@type': 'SiteNavigationElement',
  position: index + 1,
  name: item.label,
  url: absoluteUrl(item.href)
}));

// Base graph initialization
const graph: any[] = [organizationSchema, movingCompanySchema, websiteSchema, ...navigationElements];

// 5. BreadcrumbList Schema
if (type === 'Home') {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${siteConfig.siteUrl}/`
      }
    ]
  });
} else if (breadcrumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      item: absoluteUrl(b.item)
    }))
  });
}

// 6. ImageObject Schemas for the 3 Fleet Photographs
if (type === 'Home') {
  graph.push(
    {
      '@type': 'ImageObject',
      '@id': `${siteConfig.siteUrl}/images/moves/luton-van-tail-lift.webp#image`,
      url: `${siteConfig.siteUrl}/images/moves/luton-van-tail-lift.webp`,
      contentUrl: `${siteConfig.siteUrl}/images/moves/luton-van-tail-lift.webp`,
      caption: 'Jimmys Removals 3.5T Luton box van with 500kg electric hydraulic tail-lift lowered for ground-level loading on street in Birmingham',
      author: { '@id': movingCompanyId }
    },
    {
      '@type': 'ImageObject',
      '@id': `${siteConfig.siteUrl}/images/moves/jimmys-removals-birmingham-house-removals-van.webp#image`,
      url: `${siteConfig.siteUrl}/images/moves/jimmys-removals-birmingham-house-removals-van.webp`,
      contentUrl: `${siteConfig.siteUrl}/images/moves/jimmys-removals-birmingham-house-removals-van.webp`,
      caption: 'Jimmys Removals modern liveried Luton removal van with tail lift, packed furniture, and uniformed mover in Birmingham',
      author: { '@id': movingCompanyId }
    },
    {
      '@type': 'ImageObject',
      '@id': `${siteConfig.siteUrl}/images/moves/furniture-packing-blankets.webp#image`,
      url: `${siteConfig.siteUrl}/images/moves/furniture-packing-blankets.webp`,
      contentUrl: `${siteConfig.siteUrl}/images/moves/furniture-packing-blankets.webp`,
      caption: 'Household furniture carefully wrapped with protective quilted transit blankets inside Jimmys Removals truck',
      author: { '@id': movingCompanyId }
    }
  );
}

// 7. 12 Services Schema for Homepage
if (type === 'Home') {
  try {
    const servicesList = await getCollection('services');
    servicesList.forEach((svc) => {
      const data = svc.data;
      const slug = svc.id;
      graph.push({
        '@type': 'Service',
        '@id': `${siteConfig.siteUrl}/services/${slug}/#service`,
        name: data.title,
        serviceType: data.shortTitle || data.title,
        description: data.summary,
        provider: { '@id': movingCompanyId },
        areaServed: [
          { '@type': 'AdministrativeArea', name: 'West Midlands' },
          ...all37Towns.map((town) => ({ '@type': 'City', name: town }))
        ],
        offers: {
          '@type': 'Offer',
          url: `${siteConfig.siteUrl}/services/${slug}/`,
          priceSpecification: {
            '@type': 'PriceSpecification',
            minPrice: data.priceFrom || 65,
            priceCurrency: 'GBP'
          }
        }
      });
    });
  } catch (e) {
    // Fallback if collection cannot be read at runtime
  }
}

// 8. FAQPage Schema (All 16 visible Q&As, matching visible text exactly)
const visibleFaqs = faqs.filter((f) => f.display !== false);
if (visibleFaqs.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: visibleFaqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer
      }
    }))
  });
}

// 9. Specific Service Schema (On Service Pages)
if ((type === 'Service' || type === 'ServiceArea') && serviceData) {
  const singleServiceSchema: Record<string, any> = {
    '@type': 'Service',
    name: serviceData.name,
    serviceType: serviceData.name,
    description: serviceData.description,
    provider: { '@id': movingCompanyId },
    url: absoluteUrl(serviceData.url)
  };
  if (serviceData.priceFrom) {
    singleServiceSchema.offers = {
      '@type': 'Offer',
      price: serviceData.priceFrom,
      priceCurrency: 'GBP',
      availability: 'https://schema.org/InStock',
      url: absoluteUrl(serviceData.url)
    };
  }
  graph.push(singleServiceSchema);
}

// 10. LocalBusiness + Service on Location Pages
if ((type === 'Location' || type === 'ServiceArea') && locationData) {
  graph.push({
    '@type': 'LocalBusiness',
    '@id': `${absoluteUrl(locationData.url)}#localbusiness`,
    name: `${siteConfig.businessName} ${locationData.town}`,
    parentOrganization: { '@id': movingCompanyId },
    url: absoluteUrl(locationData.url),
    telephone: siteConfig.phoneE164,
    areaServed: {
      '@type': 'City',
      name: locationData.town
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: locationData.lat,
      longitude: locationData.lng
    }
  });
}

// 11. Specific Page Types
if (type === 'About') {
  graph.push({
    '@type': 'AboutPage',
    '@id': `${siteConfig.siteUrl}/about-us/#page`,
    url: `${siteConfig.siteUrl}/about-us/`,
    name: `About ${siteConfig.legalName}`,
    mainEntity: { '@id': movingCompanyId }
  });
} else if (type === 'Contact') {
  graph.push({
    '@type': 'ContactPage',
    '@id': `${siteConfig.siteUrl}/contact-us/#page`,
    url: `${siteConfig.siteUrl}/contact-us/`,
    name: `Contact ${siteConfig.businessName}`
  });
} else if (type === 'Blog') {
  graph.push({
    '@type': 'Blog',
    '@id': `${siteConfig.siteUrl}/blog/#blog`,
    url: `${siteConfig.siteUrl}/blog/`,
    name: `${siteConfig.businessName} Moving Guides & Advice`,
    publisher: { '@id': movingCompanyId }
  });

  if (blogItems && blogItems.length > 0) {
    graph.push({
      '@type': 'ItemList',
      itemListElement: blogItems.map((item, idx) => ({
        '@type': 'ListItem',
        position: item.position || idx + 1,
        url: absoluteUrl(item.url),
        name: item.title
      }))
    });
  }
} else if (type === 'BlogPost' && blogPost) {
  graph.push({
    '@type': 'BlogPosting',
    headline: blogPost.headline.slice(0, 110),
    description: blogPost.description,
    image: absoluteUrl(blogPost.image),
    datePublished: blogPost.datePublished,
    dateModified: blogPost.dateModified || blogPost.datePublished,
    author: {
      '@type': 'Person',
      name: blogPost.author,
      url: `${siteConfig.siteUrl}/about-us/#author`
    },
    publisher: { '@id': movingCompanyId },
    mainEntityOfPage: absoluteUrl(blogPost.url),
    wordCount: blogPost.wordCount,
    articleSection: blogPost.category
  });
}

// Helper to strip undefined / null
function cleanObject(obj: any): any {
  if (Array.isArray(obj)) {
    return obj.map(cleanObject).filter((v) => v !== undefined && v !== null);
  }
  if (obj !== null && typeof obj === 'object') {
    return Object.entries(obj).reduce((acc: any, [key, value]) => {
      const cleaned = cleanObject(value);
      if (cleaned !== undefined && cleaned !== null && cleaned !== '') {
        acc[key] = cleaned;
      }
      return acc;
    }, {});
  }
  return obj;
}

const cleanedGraph = cleanObject(graph);
---

<script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': cleanedGraph })} />
