---
import Icon from './Icon.astro';
import ImageSlot from './ImageSlot.astro';

export interface Props {
  isBirmingham?: boolean;
  town?: string;
  imageSlotSrc?: string;
  imageSlotAlt?: string;
}

const {
  isBirmingham = false,
  town = 'Birmingham',
  imageSlotSrc,
  imageSlotAlt = 'Jimmys Removals movers wrapping furniture for transport'
} = Astro.props;

const pillars = [
  {
    title: 'Fully Insured Removals',
    desc: 'Every relocation is carried out by trained movers with full insurance protection throughout loading, transport, and unloading.',
    icon: 'shield',
    highlight: 'Fully Insured'
  },
  {
    title: 'Directly Employed, DBS-Checked Crews',
    desc: 'Every mover on your team is directly employed by us, background-checked, and in uniform. You know who is handling your furniture.',
    icon: 'check',
    highlight: 'Directly Employed'
  },
  {
    title: '3.5-Tonne Luton Vans with Tail Lifts',
    desc: 'We operate purpose-built 3.5-tonne Luton box vans fitted with hydraulic column tail lifts, protective blankets, and load-lock ties.',
    icon: 'truck',
    highlight: 'Tail Lift Fleet'
  },
  {
    title: 'Free, Fixed-Price Quotes',
    desc: 'You receive a transparent, fixed-price removal quote with no obligation. The price we quote is the price you pay.',
    icon: 'calculator',
    highlight: 'Fixed Quotes'
  },
  {
    title: 'Open 24 Hours, 7 Days a Week',
    desc: 'Removals and deliveries arranged at any hour, day or night, seven days a week, including bank holidays.',
    icon: 'clock',
    highlight: 'Open 24/7'
  },
  isBirmingham ? {
    title: 'Zero CAZ Surcharges',
    desc: 'No Clean Air Zone charges added to your quote when moving inside the Birmingham A4540 Middleway ring road.',
    icon: 'truck',
    highlight: 'Zero CAZ Surcharges'
  } : {
    title: 'Local Route Knowledge',
    desc: `Our drivers know the local streets, parking layouts, and motorway connections across ${town} and the wider region.`,
    icon: 'map-pin',
    highlight: 'Local Knowledge'
  }
];
---

<section id="why-choose-us" class="py-16 sm:py-20 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
        <Icon name="map-pin" class="w-4 h-4" />
        <span>East Birmingham Operations Base</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        Why Movers Choose Jimmys Removals
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
        Based in Birmingham, we provide reliable, punctual house moves across the West Midlands and dedicated transit across mainland Britain.
      </p>
    </div>

    <!-- 6 Pillars & Image Slot -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Pillars Grid (7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
        {pillars.map((pillar) => (
          <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md transition space-y-2.5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                  <Icon name={pillar.icon} class="w-5 h-5" />
                </span>
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full">
                  {pillar.highlight}
                </span>
              </div>
              <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-white leading-snug">
                {pillar.title}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mt-2">
                {pillar.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Image Slot 3 (team, 4/3) -->
      <div class="lg:col-span-5">
        <ImageSlot
          src={imageSlotSrc}
          alt={imageSlotAlt}
          aspect="4/3"
          slotId="team"
        />
      </div>

    </div>

  </div>
</section>
