---
import Icon from './Icon.astro';

export interface FaqItem {
  question: string;
  answer: string;
  display?: boolean;
}

export interface Props {
  faqs?: FaqItem[];
  items?: FaqItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs,
  items,
  title = 'Frequently Asked Questions',
  subtitle = 'Find straightforward answers to common questions about house removals, packing, and moving day.'
} = Astro.props;

const rawList = faqs || items || [];
// Filter out items with display: false
const visibleFaqs = rawList.filter((f) => f.display !== false);
---

{visibleFaqs.length > 0 && (
  <section class="py-16 bg-white dark:bg-slate-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
          Clear Answers
        </span>
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-1">
          {title}
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
          {subtitle}
        </p>
      </div>

      <div class="space-y-4">
        {visibleFaqs.map((faq, idx) => (
          <details
            class="group p-5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl transition-all open:bg-white dark:open:bg-slate-900 open:shadow-md"
            open={idx === 0}
          >
            <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-base text-slate-900 dark:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded-lg pr-2">
              <span>{faq.question}</span>
              <span class="text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0 ml-4">
                <Icon name="chevron-down" class="w-5 h-5 text-amber-600" />
              </span>
            </summary>
            <div class="mt-4 pt-3 border-t border-slate-200/60 dark:border-slate-800 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
