---
import { siteConfig } from 'src/data/site';
import navigation from 'src/data/navigation.json';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';

const currentPath = Astro.url.pathname;

let allLocations: Array<{ name: string; slug: string; county: string; href: string }> = [];
try {
  const locCollection = await getCollection('locations');
  allLocations = locCollection.map((l) => ({
    name: l.data.town,
    slug: l.data.slug,
    county: l.data.county,
    href: `/areas/${l.data.slug}/`
  })).sort((a, b) => a.name.localeCompare(b.name));
} catch (e) {
  allLocations = [];
}
---

<header
  id="site-header"
  class="sticky top-0 z-40 w-full transition-colors duration-200 backdrop-blur-md bg-white/90 dark:bg-slate-900/90 border-b border-slate-200/80 dark:border-slate-800/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Official Logo -->
      <a
        href="/"
        class="flex items-center focus-visible:ring-2 focus-visible:ring-amber-500 rounded-lg p-1 group shrink-0 transition-transform hover:scale-[1.02]"
        aria-label="Jimmys Removals & Logistics Home"
      >
        <img
          src="/images/logo.png"
          alt="Jimmys Removals & Logistics"
          width="185"
          height="50"
          class="h-11 sm:h-12 w-auto object-contain dark:hidden"
          loading="eager"
          decoding="async"
        />
        <img
          src="/images/logo-dark.png"
          alt="Jimmys Removals & Logistics"
          width="185"
          height="50"
          class="h-11 sm:h-12 w-auto object-contain hidden dark:block"
          loading="eager"
          decoding="async"
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navigation.mainNav.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href === '/removals/' && currentPath.startsWith('/removals/')) ||
            (item.href === '/areas/' && currentPath.startsWith('/areas/')) ||
            (item.items && item.items.some((sub: any) => currentPath === sub.href));

          return (
            <div class="relative group">
              <a
                href={item.href}
                class={`px-2.5 xl:px-3 py-2 text-sm font-semibold rounded-lg transition-colors flex items-center gap-1.5 ${
                  isActive
                    ? 'text-amber-600 dark:text-amber-400 bg-amber-50/70 dark:bg-amber-950/40'
                    : 'text-slate-700 dark:text-slate-200 hover:text-amber-600 dark:hover:text-amber-400 hover:bg-slate-100/70 dark:hover:bg-slate-800/60'
                }`}
              >
                {item.label}
                {(item.isMegaMenu || item.isDropdown) && (
                  <Icon name="chevron-down" class="w-3.5 h-3.5 opacity-60 group-hover:rotate-180 transition-transform duration-200" />
                )}
              </a>

              <!-- Services Mega Menu (Fixed Alignment & Modern Glassmorphism) -->
              {item.label === 'Services' && item.groups && (
                <div class="absolute left-0 top-full mt-2 w-[780px] max-w-[calc(100vw-2rem)] bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-slate-200/80 dark:border-slate-800/80 ring-1 ring-slate-900/5 dark:ring-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 overflow-hidden">
                  <!-- Header Banner -->
                  <div class="px-6 py-3.5 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-4 bg-slate-50/60 dark:bg-slate-800/40">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold">
                        <Icon name="truck" class="w-4 h-4" />
                      </div>
                      <div>
                        <div class="flex items-center gap-2">
                          <h3 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">
                            West Midlands Removals & Logistics
                          </h3>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/70 dark:text-amber-300">
                            10 Dedicated Services
                          </span>
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                          3.5-tonne Luton vans with tail lifts • Fully insured
                        </p>
                      </div>
                    </div>
                    <a
                      href="/services/"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-50 dark:bg-amber-950/50 hover:bg-amber-100 dark:hover:bg-amber-900/60 text-xs font-bold text-amber-700 dark:text-amber-300 transition shrink-0"
                    >
                      <span>All Services</span>
                      <Icon name="chevron-right" class="w-3.5 h-3.5" />
                    </a>
                  </div>

                  <!-- 3-Column Services Grid -->
                  <div class="p-6 grid grid-cols-3 gap-5 bg-white dark:bg-slate-900">
                    {item.groups.map((grp) => (
                      <div class="space-y-2.5">
                        <div class="flex items-center gap-1.5 pb-1 border-b border-slate-100 dark:border-slate-800/60">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                          <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                            {grp.title}
                          </h4>
                        </div>
                        <ul class="space-y-1.5">
                          {grp.items.map((sub) => (
                            <li>
                              <a
                                href={sub.href}
                                class="group/sub flex items-start gap-2.5 p-2 rounded-xl border border-transparent hover:border-slate-200/80 dark:hover:border-slate-700/80 hover:bg-slate-50/80 dark:hover:bg-slate-800/60 transition-all duration-150"
                              >
                                <div class="w-7 h-7 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center group-hover/sub:bg-amber-500 group-hover/sub:text-white group-hover/sub:scale-105 transition-all shrink-0 mt-0.5">
                                  <Icon name={sub.icon} class="w-3.5 h-3.5" />
                                </div>
                                <div class="min-w-0">
                                  <div class="text-xs font-bold text-slate-800 dark:text-slate-200 group-hover/sub:text-amber-600 dark:group-hover/sub:text-amber-400 transition truncate">
                                    {sub.label}
                                  </div>
                                  <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug line-clamp-1 mt-0.5">
                                    {sub.description}
                                  </p>
                                </div>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>

                  <!-- Bottom Footer Quick Links -->
                  <div class="px-6 py-3 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/80 dark:bg-slate-800/50 flex items-center justify-between">
                    <div class="flex items-center gap-4 text-xs text-slate-600 dark:text-slate-400">
                      <span class="flex items-center gap-1.5">
                        <Icon name="check" class="w-3.5 h-3.5 text-emerald-500" />
                        No Fuel Surcharges
                      </span>
                      <span class="hidden sm:flex items-center gap-1.5">
                        <Icon name="check" class="w-3.5 h-3.5 text-emerald-500" />
                        7-Day Flexible Booking
                      </span>
                    </div>
                    <div class="flex items-center gap-3">
                      <a
                        href="/moving-cost-calculator/"
                        class="text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400 transition"
                      >
                        Cost Calculator →
                      </a>
                      <a
                        href="/get-a-quote/"
                        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold shadow-sm transition"
                      >
                        <span>Get Free Quote</span>
                        <Icon name="chevron-right" class="w-3 h-3" />
                      </a>
                    </div>
                  </div>
                </div>
              )}

              <!-- Areas Mega Menu (Interactive & Modern) -->
              {item.label === 'Areas Covered' && (
                <div class="absolute left-1/2 -translate-x-1/2 lg:-left-28 xl:left-1/2 xl:-translate-x-1/2 top-full mt-2 w-[720px] max-w-[calc(100vw-2rem)] bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl rounded-2xl shadow-2xl border border-slate-200/80 dark:border-slate-800/80 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 overflow-hidden ring-1 ring-slate-900/5 dark:ring-white/10">
                  <!-- Header Banner -->
                  <div class="px-6 pt-5 pb-3 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-4">
                    <div>
                      <div class="flex items-center gap-2">
                        <h3 class="text-sm font-bold text-slate-900 dark:text-white">
                          West Midlands Service Area
                        </h3>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 dark:bg-amber-950/70 dark:text-amber-300">
                          37 Towns Covered
                        </span>
                      </div>
                      <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                        Local relocations, regional transport & UK-wide routes
                      </p>
                    </div>

                    <a
                      href="/areas/"
                      class="inline-flex items-center gap-1 text-xs font-bold text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 transition"
                    >
                      <span>Coverage Map</span>
                      <Icon name="chevron-right" class="w-3.5 h-3.5" />
                    </a>
                  </div>

                  <!-- Live Search Input -->
                  <div class="px-6 py-2.5 bg-slate-50/70 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-800/60">
                    <div class="relative">
                      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                      </div>
                      <input
                        type="text"
                        id="area-live-search-input"
                        placeholder="Type to find your town (e.g. Solihull, Harborne, Walsall)..."
                        autocomplete="off"
                        class="w-full pl-9 pr-8 py-2 text-xs sm:text-sm bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition text-slate-800 dark:text-slate-100"
                      />
                      <button
                        type="button"
                        id="area-search-clear-btn"
                        class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 text-sm font-bold"
                        aria-label="Clear town search"
                      >
                        ✕
                      </button>
                    </div>
                  </div>

                  <!-- Towns Display Area -->
                  <div class="p-6 max-h-[340px] overflow-y-auto">
                    <!-- Default Tier 1 Towns Grid -->
                    <div id="tier1-towns-container">
                      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3 flex items-center justify-between">
                        <span>Primary Hubs (Tier 1)</span>
                        <span class="text-slate-400 font-normal">Select a town for dedicated local crew</span>
                      </div>
                      <div class="grid grid-cols-3 gap-2">
                        {item.tier1Towns?.map((town: any) => (
                          <a
                            href={town.href}
                            class="group/town flex items-center justify-between p-2.5 rounded-xl border border-slate-100 dark:border-slate-800/80 bg-white/50 dark:bg-slate-800/30 hover:bg-amber-50/70 dark:hover:bg-amber-950/40 hover:border-amber-200 dark:hover:border-amber-800/60 transition-all duration-150"
                          >
                            <div class="flex items-center gap-2.5 min-w-0">
                              <div class="w-6 h-6 rounded-lg bg-amber-100 dark:bg-amber-950/80 flex items-center justify-center text-amber-600 dark:text-amber-400 group-hover/town:scale-110 group-hover/town:bg-amber-500 group-hover/town:text-white transition-all shrink-0">
                                <Icon name="map" class="w-3.5 h-3.5" />
                              </div>
                              <span class="text-sm font-semibold text-slate-800 dark:text-slate-200 group-hover/town:text-amber-600 dark:group-hover/town:text-amber-400 transition truncate">
                                {town.name}
                              </span>
                            </div>
                            <svg class="w-3.5 h-3.5 text-slate-300 dark:text-slate-600 group-hover/town:text-amber-500 group-hover/town:translate-x-0.5 transition-all shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                          </a>
                        ))}
                      </div>
                    </div>

                    <!-- Live Search Results Grid (Hidden by default, shown when searching) -->
                    <div id="search-results-container" class="hidden">
                      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3 flex items-center justify-between">
                        <span id="search-count-label">Search Results</span>
                        <span class="text-amber-600 dark:text-amber-400 text-xs">All West Midlands Towns</span>
                      </div>
                      <div id="search-results-grid" class="grid grid-cols-3 gap-2"></div>
                      <div id="search-empty-state" class="hidden text-center py-6 px-4">
                        <p class="text-sm text-slate-600 dark:text-slate-400">
                          No exact town match found for "<span id="search-query-text" class="font-semibold text-slate-800 dark:text-slate-200"></span>"
                        </p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                          Don't worry! We cover all surrounding villages, boroughs & nationwide UK relocations.
                        </p>
                        <a
                          href="/get-a-quote/"
                          class="inline-flex items-center gap-1 mt-3 px-4 py-1.5 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-lg shadow-sm transition"
                        >
                          Get a Quote for Your Area →
                        </a>
                      </div>
                    </div>
                  </div>

                  <!-- Bottom Feature Footer Strip -->
                  <div class="px-6 py-3 bg-slate-50/90 dark:bg-slate-900/90 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2 text-slate-600 dark:text-slate-300">
                      <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                      <span class="font-medium">3.5-tonne Luton vans with tail lifts · Directly employed crews</span>
                    </div>
                    <a
                      href="/areas/"
                      class="font-bold text-slate-700 dark:text-slate-200 hover:text-amber-600 dark:hover:text-amber-400 transition flex items-center gap-1"
                    >
                      View All 37 Towns
                      <Icon name="chevron-right" class="w-3 h-3" />
                    </a>
                  </div>
                </div>
              )}

              <!-- About Us & General Dropdown Menu -->
              {item.isDropdown && item.items && (
                <div class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-[520px] p-3 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 grid grid-cols-2 gap-1.5">
                  {item.items.map((sub: any) => (
                    <a
                      href={sub.href}
                      class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/80 transition group/sub"
                    >
                      <div class="p-2 rounded-lg bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 group-hover/sub:scale-110 transition-transform shrink-0 mt-0.5">
                        <Icon name={sub.icon} class="w-4 h-4" />
                      </div>
                      <div>
                        <div class="text-sm font-bold text-slate-900 dark:text-white group-hover/sub:text-amber-600 dark:group-hover/sub:text-amber-400 transition">
                          {sub.label}
                        </div>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 line-clamp-1">
                          {sub.description}
                        </p>
                      </div>
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <!-- CTA & Utility Buttons -->
      <div class="flex items-center gap-3">
        <!-- Phone Number Visible at All Breakpoints -->
        <a
          href={`tel:${siteConfig.phoneE164}`}
          class="flex items-center gap-2 text-slate-800 dark:text-slate-100 font-bold text-sm sm:text-base hover:text-amber-600 dark:hover:text-amber-400 transition"
          aria-label={`Call Jimmys Removals on ${siteConfig.phone}`}
        >
          <div class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-amber-600 dark:text-amber-400 shrink-0">
            <Icon name="phone" class="w-4 h-4" />
          </div>
          <span class="hidden sm:inline font-bold tracking-tight">{siteConfig.phone}</span>
        </a>


        <!-- Accent Get a Free Quote Button -->
        <a
          href="/get-a-quote/"
          class="hidden md:inline-flex items-center justify-center px-4 py-2.5 text-sm font-bold text-white bg-amber-600 hover:bg-amber-700 active:bg-amber-800 rounded-lg shadow-md hover:shadow-lg transition-all interactive-btn"
        >
          Get a Free Quote
        </a>

        <!-- Dark Mode Toggle -->
        <button
          id="theme-toggle-btn"
          type="button"
          class="w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition focus-visible:ring-2 focus-visible:ring-amber-500"
          aria-label="Toggle colour theme"
        >
          <span class="dark:hidden"><Icon name="moon" class="w-4 h-4" /></span>
          <span class="hidden dark:inline"><Icon name="sun" class="w-4 h-4" /></span>
        </button>

        <!-- Mobile Menu Trigger -->
        <button
          id="mobile-menu-trigger"
          type="button"
          class="lg:hidden w-10 h-10 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition focus-visible:ring-2 focus-visible:ring-amber-500"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          aria-label="Open navigation menu"
        >
          <span id="menu-icon-open"><Icon name="menu" class="w-6 h-6" /></span>
          <span id="menu-icon-close" class="hidden"><Icon name="close" class="w-6 h-6" /></span>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu Panel & Overlay -->
  <div
    id="mobile-nav-overlay"
    class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  ></div>

  <div
    id="mobile-nav-panel"
    class="fixed inset-y-0 right-0 w-full max-w-sm bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 shadow-2xl z-50 translate-x-full transition-transform duration-300 flex flex-col lg:hidden"
    aria-hidden="true"
    role="dialog"
    aria-label="Mobile Navigation"
  >
    <!-- Panel Header -->
    <div class="flex items-center justify-between p-4 border-b border-slate-200 dark:border-slate-800">
      <a href="/" class="flex items-center" aria-label="Jimmys Removals & Logistics Home">
        <img
          src="/images/logo.png"
          alt="Jimmys Removals & Logistics"
          width="135"
          height="36"
          class="h-9 w-auto object-contain dark:hidden"
        />
        <img
          src="/images/logo-dark.png"
          alt="Jimmys Removals & Logistics"
          width="135"
          height="36"
          class="h-9 w-auto object-contain hidden dark:block"
        />
      </a>
      <button
        id="mobile-menu-close"
        type="button"
        class="w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition focus-visible:ring-2 focus-visible:ring-amber-500"
        aria-label="Close navigation menu"
      >
        <Icon name="close" class="w-5 h-5" />
      </button>
    </div>

    <!-- Panel Links -->
    <nav class="flex-1 overflow-y-auto p-4 space-y-1">
      <a href="/" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800">
        Home
      </a>
      
      <!-- Services Group -->
      <a href="/services/" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800">
        Services
      </a>
      <div class="pl-4 border-l-2 border-amber-500/40 my-1 space-y-0.5">
        <a href="/services/house-removals/" class="mobile-nav-link block py-1 text-sm text-slate-600 dark:text-slate-300 hover:text-amber-600">House Removals</a>
        <a href="/services/flat-removals/" class="mobile-nav-link block py-1 text-sm text-slate-600 dark:text-slate-300 hover:text-amber-600">Flat & Apartment Removals</a>
        <a href="/services/man-and-van/" class="mobile-nav-link block py-1 text-sm text-slate-600 dark:text-slate-300 hover:text-amber-600">Man and Van</a>
        <a href="/services/packing-services/" class="mobile-nav-link block py-1 text-sm text-slate-600 dark:text-slate-300 hover:text-amber-600">Packing Services</a>
        <a href="/services/office-removals/" class="mobile-nav-link block py-1 text-sm text-slate-600 dark:text-slate-300 hover:text-amber-600">Office Removals</a>
        <a href="/services/storage/" class="mobile-nav-link block py-1 text-sm text-slate-600 dark:text-slate-300 hover:text-amber-600">Storage Solutions</a>
      </div>

      <!-- Areas -->
      <a href="/areas/" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800">
        Areas Covered
      </a>

      <!-- Pricing & Calculator -->
      <a href="/prices/" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800">
        Prices
      </a>
      <a href="/moving-cost-calculator/" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800">
        Calculator
      </a>

      <!-- About Us Group -->
      <a href="/about-us/" class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-semibold text-slate-800 dark:text-slate-100 hover:bg-slate-100 dark:hover:bg-slate-800">
        About Us
      </a>
      <div class="pl-4 border-l-2 border-amber-500/40 my-1 space-y-0.5">
