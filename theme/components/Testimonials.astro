---
import Icon from './Icon.astro';
import { formatDate } from 'theme/utils/formatDate';
import { siteConfig } from 'src/data/site';

const gbpUrl = (siteConfig.googleBusinessProfileUrl && siteConfig.googleBusinessProfileUrl !== '#')
  ? siteConfig.googleBusinessProfileUrl
  : '/reviews/';

export interface TestimonialItem {
  name: string;
  town: string;
  service: string;
  rating: number;
  date: string;
  body: string;
  source: string;
  verified: boolean;
  reviewCount?: string;
  relativeTime?: string;
  isNew?: boolean;
  authorUrl?: string;
  pricePaid?: string;
  ownerResponse?: {
    date?: string;
    body: string;
  };
}

export interface Props {
  testimonials?: TestimonialItem[];
  title?: string;
  subtitle?: string;
  showFilters?: boolean;
}

const {
  testimonials = [],
  title = 'Verified Customer Reviews',
  subtitle = 'Genuine 5-star feedback from verified moves across Birmingham and the West Midlands.',
  showFilters = true
} = Astro.props;

// Filter for strictly verified reviews only
const verifiedList = testimonials.filter((t) => t.verified === true);

// Google avatar color palette (based on typical Google Material design)
const avatarBgClasses = [
  'bg-blue-600',
  'bg-emerald-600',
  'bg-purple-600',
  'bg-amber-600',
  'bg-rose-600',
  'bg-teal-600',
  'bg-indigo-600',
  'bg-cyan-600'
];

function getAvatarClass(name: string): string {
  if (!name) return 'bg-amber-600';
  const code = name.charCodeAt(0) + (name.length > 1 ? name.charCodeAt(1) : 0);
  return avatarBgClasses[code % avatarBgClasses.length];
}

const totalReviews = verifiedList.length;
const averageRating = (
  verifiedList.reduce((acc, curr) => acc + (curr.rating || 5), 0) / (totalReviews || 1)
).toFixed(1);
---

{verifiedList.length > 0 && (
  <section class="py-16 bg-slate-50 dark:bg-slate-900/40 border-t border-slate-200 dark:border-slate-800" id="google-reviews-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header with Google Summary Score Box -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm text-xs font-semibold text-slate-700 dark:text-slate-200 mb-3">
            <Icon name="google" class="w-4 h-4" />
            <span>Google Customer Reviews</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            {title}
          </h2>
          <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
            {subtitle}
          </p>
        </div>

        <!-- Google Score Card -->
        <div class="bg-white dark:bg-slate-900 p-4 sm:p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex items-center gap-5 shrink-0">
          <div class="w-12 h-12 rounded-xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center shrink-0 border border-slate-100 dark:border-slate-700">
            <Icon name="google" class="w-7 h-7" />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-2xl font-extrabold text-slate-900 dark:text-white leading-none">
                {averageRating}
              </span>
              <div class="flex items-center text-amber-400">
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" class="w-4 h-4 fill-amber-400 text-amber-400" />
                ))}
              </div>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
              Based on <strong class="text-slate-800 dark:text-slate-200 font-semibold">{totalReviews} verified reviews</strong>
            </p>
          </div>
          <a
            href={gbpUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-amber-500 hover:text-slate-950 text-slate-800 dark:text-slate-200 transition ml-2 border border-slate-200 dark:border-slate-700"
          >
            <span>View on Google</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>

      <!-- Google Review Style Sort & Filter Bar -->
      {showFilters && (
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div class="flex items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400">
            <span class="font-bold text-slate-700 dark:text-slate-300">Sort by:</span>
            <div class="inline-flex p-1 rounded-xl bg-slate-200/70 dark:bg-slate-800/80 border border-slate-300/60 dark:border-slate-700" role="tablist">
              <button
                type="button"
                class="review-sort-btn px-3 py-1 rounded-lg text-xs font-bold transition-all bg-white dark:bg-slate-900 text-slate-900 dark:text-white shadow-sm"
                data-sort="relevant"
              >
                Most relevant
              </button>
              <button
                type="button"
                class="review-sort-btn px-3 py-1 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all"
                data-sort="newest"
              >
                Newest
              </button>
              <button
                type="button"
                class="review-sort-btn px-3 py-1 rounded-lg text-xs font-semibold text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all"
                data-sort="highest"
              >
                Highest
              </button>
            </div>
          </div>

          <div class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>100% verified on Google Business Profile</span>
          </div>
        </div>
      )}

      <!-- Reviews Cards Grid (Authentic Google Review UI) -->
      <div id="reviews-cards-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {verifiedList.map((rev, idx) => {
          const initial = (rev.name || 'J').trim().charAt(0).toUpperCase();
          const avatarColor = getAvatarClass(rev.name);
          return (
            <div
              class="review-card p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/90 dark:border-slate-800 shadow-sm hover:shadow-md transition-all flex flex-col justify-between"
              data-date={rev.date}
              data-rating={rev.rating}
              data-index={idx}
            >
              <div>
                <!-- Top Reviewer Row -->
                <div class="flex items-start justify-between gap-3 mb-3">
                  <div class="flex items-center gap-3">
                    <!-- Google Profile Avatar with Initial -->
                    <div class={`w-10 h-10 rounded-full ${avatarColor} text-white font-bold text-base flex items-center justify-center shrink-0 shadow-sm select-none`}>
                      {initial}
                    </div>

                    <!-- Name & Subtext -->
                    <div>
                      {rev.authorUrl ? (
                        <a
                          href={rev.authorUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-bold text-sm text-slate-900 dark:text-white hover:text-amber-600 dark:hover:text-amber-400 transition flex items-center gap-1"
                        >
                          <span>{rev.name}</span>
                          <svg class="w-3 h-3 text-slate-400 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                        </a>
                      ) : (
                        <span class="font-bold text-sm text-slate-900 dark:text-white block">
                          {rev.name}
                        </span>
                      )}
                      <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-tight">
                        {rev.reviewCount || '1 review'} · {rev.town}
                      </p>
                    </div>
                  </div>

                  <!-- Google 'G' Watermark Logo -->
                  <div class="p-1 rounded-lg bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700/60 shrink-0" title="Verified Google Review">
                    <Icon name="google" class="w-4 h-4" />
                  </div>
                </div>

                <!-- Stars, Relative Date & New Pill -->
                <div class="flex items-center gap-2 mb-2 flex-wrap">
                  <div class="flex items-center text-amber-400">
                    {Array.from({ length: rev.rating }).map(() => (
                      <Icon name="star" class="w-3.5 h-3.5 fill-amber-400 text-amber-400" />
                    ))}
                  </div>

                  <span class="text-xs text-slate-500 dark:text-slate-400">
                    {rev.relativeTime || formatDate(rev.date)}
                  </span>

                  {rev.isNew && (
                    <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-100 text-amber-900 dark:bg-amber-950/80 dark:text-amber-300">
                      NEW
                    </span>
                  )}
                </div>

                <!-- Optional Price Paid Pill -->
                {rev.pricePaid && (
                  <div class="mb-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 text-[11px] font-medium text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700">
                    <span class="text-amber-600 dark:text-amber-400">🏷️</span>
                    <span>{rev.pricePaid}</span>
                  </div>
                )}

                <!-- Review Text -->
                <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-200 leading-relaxed mb-4">
                  "{rev.body}"
                </p>

                <!-- Official Owner Response (Google Maps Style) -->
                {rev.ownerResponse && (
                  <div class="mt-3 pt-3 pl-3.5 border-l-2 border-amber-500 bg-slate-50 dark:bg-slate-800/60 rounded-r-xl p-3">
                    <div class="flex items-center justify-between text-xs font-bold text-slate-900 dark:text-white mb-1">
                      <span class="flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        <span>Jimmys Removals and Logistics LTD (owner)</span>
                      </span>
                      {rev.ownerResponse.date && (
                        <span class="text-[10px] text-slate-400 font-normal">{rev.ownerResponse.date}</span>
                      )}
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-300 italic leading-snug">
                      "{rev.ownerResponse.body}"
                    </p>
                  </div>
                )}
              </div>

              <!-- Footer Verification Strip -->
              <div class="pt-3 mt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
                  {rev.service}
                </span>

                <a
                  href={rev.authorUrl || gbpUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
                >
                  <Icon name="check" class="w-3.5 h-3.5 text-emerald-500" />
                  <span>Google Verified</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Action Footer -->
      <div class="text-center mt-12 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={gbpUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm shadow-md transition"
        >
          <Icon name="google" class="w-4 h-4 text-white" />
          <span>Read All Customer Reviews on Google</span>
          <Icon name="chevron-right" class="w-4 h-4 text-white" />
        </a>

        <a
          href="/get-a-quote/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 font-bold text-sm hover:border-amber-500 transition shadow-sm"
        >
          <span>Get Your Guaranteed Move Quote</span>
        </a>
      </div>
    </div>
  </section>
)}

<script is:inline>
  (function() {
    const container = document.getElementById('reviews-cards-container');
    const sortButtons = document.querySelectorAll('.review-sort-btn');
    if (!container || !sortButtons.length) return;

    sortButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle active classes
        sortButtons.forEach(b => {
          b.classList.remove('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'shadow-sm', 'font-bold');
          b.classList.add('text-slate-600', 'dark:text-slate-400', 'font-semibold');
        });
        btn.classList.add('bg-white', 'dark:bg-slate-900', 'text-slate-900', 'dark:text-white', 'shadow-sm', 'font-bold');
        btn.classList.remove('text-slate-600', 'dark:text-slate-400', 'font-semibold');

        const sortType = btn.getAttribute('data-sort');
        const cards = Array.from(container.querySelectorAll('.review-card'));

        cards.sort((a, b) => {
          if (sortType === 'newest') {
            const dateA = new Date(a.getAttribute('data-date') || 0).getTime();
            const dateB = new Date(b.getAttribute('data-date') || 0).getTime();
            return dateB - dateA;
          } else if (sortType === 'highest') {
            const ratingA = Number(a.getAttribute('data-rating') || 5);
            const ratingB = Number(b.getAttribute('data-rating') || 5);
            return ratingB - ratingA;
          } else {
            // relevant (original order)
            const idxA = Number(a.getAttribute('data-index') || 0);
            const idxB = Number(b.getAttribute('data-index') || 0);
            return idxA - idxB;
          }
        });

        // Re-append in sorted order
        cards.forEach(card => container.appendChild(card));
      });
    });
  })();
</script>
