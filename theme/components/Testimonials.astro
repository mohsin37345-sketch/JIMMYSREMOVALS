---
import Icon from './Icon.astro';
import { formatDate } from 'theme/utils/formatDate';

export interface TestimonialItem {
  name: string;
  town: string;
  service: string;
  rating: number;
  date: string;
  body: string;
  source: string;
  verified: boolean;
}

export interface Props {
  testimonials?: TestimonialItem[];
  title?: string;
  subtitle?: string;
}

const {
  testimonials = [],
  title = 'Verified Customer Reviews',
  subtitle = 'Genuine feedback from homeowners and businesses who trusted Jimmys Removals across the West Midlands.'
} = Astro.props;

// Filter for strictly verified reviews only
const verifiedList = testimonials.filter((t) => t.verified === true);
---

{verifiedList.length > 0 && (
  <section class="py-16 bg-slate-50 dark:bg-slate-900/40 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
          Independent Feedback
        </span>
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-1">
          {title}
        </h2>
        <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
          {subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {verifiedList.map((rev) => (
          <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div>
              <!-- Star rating -->
              <div class="flex items-center gap-1 text-amber-400 mb-3">
                {Array.from({ length: rev.rating }).map(() => (
                  <Icon name="star" class="w-4 h-4" />
                ))}
              </div>

              <!-- Review Body -->
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 italic leading-relaxed mb-6">
                "{rev.body}"
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
              <div>
                <span class="font-bold text-slate-900 dark:text-white block">
                  {rev.name}
                </span>
                <span class="text-slate-400 text-[11px]">
                  {rev.town} · {rev.service}
                </span>
              </div>
              <div class="text-right">
                <a
                  href="{{GOOGLE_BUSINESS_PROFILE_URL}}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-amber-600 dark:text-amber-400 font-semibold block text-[11px] hover:underline flex items-center gap-1 justify-end"
                >
                  <Icon name="check" class="w-3 h-3 text-emerald-500" />
                  <span>Google Review</span>
                </a>
                <time datetime={rev.date} class="text-slate-400 text-[10px]">
                  {formatDate(rev.date)}
                </time>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="{{GOOGLE_BUSINESS_PROFILE_URL}}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-xs font-bold text-slate-800 dark:text-slate-200 hover:border-amber-500 transition shadow-sm"
        >
          <span>View Verified Google Business Profile Reviews</span>
          <Icon name="chevron-right" class="w-3.5 h-3.5 text-amber-500" />
        </a>
      </div>
    </div>
  </section>
)}
