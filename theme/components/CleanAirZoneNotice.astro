---
import Icon from './Icon.astro';

export interface Props {
  enabled?: boolean;
  variant?: 'compact' | 'full';
  note?: string;
  town?: string;
}

const {
  enabled = true,
  variant = 'compact',
  note = "Our entire fleet is 100% compliant with the Birmingham Clean Air Zone inside the A4540 Middleway ring road. You will never pay CAZ penalty surcharges on your invoice.",
  town = "Birmingham"
} = Astro.props;
---

{enabled && (
  <aside aria-label="Clean Air Zone Notice" class={`rounded-2xl border ${
    variant === 'full' 
      ? 'p-6 sm:p-8 bg-emerald-50 dark:bg-emerald-950/50 border-emerald-300 dark:border-emerald-800' 
      : 'p-5 bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-800 my-6'
  } flex items-start gap-4`}>
    <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center shrink-0">
      <Icon name="truck" class="w-5 h-5" />
    </div>
    <div class="space-y-1 flex-1">
      <div class="flex items-center gap-2 flex-wrap">
        <h3 class="text-sm font-bold text-emerald-900 dark:text-emerald-200">
          {town} Clean Air Zone (CAZ) Exemption Notice
        </h3>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-200 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200">
          Zero Surcharge
        </span>
      </div>
      <p class="text-xs text-emerald-800 dark:text-emerald-300 leading-relaxed">
        {note}
      </p>
      <div class="pt-1">
        <a
          href="/clean-air-zone/"
          class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 underline hover:text-emerald-900 dark:hover:text-emerald-200"
        >
          Read our Birmingham Clean Air Zone Removals Guide &rarr;
        </a>
      </div>
    </div>
  </aside>
)}
