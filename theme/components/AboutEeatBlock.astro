---
import Icon from './Icon.astro';
import { siteConfig } from 'src/data/site';

const legalDetails = [
  {
    label: 'Registered Company Name',
    value: siteConfig.legalName,
    icon: 'briefcase',
    detail: 'Private Limited Company registered in England & Wales'
  },
  {
    label: 'Companies House Registration',
    value: siteConfig.companyNumber,
    icon: 'shield',
    detail: 'Official UK registrar of companies verifiable registration'
  },
  {
    label: 'VAT Registration Number',
    value: siteConfig.vatNumber,
    icon: 'coins',
    detail: 'HMRC Value Added Tax registered commercial operator'
  },
  {
    label: 'Environment Agency Waste Carrier Licence',
    value: siteConfig.wasteCarrierLicence,
    icon: 'check',
    detail: 'Upper Tier Carrier Licence legally required for UK house clearance'
  },
  {
    label: 'Commercial Insurance Underwriter',
    value: siteConfig.insuranceUnderwriter,
    icon: 'shield-check',
    detail: '£50,000 Goods in Transit & £2,000,000 Public Liability underwritten'
  },
  {
    label: 'Year Established',
    value: siteConfig.foundedYear,
    icon: 'clock',
    detail: 'Continuous professional removals and logistics operations'
  },
  {
    label: 'Operating Hours',
    value: siteConfig.openingHoursDisplay,
    icon: 'clock',
    detail: 'Active removals crews operating 7 days a week across the West Midlands'
  },
  {
    label: 'Depot & Operations Base',
    value: siteConfig.address.fullAddress,
    icon: 'map-pin',
    detail: 'Centrally located with direct arterial links to M6, M5, M42 and A38(M)'
  }
];
---

<section id="about-us" class="py-16 sm:py-20 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header & H2 -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
        <Icon name="shield-check" class="w-4 h-4" />
        <span>Verified E-E-A-T Corporate Details</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        About Jimmys Removals and Logistics LTD
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
        We believe transparency is the foundation of trust. Below are our verified statutory registrations, insurance policies, licensing credentials, and depot base location.
      </p>
    </div>

    <!-- 2-Column: Left Credentials Grid, Right Map Embed & Directions -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Statutory Credentials Grid (7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {legalDetails.map((item) => (
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
            <div class="flex items-center gap-2 text-xs font-bold text-amber-600 dark:text-amber-400">
              <Icon name={item.icon} class="w-4 h-4 shrink-0" />
              <span>{item.label}</span>
            </div>
            <div class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white font-mono break-words">
              {item.value}
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">
              {item.detail}
            </p>
          </div>
        ))}
      </div>

      <!-- Right Column: Depot Location, Directions & Map Embed (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="p-6 sm:p-7 rounded-3xl bg-slate-900 text-white border border-slate-800 shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Depot Hub</span>
            <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Strategic West Midlands Base
            </span>
          </div>

          <h3 class="text-lg font-bold text-white">
            Phoenix Business Park, Birmingham
          </h3>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Our central Birmingham operations base allows our 3.5-tonne Luton fleet rapid dispatch to all 37 West Midlands towns. We are located within minutes of the A38(M) Aston Expressway, M6 Junction 6 (Spaghetti Junction), and the M5 and M42 orbital corridors.
          </p>

          <div class="pt-2 border-t border-slate-800 space-y-2 text-xs text-slate-300">
            <div class="flex items-center gap-2">
              <Icon name="phone" class="w-4 h-4 text-amber-400 shrink-0" />
              <a href={`tel:${siteConfig.phoneE164}`} class="font-bold hover:text-amber-300 transition">{siteConfig.phone}</a>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="mail" class="w-4 h-4 text-amber-400 shrink-0" />
              <span>{siteConfig.email}</span>
            </div>
            <div class="flex items-center gap-2">
              <Icon name="clock" class="w-4 h-4 text-amber-400 shrink-0" />
              <span>Operating Hours: {siteConfig.openingHoursDisplay}</span>
            </div>
          </div>

          <!-- Lazy-loaded Map Embed Container -->
          <div class="relative aspect-[16/10] rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 mt-4">
            <div id="depot-map-placeholder" class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center bg-slate-950">
              <Icon name="map-pin" class="w-8 h-8 text-amber-500 mb-2" />
              <span class="text-xs font-bold text-white">Phoenix Business Park Depot</span>
              <span class="text-[11px] text-slate-400 mt-0.5">Coordinates: {siteConfig.geo.latitude}, {siteConfig.geo.longitude}</span>
              <button
                type="button"
                id="load-depot-map-btn"
                class="mt-3 px-4 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold transition shadow"
              >
                Load Interactive Map
              </button>
            </div>
            <div id="depot-map-frame" class="w-full h-full hidden">
              <iframe
                title="Jimmys Removals Phoenix Business Park Depot Location"
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                allowfullscreen=""
                referrerpolicy="no-referrer-when-downgrade"
                src="https://maps.google.com/maps?q=Phoenix+Business+Park+Birmingham&t=&z=13&ie=UTF8&iwloc=&output=embed"
              ></iframe>
            </div>
          </div>

          <div class="pt-2 text-center">
            <a
              href={siteConfig.googleBusinessProfileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-amber-400 hover:text-amber-300 transition"
            >
              <span>Get Driving Directions on Google Maps</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  (function() {
    const btn = document.getElementById('load-depot-map-btn');
    const placeholder = document.getElementById('depot-map-placeholder');
    const frame = document.getElementById('depot-map-frame');
    if (btn && placeholder && frame) {
      btn.addEventListener('click', () => {
        placeholder.classList.add('hidden');
        frame.classList.remove('hidden');
      });
    }
  })();
</script>
