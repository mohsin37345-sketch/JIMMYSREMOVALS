---
import Icon from './Icon.astro';
import { siteConfig } from 'src/data/site';

const legalDetails = [
  {
    label: 'Registered Company Name',
    value: 'Jimmys Logistics and Removals Limited',
    subValue: '(trading as Jimmys Removals and Logistics)',
    icon: 'briefcase',
    detail: 'Private Limited Company registered in England & Wales'
  },
  {
    label: 'Companies House Registration',
    value: '16876169',
    icon: 'shield-check',
    detail: 'Verify us on the official UK register of companies',
    link: 'https://find-and-update.company-information.service.gov.uk/company/16876169'
  },
  {
    label: 'Registered Office',
    value: '66 Beaufort Avenue, Birmingham, England, B34 6AE',
    icon: 'building',
    detail: 'Official registered corporate address in Birmingham'
  },
  {
    label: 'Insurance Status',
    value: 'Fully insured',
    icon: 'shield',
    detail: 'Full insurance protection for domestic and commercial relocations'
  },
  {
    label: 'Operating Hours',
    value: 'Open 24 hours, 7 days a week',
    icon: 'clock',
    detail: 'Removals and deliveries arranged day or night across the West Midlands'
  },
  {
    label: 'Same Day Delivery',
    value: 'Urgent Same Day Service',
    icon: 'truck',
    detail: 'Urgent same day delivery and man and van service across Birmingham and all 37 West Midlands towns, subject to availability'
  }
];
---

<section id="about-us" class="py-16 sm:py-20 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header & H2 -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
        <Icon name="shield-check" class="w-4 h-4" />
        <span>Verified Corporate Transparency</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        About Jimmys Removals and Logistics
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
        We believe transparency is the foundation of trust. Below are our verified company registration, operating hours and base location.
      </p>
    </div>

    <!-- 2-Column: Left Verified Details Grid, Right Depot & Map Embed -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Left Column: Verified Details Grid (7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {legalDetails.map((item) => (
          <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-2 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs font-bold text-amber-600 dark:text-amber-400 mb-1">
                <Icon name={item.icon} class="w-4 h-4 shrink-0" />
                <span>{item.label}</span>
              </div>
              <div class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white break-words">
                {item.value}
              </div>
              {item.subValue && (
                <div class="text-xs text-slate-600 dark:text-slate-300 font-medium mt-0.5">
                  {item.subValue}
                </div>
              )}
            </div>

            <div class="pt-2 border-t border-slate-200/60 dark:border-slate-800/80">
              {item.link ? (
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400 hover:underline"
                >
                  <span>{item.detail}</span>
                  <Icon name="chevron-right" class="w-3.5 h-3.5" />
                </a>
              ) : (
                <p class="text-[11px] text-slate-500 dark:text-slate-400 leading-snug">
                  {item.detail}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column: Birmingham Operations Base & Map Embed (5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="p-6 sm:p-7 rounded-3xl bg-slate-900 text-white border border-slate-800 shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Operations Hub</span>
            <span class="text-xs font-semibold text-emerald-400 flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Strategic West Midlands Base
            </span>
          </div>

          <h3 class="text-xl font-black text-white">
            Birmingham Operations Base
          </h3>

          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Based in east Birmingham, our 3.5-tonne Luton fleet can reach all 37 West Midlands towns quickly, with fast access to the M6, M42, M5 and A38(M).
          </p>

          <div class="pt-3 border-t border-slate-800 space-y-2.5 text-xs text-slate-300">
            <div class="flex items-center gap-2.5">
              <Icon name="map-pin" class="w-4 h-4 text-amber-400 shrink-0" />
              <span>{siteConfig.address.fullAddress}</span>
            </div>
            <div class="flex items-center gap-2.5">
              <Icon name="phone" class="w-4 h-4 text-amber-400 shrink-0" />
              <a href={`tel:${siteConfig.phoneE164}`} class="font-bold text-amber-300 hover:underline">
                {siteConfig.phone}
              </a>
            </div>
            <div class="flex items-center gap-2.5">
              <Icon name="mail" class="w-4 h-4 text-amber-400 shrink-0" />
              <a href={`mailto:${siteConfig.email}`} class="hover:underline text-slate-200">
                {siteConfig.email}
              </a>
            </div>
            <div class="flex items-center gap-2.5">
              <Icon name="clock" class="w-4 h-4 text-amber-400 shrink-0" />
              <span>{siteConfig.openingHoursDisplay}</span>
            </div>
          </div>

          <!-- Map Embed Container -->
          <div class="relative aspect-[16/10] rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 mt-4">
            <div id="depot-map-placeholder" class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center bg-slate-950">
              <Icon name="map-pin" class="w-8 h-8 text-amber-500 mb-2" />
              <span class="text-xs font-bold text-white">East Birmingham Operations Base</span>
              <span class="text-[11px] text-slate-400 mt-0.5">{siteConfig.address.fullAddress}</span>
              <button
                type="button"
                id="load-depot-map-btn"
                class="mt-3 px-4 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold transition shadow"
              >
                Load Interactive Map
              </button>
            </div>
            <div id="depot-map-frame" class="w-full h-full hidden">
              <iframe
                title="Jimmys Removals Birmingham Operations Base"
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                allowfullscreen=""
                referrerpolicy="no-referrer-when-downgrade"
                src="https://maps.google.com/maps?q=66+Beaufort+Avenue+Birmingham+B34+6AE&t=&z=14&ie=UTF8&iwloc=&output=embed"
              ></iframe>
            </div>
          </div>

          <div class="pt-2 text-center">
            <a
              href="https://find-and-update.company-information.service.gov.uk/company/16876169"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-amber-400 hover:text-amber-300 font-semibold"
            >
              <Icon name="shield-check" class="w-3.5 h-3.5" />
              <span>Verify Jimmys Logistics and Removals Limited on Companies House</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  function initDepotMap() {
    const btn = document.getElementById('load-depot-map-btn');
    const placeholder = document.getElementById('depot-map-placeholder');
    const frame = document.getElementById('depot-map-frame');

    if (btn && placeholder && frame) {
      btn.addEventListener('click', () => {
        placeholder.classList.add('hidden');
        frame.classList.remove('hidden');
      });
    }
  }

  initDepotMap();
  document.addEventListener('astro:page-load', initDepotMap);
</script>
