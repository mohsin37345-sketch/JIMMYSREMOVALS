---
import Icon from './Icon.astro';

export interface Props {
  headingTag?: 'h2' | 'h3' | 'h4' | 'div';
}

const { headingTag = 'div' } = Astro.props;
const HeadingComponent = headingTag;
---

<div id="cost-calculator-island" class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl p-6 sm:p-8">
  <div class="mb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-bold uppercase tracking-wider mb-2">
      Interactive Estimator
    </div>
    <HeadingComponent class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Estimate Your Moving Costs</HeadingComponent>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-2xl">
      Adjust property size, transit distance, and optional services to calculate your estimated removal price range across Birmingham and the West Midlands.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Controls (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- 1. Property Size -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
          Property Size & Volume
        </label>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {[
            { id: '1bed', label: '1 Bed Flat', base: 280, volume: '400 cu ft', vans: '1 Luton Van', crew: '2 Porters' },
            { id: '2bed', label: '2 Bed House', base: 390, volume: '650 cu ft', vans: '1 Luton Van', crew: '2 Porters' },
            { id: '3bed', label: '3 Bed House', base: 560, volume: '950 cu ft', vans: '1-2 Luton Vans', crew: '3 Porters' },
            { id: '4bed', label: '4 Bed House', base: 780, volume: '1,400 cu ft', vans: '2 Luton Vans', crew: '3-4 Porters' },
            { id: '5bed', label: '5+ Bed House', base: 1050, volume: '2,000+ cu ft', vans: '2-3 Luton Vans', crew: '4 Porters' }
          ].map((item, idx) => (
            <label class="border border-slate-200 dark:border-slate-700 rounded-xl p-3 cursor-pointer text-center hover:border-amber-500 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50/50 dark:has-[:checked]:bg-amber-950/30 transition">
              <input
                type="radio"
                name="calc_property"
                value={item.base}
                data-id={item.id}
                data-volume={item.volume}
                data-vans={item.vans}
                data-crew={item.crew}
                class="sr-only calc-input"
                checked={idx === 1}
              />
              <span class="text-xs font-bold block text-slate-900 dark:text-white">{item.label}</span>
              <span class="text-[10px] text-slate-400 block mt-0.5">{item.volume}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- 2. Distance Slider -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label for="calc-distance" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            Estimated Transit Distance
          </label>
          <span id="calc-distance-val" class="text-sm font-extrabold text-amber-600 dark:text-amber-400">
            10 miles
          </span>
        </div>
        <input
          type="range"
          id="calc-distance"
          min="1"
          max="150"
          value="10"
          class="w-full accent-amber-600 cursor-pointer"
        />
        <div class="flex justify-between text-[11px] text-slate-400 mt-1">
          <span>Local (1 mi)</span>
          <span>50 mi</span>
          <span>100 mi</span>
          <span>Long Distance (150 mi)</span>
        </div>
      </div>

      <!-- 3. Packing Services -->
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-2">
          Packing Services
        </label>
        <div class="space-y-2">
          {[
            { label: 'Self-Packing (Materials only)', cost: 0, desc: 'You box personal possessions prior to move day' },
            { label: 'Fragile-Only Packing (+£150)', cost: 150, desc: 'We pack china, glassware, framed artwork and mirrors' },
            { label: 'Full Home Packing Service (+£300)', cost: 300, desc: 'Comprehensive room-by-room packing with all boxes & tape included' }
          ].map((pack, idx) => (
            <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/40 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50/30 dark:has-[:checked]:bg-amber-950/20">
              <input type="radio" name="calc_packing" value={pack.cost} class="mt-1 calc-input text-amber-600" checked={idx === 0} />
              <div>
                <div class="text-xs font-bold text-slate-800 dark:text-slate-200">{pack.label}</div>
                <div class="text-[11px] text-slate-500 dark:text-slate-400">{pack.desc}</div>
              </div>
            </label>
          ))}
        </div>
      </div>

      <!-- 4. Optional Add-ons & Fixed Protection Flag -->
      <div class="space-y-3">
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
          Specialist Items & Route Considerations
        </label>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/40 has-[:checked]:border-amber-500">
            <input type="checkbox" id="calc-dismantle" value="80" class="calc-input text-amber-600 rounded" />
            <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">Furniture Dismantling (+£80)</span>
          </label>
          
          <label class="flex items-center gap-2.5 p-3 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/40 has-[:checked]:border-amber-500">
            <input type="checkbox" id="calc-piano" value="175" class="calc-input text-amber-600 rounded" />
            <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">Upright Piano (+£175)</span>
          </label>
        </div>

        <!-- Guaranteed Fixed Quote Flag -->
        <div class="flex items-start gap-3 p-3.5 rounded-xl border border-emerald-200 dark:border-emerald-800/60 bg-emerald-50/50 dark:bg-emerald-950/20">
          <div class="mt-0.5 text-emerald-600 dark:text-emerald-400">
            <Icon name="shield-check" class="w-4 h-4" />
          </div>
          <div>
            <span class="text-xs font-bold text-emerald-900 dark:text-emerald-200 flex items-center gap-1.5">
              <span>Guaranteed Fixed Quote Protection</span>
            </span>
            <p class="text-[11px] text-emerald-800 dark:text-emerald-300 mt-0.5">
              Your written quote includes all fuel, transit, and handling equipment with zero hidden surcharges on moving day.
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- Output Estimate Card (5 cols) -->
    <div class="lg:col-span-5 flex flex-col justify-between p-6 sm:p-8 bg-slate-50 dark:bg-slate-800/80 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
      <div class="space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Estimated Price Range</span>
          <div class="flex items-baseline gap-2 mt-1">
            <span id="calc-result-min" class="text-3xl sm:text-4xl font-extrabold text-amber-600 dark:text-amber-400">
              £390
            </span>
            <span class="text-slate-400 text-lg font-bold">to</span>
            <span id="calc-result-max" class="text-3xl sm:text-4xl font-extrabold text-amber-600 dark:text-amber-400">
              £470
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            Includes VAT, full insurance cover & guaranteed fixed quote.
          </p>
        </div>

        <!-- Volume, Vehicles & Crew Breakdown -->
        <div class="border-t border-slate-200 dark:border-slate-700 pt-4 space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
              <Icon name="box" class="w-4 h-4 text-amber-500" />
              Estimated Volume:
            </span>
            <span id="calc-volume-val" class="font-bold text-slate-800 dark:text-slate-200">
              650 cu ft
            </span>
          </div>

          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
              <Icon name="truck" class="w-4 h-4 text-amber-500" />
              Recommended Fleet:
            </span>
            <span id="calc-vans-val" class="font-bold text-slate-800 dark:text-slate-200">
              1 Luton Van
            </span>
          </div>

          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
              <Icon name="shield" class="w-4 h-4 text-amber-500" />
              Recommended Crew:
            </span>
            <span id="calc-crew-val" class="font-bold text-slate-800 dark:text-slate-200">
              2 Porters
            </span>
          </div>

          <div class="flex items-center justify-between text-xs">
            <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
              <Icon name="check" class="w-4 h-4 text-emerald-500" />
              Insurance Protection:
            </span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400">
              Fully Insured
            </span>
          </div>
        </div>

        <!-- Prominent Non-Binding Disclaimer -->
        <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-slate-700 dark:text-slate-300 leading-relaxed">
          <strong>Important Note:</strong> This estimator outputs a realistic price range based on typical home volumes. A firm, guaranteed quote requires a free survey (video or in-person) with zero obligation.
        </div>
      </div>

      <div class="pt-6">
        <a
          id="calc-cta-btn"
          href="/get-a-quote/?size=2bed&dist=10"
          class="w-full py-3.5 px-4 bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm rounded-xl shadow-lg transition-all interactive-btn flex items-center justify-center gap-2"
        >
          <span>Lock In This Quote Range</span>
          <Icon name="chevron-right" class="w-4 h-4" />
        </a>
        <p class="text-[11px] text-slate-400 text-center mt-2">
          Takes only 60 seconds to pre-fill your formal quote request.
        </p>

        <!-- Direct Email Calculation Form -->
        <div class="mt-5 pt-4 border-t border-slate-200 dark:border-slate-700/80">
          <form id="calc-direct-email-form" class="space-y-2.5">
            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
              <Icon name="box" class="w-3.5 h-3.5 text-amber-500" />
              <span>Or email this estimate to your inbox & Jimmys:</span>
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              <input
                type="text"
                id="calc-user-name"
                name="name"
                required
                placeholder="Your Name"
                class="w-full px-3 py-2 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500"
              />
              <input
                type="text"
                id="calc-user-contact"
                name="contact"
                required
                placeholder="Email or Phone Number"
                class="w-full px-3 py-2 text-xs bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-lg text-slate-900 dark:text-white focus:ring-2 focus:ring-amber-500"
              />
            </div>
            <button
              type="submit"
              id="calc-send-btn"
              class="w-full py-2.5 px-3 bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-900 text-xs font-bold rounded-lg transition flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>Email Me This Estimate</span>
            </button>
            <div id="calc-success-msg" class="hidden p-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs text-center">
              ✓ Estimate details sent to our dispatch team! We will follow up shortly.
            </div>
          </form>
        </div>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  (function() {
    const distSlider = document.getElementById('calc-distance');
    const distVal = document.getElementById('calc-distance-val');
    const minPriceEl = document.getElementById('calc-result-min');
    const maxPriceEl = document.getElementById('calc-result-max');
    const volumeValEl = document.getElementById('calc-volume-val');
    const vansValEl = document.getElementById('calc-vans-val');
    const crewValEl = document.getElementById('calc-crew-val');
    const ctaBtn = document.getElementById('calc-cta-btn');

    function calculate() {
      // 1. Property base
      const selectedProp = document.querySelector('input[name="calc_property"]:checked');
      const basePrice = selectedProp ? parseFloat(selectedProp.value) : 390;
      const propId = selectedProp ? selectedProp.getAttribute('data-id') : '2bed';
      const volume = selectedProp ? selectedProp.getAttribute('data-volume') : '650 cu ft';
      const vans = selectedProp ? selectedProp.getAttribute('data-vans') : '1 Luton Van';
      const crew = selectedProp ? selectedProp.getAttribute('data-crew') : '2 Porters';

      // 2. Distance (£1.50 per mile after first 10 miles)
      const miles = parseInt(distSlider.value);
      if (distVal) distVal.textContent = miles + ' miles';
      const mileageCost = miles > 10 ? (miles - 10) * 1.5 : 0;

      // 3. Packing
      const selectedPack = document.querySelector('input[name="calc_packing"]:checked');
      const packCost = selectedPack ? parseFloat(selectedPack.value) : 0;

      // 4. Dismantling
      const dismantleEl = document.getElementById('calc-dismantle');
      const dismantleCost = dismantleEl && dismantleEl.checked ? parseFloat(dismantleEl.value) : 0;

      // 5. Piano
      const pianoEl = document.getElementById('calc-piano');
      const pianoCost = pianoEl && pianoEl.checked ? parseFloat(pianoEl.value) : 0;

      const subtotal = basePrice + mileageCost + packCost + dismantleCost + pianoCost;
      const minEst = Math.round(subtotal * 0.95);
      const maxEst = Math.round(subtotal * 1.15);

      if (minPriceEl) minPriceEl.textContent = '£' + minEst;
      if (maxPriceEl) maxPriceEl.textContent = '£' + maxEst;
      if (volumeValEl) volumeValEl.textContent = volume;
      if (vansValEl) vansValEl.textContent = vans;
      if (crewValEl) crewValEl.textContent = crew;

      if (ctaBtn) {
        ctaBtn.href = `/get-a-quote/?size=${propId}&dist=${miles}&min_est=${minEst}&max_est=${maxEst}`;
      }
    }

    const inputs = document.querySelectorAll('.calc-input, #calc-distance');
    inputs.forEach(input => {
      input.addEventListener('input', calculate);
      input.addEventListener('change', calculate);
    });

    calculate();

    // Direct estimate submission handler
    const calcForm = document.getElementById('calc-direct-email-form');
    if (calcForm) {
      calcForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        const sendBtn = document.getElementById('calc-send-btn');
        const successMsg = document.getElementById('calc-success-msg');
        if (sendBtn) {
          sendBtn.disabled = true;
          sendBtn.innerHTML = '<span>Sending estimate...</span>';
        }

        const userName = document.getElementById('calc-user-name')?.value || '';
        const userContact = document.getElementById('calc-user-contact')?.value || '';
        const selectedProp = document.querySelector('input[name="calc_property"]:checked');
        const propLabel = selectedProp ? selectedProp.parentElement?.querySelector('span')?.textContent || 'Property' : 'Property';
        const miles = distSlider ? distSlider.value : '10';
        const minEst = minPriceEl ? minPriceEl.textContent : '';
        const maxEst = maxPriceEl ? maxPriceEl.textContent : '';
        const volume = volumeValEl ? volumeValEl.textContent : '';
        const vans = vansValEl ? vansValEl.textContent : '';
        const crew = crewValEl ? crewValEl.textContent : '';

        const formData = new FormData();
        formData.append('_subject', `New Moving Cost Calculator Enquiry - ${minEst} to ${maxEst} (${userName})`);
        formData.append('_template', 'table');
        formData.append('_captcha', 'false');
        formData.append('customer_name', userName);
        formData.append('contact_info', userContact);
        formData.append('estimated_range', `${minEst} to ${maxEst}`);
        formData.append('property_size', propLabel);
        formData.append('estimated_volume', volume);
        formData.append('transit_distance', `${miles} miles`);
        formData.append('recommended_fleet', vans);
        formData.append('recommended_crew', crew);

        try {
          await fetch('https://formsubmit.co/ajax/jimmyslogisticsandremovals@gmail.com', {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
          });
        } catch (err) {}

        calcForm.classList.add('hidden');
        if (successMsg) successMsg.classList.remove('hidden');
      });
    }
  })();
</script>
