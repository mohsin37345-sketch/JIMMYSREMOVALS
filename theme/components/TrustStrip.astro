---
import Icon from './Icon.astro';

export interface Props {
  isBirmingham?: boolean;
}

const { isBirmingham = false } = Astro.props;

const trustItems = [
  {
    title: 'Fully Insured',
    desc: 'Professional domestic and commercial removals with full insurance',
    icon: 'shield'
  },
  {
    title: 'DBS-Checked Crews',
    desc: 'Uniformed, directly employed and vetted moving specialists',
    icon: 'check'
  },
  isBirmingham ? {
    title: 'Zero CAZ Surcharges',
    desc: 'No Clean Air Zone charges added to your quote inside the A4540 Middleway',
    icon: 'truck'
  } : {
    title: 'Luton Vans with Tail Lifts',
    desc: '3.5-tonne Luton vans equipped for safe loading and furniture protection',
    icon: 'truck'
  },
  {
    title: 'Open 24/7',
    desc: 'Available 24 hours a day, 7 days a week, including bank holidays',
    icon: 'clock'
  }
];
---

<section class="border-y border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {trustItems.map((item) => (
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
            <Icon name={item.icon} class="w-5 h-5" />
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">
              {item.title}
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
