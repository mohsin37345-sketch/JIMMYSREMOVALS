---
import Icon from './Icon.astro';

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'How Our Removal Process Works',
  subtitle = 'From your initial survey to key release and final room placement, our structured four-step process guarantees complete peace of mind.'
} = Astro.props;

const steps = [
  {
    step: 1,
    title: '1 Free Survey & Fixed Quote',
    description: 'We evaluate your home via a 15-minute video survey or detailed online inventory. You receive an itemised, guaranteed fixed price with zero hidden fees for fuel, stairs, or completion delays.',
    icon: 'briefcase'
  },
  {
    step: 2,
    title: '2 Packing & Preparation',
    description: 'We deliver heavy-duty double-walled cartons and packing materials in advance, or our DBS-checked team arrives to pack fragile china, wrap artwork, and dismantle beds and modular wardrobes.',
    icon: 'box'
  },
  {
    step: 3,
    title: '3 Move-Day Transit',
    description: 'Uniformed movers protect floors and banisters, load furnishings via our 500kg electric tail-lifts, wrap items in quilted transit blankets, secure with ratchet webbing straps, and transport directly.',
    icon: 'truck'
  },
  {
    step: 4,
    title: '4 Room-by-Room Placement',
    description: 'At your new property, we position every box and furniture item into its designated room according to your floorplan, reassemble dismantled beds and tables, and complete a final quality walk-through.',
    icon: 'check'
  }
];
---

<section id="how-it-works" class="py-16 sm:py-20 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-600 dark:text-amber-400 mb-2">
        <Icon name="check" class="w-4 h-4" />
        <span>Step-by-Step Moving Plan</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        {title}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- 4 Numbered Step Cards with H3s -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((s) => (
        <div class="relative p-6 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl flex flex-col justify-between shadow-sm hover:shadow-md transition">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-8 h-8 rounded-full bg-amber-600 text-white font-black text-xs flex items-center justify-center shadow">
                {s.step}
              </span>
              <div class="text-amber-600 dark:text-amber-400">
                <Icon name={s.icon} class="w-5 h-5" />
              </div>
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
              {s.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {s.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- H3 5: New Entity-Rich Section: Moving on Completion Day: Key Release, Chains and Delays -->
    <div class="rounded-3xl bg-slate-900 text-white p-8 sm:p-10 border border-slate-800 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-4xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/20 text-amber-400 border border-amber-500/30">
          <Icon name="clock" class="w-3.5 h-3.5" />
          <span>Move-Day Reality & Chain Management</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Moving on Completion Day: Key Release, Chains and Delays
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 text-xs sm:text-sm text-slate-300 leading-relaxed">
          <div class="space-y-3">
            <p>
              In UK residential property transactions, the gap between mortgage fund transfer across solicitor and conveyancer CHAPS systems and the official release of keys by the estate agent is consistently the most stressful window of moving house. Key release typically occurs between 1:00 PM and 3:30 PM, but chain bottlenecks frequently push this to late afternoon.
            </p>
            <p>
              When completion delays occur, unlicensed casual movers or DIY rental return deadlines create severe distress. At Jimmys Removals, your dedicated 3.5T Luton van and uniformed crew remain on site with your possessions safely secured in our vehicle.
            </p>
          </div>
          <div class="space-y-3 bg-slate-800/80 p-5 rounded-2xl border border-slate-700">
            <h4 class="text-sm font-bold text-amber-300 flex items-center gap-2">
              <Icon name="shield-check" class="w-4 h-4 text-emerald-400" />
              <span>How We Protect Your Completion Day:</span>
            </h4>
            <ul class="space-y-2 text-xs text-slate-300">
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span><strong>Direct Conveyancer Coordination:</strong> Clear updates while waiting outside your new address.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span><strong>Transparent Waiting Time Policy:</strong> Zero extortionate cancellation fees or abandonment.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span><strong>Late-Key Waiver Options:</strong> Optional waiver cover to cap unexpected delay costs.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-400 font-bold">✓</span>
                <span><strong>Overnight Transit Security:</strong> Secure containerised storage options if same-day completion fails.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
