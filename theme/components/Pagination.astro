---
export interface Props {
  currentPage?: number;
  lastPage?: number;
  totalItems?: number;
  pageSize?: number;
  baseUrl?: string;
  page?: {
    currentPage: number;
    lastPage: number;
    total: number;
    size?: number;
    start?: number;
    end?: number;
    url: {
      current?: string;
      prev?: string;
      next?: string;
    };
  };
}

const {
  currentPage: propCurrent,
  lastPage: propLast,
  totalItems: propTotal,
  pageSize: propPageSize = 12,
  baseUrl = '/blog/',
  page
} = Astro.props;

const currentPage = propCurrent || page?.currentPage || 1;
const lastPage = propLast || page?.lastPage || 1;
const totalItems = propTotal || page?.total || 0;
const pageSize = page?.size || propPageSize;

const fromItem = totalItems > 0 ? (currentPage - 1) * pageSize + 1 : 0;
const toItem = Math.min(currentPage * pageSize, totalItems);

// Calculate prev/next URLs adhering to /blog/, /blog/2/, /blog/3/
let prevUrl: string | null = null;
if (page?.url?.prev) {
  prevUrl = page.url.prev;
} else if (currentPage > 1) {
  prevUrl = currentPage === 2 ? baseUrl : `${baseUrl}${currentPage - 1}/`;
}

let nextUrl: string | null = null;
if (page?.url?.next) {
  nextUrl = page.url.next;
} else if (currentPage < lastPage) {
  nextUrl = `${baseUrl}${currentPage + 1}/`;
}

// Build page numbers array
const pageNumbers = Array.from({ length: lastPage }, (_, i) => i + 1);
---

{totalItems > 0 && (
  <nav class="flex flex-col sm:flex-row items-center justify-between gap-4 py-8 border-t border-slate-200 dark:border-slate-800" aria-label="Pagination Navigation">
    
    <!-- Results Meta Text (e.g. "Showing 1-12 of 47 articles") -->
    <div class="text-xs text-slate-500 dark:text-slate-400">
      Showing <span class="font-bold text-slate-900 dark:text-white">{fromItem}-{toItem}</span> of <span class="font-bold text-slate-900 dark:text-white">{totalItems}</span> articles
    </div>

    <!-- Pager Controls -->
    {lastPage > 1 && (
      <div class="flex items-center gap-1.5">
        <!-- Previous Page Link / Disabled State -->
        {prevUrl ? (
          <a
            href={prevUrl}
            rel="prev"
            class="px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition flex items-center gap-1"
          >
            &larr; Previous
          </a>
        ) : (
          <span
            class="px-3 py-2 text-xs font-semibold text-slate-400 dark:text-slate-600 bg-slate-100 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-lg cursor-not-allowed select-none"
            aria-disabled="true"
          >
            &larr; Previous
          </span>
        )}

        <!-- Numbered Page Links -->
        <div class="flex items-center gap-1">
          {pageNumbers.map((num) => {
            const isCurrent = num === currentPage;
            const pageUrl = num === 1 ? baseUrl : `${baseUrl}${num}/`;
            return isCurrent ? (
              <span
                class="w-8 h-8 flex items-center justify-center text-xs font-bold text-white bg-amber-600 rounded-lg shadow"
                aria-current="page"
              >
                {num}
              </span>
            ) : (
              <a
                href={pageUrl}
                class="w-8 h-8 flex items-center justify-center text-xs font-semibold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition"
                aria-label={`Go to page ${num}`}
              >
                {num}
              </a>
            );
          })}
        </div>

        <!-- Next Page Link / Disabled State -->
        {nextUrl ? (
          <a
            href={nextUrl}
            rel="next"
            class="px-3 py-2 text-xs font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 transition flex items-center gap-1"
          >
            Next &rarr;
          </a>
        ) : (
          <span
            class="px-3 py-2 text-xs font-semibold text-slate-400 dark:text-slate-600 bg-slate-100 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-lg cursor-not-allowed select-none"
            aria-disabled="true"
          >
            Next &rarr;
          </span>
        )}
      </div>
    )}
  </nav>
)}
