---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  slug: string;
  icon: string;
  summary: string;
  priceFrom?: number;
  priceUnit?: string;
  featured?: boolean;
}

const { title, slug, icon, summary, priceFrom, priceUnit = 'fixed quote', featured = false } = Astro.props;
---

<article class={`group relative p-6 rounded-2xl bg-white dark:bg-slate-900 border ${featured ? 'border-amber-500/50 shadow-amber-500/5' : 'border-slate-200 dark:border-slate-800'} shadow-md hover:shadow-xl transition-all duration-200 flex flex-col justify-between interactive-card`}>
  <div>
    <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
      <Icon name={icon} class="w-6 h-6" />
    </div>

    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
      <a href={`/removals/${slug}/`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>

    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 line-clamp-3 leading-relaxed">
      {summary}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
    {priceFrom ? (
      <div>
        <span class="text-slate-400 block text-[11px]">From</span>
        <span class="font-extrabold text-slate-900 dark:text-white text-sm">£{priceFrom}</span>
        <span class="text-slate-400 text-[10px]"> {priceUnit}</span>
      </div>
    ) : (
      <span class="text-slate-400 text-[11px]">Fixed Price Quote</span>
    )}

    <span class="font-bold text-amber-600 dark:text-amber-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
      Details <Icon name="chevron-right" class="w-3.5 h-3.5" />
    </span>
  </div>
</article>
