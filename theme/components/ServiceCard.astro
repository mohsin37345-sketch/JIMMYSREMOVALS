---
import Icon from './Icon.astro';

export interface Props {
  title: string;
  slug: string;
  icon: string;
  summary: string;
  featured?: boolean;
  town?: string;
  targetHref?: string;
}

const { title, slug, icon, summary, featured = false, town, targetHref } = Astro.props;
const serviceUrl = targetHref || (town ? `/removals/${town}/${slug}/` : `/services/${slug}/`);
---

<article class={`group relative p-6 rounded-2xl bg-white dark:bg-slate-900 border ${featured ? 'border-amber-500/50 shadow-amber-500/5' : 'border-slate-200 dark:border-slate-800'} shadow-md hover:shadow-xl transition-all duration-200 flex flex-col justify-between interactive-card`}>
  <div>
    <div class="w-12 h-12 rounded-xl bg-amber-50 dark:bg-amber-950/50 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
      <Icon name={icon} class="w-6 h-6" />
    </div>

    <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
      <a href={serviceUrl} class="hover:underline">
        {title}
      </a>
    </h3>

    <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
      {summary}
    </p>
  </div>

  <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3 text-xs">
    <a
      href="/get-a-quote/"
      class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-amber-600 hover:bg-amber-700 text-white font-bold transition shadow-sm"
    >
      <span>Get a Fixed Quote</span>
    </a>

    <a
      href={serviceUrl}
      class="font-semibold text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400 flex items-center gap-1 transition"
    >
      <span>Learn more</span>
      <Icon name="chevron-right" class="w-3.5 h-3.5" />
    </a>
  </div>
</article>
