---
import Icon from './Icon.astro';

const fleetPhotos = [
  {
    id: 'photo-tail-lift',
    src: '/images/moves/luton-van-tail-lift.webp',
    fallbackSrc: '/images/moves/luton-van-tail-lift.jpg',
    alt: 'Jimmys Removals 3.5T Luton box van with electric hydraulic tail-lift lowered for ground-level loading on a UK street in Birmingham',
    tag: 'Vehicle & Equipment',
    title: '500kg Hydraulic Tail-Lift Loading',
    location: 'Solihull & Birmingham Move',
    description: 'Our Luton vans feature electric hydraulic tail-lifts that lower flush to road level. This eliminates manual lifting strain and ensures safe, level roll-on loading for heavy sofas, solid oak dining sets, washing machines, and bulky mattresses.',
    badges: ['500kg Electric Lift', 'Flush Ground Loading', 'Tail Lift Equipped'],
    stat: '3.5 Tonne Luton Fleet'
  },
  {
    id: 'photo-appliances',
    src: '/images/moves/secure-appliance-transport.webp',
    fallbackSrc: '/images/moves/secure-appliance-transport.jpg',
    alt: 'Secure appliance transport inside Jimmys Removals van showing washing machine and upright fridge-freezer locked with heavy-duty ratchet webbing straps',
    tag: 'White-Glove Care',
    title: 'Upright Appliance & Equipment Transit',
    location: 'Kitchen & Utility Relocation',
    description: 'Refrigerators and freezers must remain upright to protect delicate compressor seals. We secure appliances, garden machinery, and heavy goods using industrial ratchet webbing straps anchored to internal wall load-lock tracks.',
    badges: ['Upright Fridge Transit', 'Industrial Ratchet Straps', 'Drum Protection'],
    stat: 'Zero Transit Shift'
  },
  {
    id: 'photo-blankets',
    src: '/images/moves/furniture-packing-blankets.webp',
    fallbackSrc: '/images/moves/furniture-packing-blankets.jpg',
    alt: 'Household furniture carefully layered and wrapped with protective quilted transit blankets inside Jimmys Removals truck',
    tag: 'Damage Prevention',
    title: 'Quilted Transit Blankets & High-Cube Stacking',
    location: 'Full House Domestic Move',
    description: 'Every vehicle carries dozens of thick, quilted removal blankets. Polished wooden tables, upholstered armchairs, and delicate units are cushioned and strapped to eliminate scuffs, surface rubbing, and vibration during transit.',
    badges: ['Quilted Furniture Blankets', 'Scratch Protection', 'Tetrised Packing'],
    stat: '100% Surface Cushioned'
  }
];

const vanComparisons = [
  {
    name: 'Long Wheelbase Panel Van (Transit)',
    volume: '350 – 450 cu ft',
    payload: '1,200 – 1,400 kg',
    bestFor: 'Studio flats, 1-bed partial moves, student relocations, single bulky item deliveries.',
    pros: 'Agile for tight underground car parks and narrow mews.',
    cons: 'Wheel arches intrude into load bed; manual lift-in without hydraulic tail-lift.'
  },
  {
    name: '3.5T Luton Box Van (Our Core Fleet)',
    volume: '650 – 750 cu ft',
    payload: '1,000 – 1,200 kg',
    bestFor: '1 to 2-bed flats, 2-bed houses, or multi-van deployments for 3 to 4-bed family homes.',
    pros: 'Square interior walls with zero wheel arch intrusion, Luton peak over cab for mattress storage, and 500kg electric tail-lift.',
    cons: 'Requires 6.7m parking clearance.'
  },
  {
    name: '7.5 Tonne Commercial Lorry',
    volume: '1,200 – 1,400 cu ft',
    payload: '2,500 – 3,000 kg',
    bestFor: 'Large 4 to 5-bedroom executive estates on wide suburban roads.',
    pros: 'Massive single-trip volumetric capacity.',
    cons: 'Restricted in narrow Victorian terraced avenues across Birmingham (B10, B11, B12); requires complex HGV parking bay permits.'
  }
];

const protectionMaterials = [
  { name: 'Double-Walled Cartons', desc: 'Heavy-duty corrugated boxes designed to withstand stacking without crushing.' },
  { name: 'Wardrobe Boxes with Rails', desc: 'Full-height garment cartons that keep suits and dresses on hangers crease-free.' },
  { name: 'Quilted Transit Blankets', desc: 'Thick padded blankets wrapping all timber surfaces, desks, and dining furniture.' },
  { name: 'Ratchet Webbing Straps', desc: 'Industrial tie-down straps anchored to van side rails to prevent any load shift.' },
  { name: 'Mattress & Sofa Covers', desc: 'Heavy-gauge polythene bags shielding upholstery from moisture, dust, and scuffs.' },
  { name: 'Bubble Wrap & Acid-Free Tissue', desc: 'Multi-layer cushioning for delicate crystal, fine porcelain, and picture frames.' },
  { name: 'Lidded Plastic Crate Hire', desc: 'Stackable, weather-resistant plastic crates ideal for office IT and confidential files.' }
];
---

<section id="fleet-showcase" class="py-16 sm:py-20 bg-slate-900 text-white relative overflow-hidden border-b border-slate-800">
  <!-- Subtle ambient glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    
    <!-- Section Header & H2 -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="max-w-2xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/15 border border-amber-500/30 text-amber-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Real Fleet • Zero Subcontracted Brokers</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Inside Our Modern Luton Van Fleet
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Unlike online booking brokers who auction jobs to unvetted drivers, Jimmys Removals operates our own dedicated 3.5T Luton box vans equipped with 500kg electric tail-lifts and complete furniture protection suites.
        </p>
      </div>

      <div class="flex items-center gap-3 shrink-0">
        <a
          href="/get-a-quote/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white text-sm font-bold shadow-lg shadow-amber-600/25 transition-all interactive-btn"
        >
          <span>Book Our Fleet</span>
          <Icon name="chevron-right" class="w-4 h-4" />
        </a>
      </div>
    </div>

    <!-- H3 1: 3.5T Luton Vans with 500kg Electric Tail-Lift (Real 3-Photo Gallery) -->
    <div class="space-y-6">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          3.5T Luton Vans with 500kg Electric Tail-Lift
        </h3>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Explore real photographs from our West Midlands house moves showcasing hydraulic ground-level loading and secured cargo.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {fleetPhotos.map((photo) => (
          <div class="group relative bg-slate-800/80 rounded-3xl border border-slate-700/80 overflow-hidden shadow-2xl flex flex-col hover:border-amber-500/50 transition duration-300">
            <!-- Image with fallback -->
            <div class="relative aspect-[4/5] sm:aspect-[3/4] overflow-hidden bg-slate-950">
              <picture>
                <source srcset={photo.src} type="image/webp" />
                <img
                  src={photo.fallbackSrc}
                  alt={photo.alt}
                  width="800"
                  height="1066"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 ease-out"
                />
              </picture>
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

              <div class="absolute top-4 left-4">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-amber-500 text-slate-950 shadow-md">
                  {photo.tag}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <h4 class="text-base font-bold text-white leading-snug">{photo.title}</h4>
                <p class="text-xs text-slate-300 mt-2 leading-relaxed">{photo.description}</p>
              </div>

              <div class="pt-3 border-t border-slate-700/60 flex flex-wrap gap-1.5">
                {photo.badges.map((badge) => (
                  <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-slate-700 text-amber-300">
                    {badge}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- H3 2: Which Van Size Do You Need? Transit vs Luton vs 7.5 Tonne -->
    <div class="space-y-6 pt-4">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          Which Van Size Do You Need? Transit vs Luton vs 7.5 Tonne
        </h3>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Understanding volumetric capacity, payload ratings, and road access across Birmingham's suburban corridors.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {vanComparisons.map((van, idx) => (
          <div class={`p-6 rounded-2xl border flex flex-col justify-between ${idx === 1 ? 'bg-slate-800/90 border-amber-500/60 shadow-xl' : 'bg-slate-800/50 border-slate-700'}`}>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class={`text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full ${idx === 1 ? 'bg-amber-500 text-slate-950' : 'bg-slate-700 text-slate-300'}`}>
                  {idx === 1 ? 'Our Core Fleet' : 'Alternative Size'}
                </span>
                <span class="text-xs font-bold text-amber-400">{van.volume}</span>
              </div>
              <h4 class="text-base font-bold text-white">{van.name}</h4>
              <p class="text-xs text-slate-300 leading-relaxed"><strong>Best For:</strong> {van.bestFor}</p>
              <div class="text-xs text-slate-400 space-y-1 pt-1">
                <div class="text-emerald-400 flex items-start gap-1.5">
                  <span>✓</span> <span><strong>Advantages:</strong> {van.pros}</span>
                </div>
                <div class="text-amber-300 flex items-start gap-1.5">
                  <span>ℹ</span> <span><strong>Considerations:</strong> {van.cons}</span>
                </div>
              </div>
            </div>
            <div class="pt-4 mt-4 border-t border-slate-700 text-[11px] text-slate-400">
              Payload rating: <span class="text-white font-semibold">{van.payload}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- H3 3: How We Protect Your Furniture in Transit -->
    <div class="space-y-6 pt-4">
      <div>
        <h3 class="text-xl sm:text-2xl font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          How We Protect Your Furniture in Transit
        </h3>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Every vehicle is equipped with industry-grade packing and cushioning materials to ensure zero transit movement or damage.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {protectionMaterials.map((mat) => (
          <div class="p-4 rounded-xl bg-slate-800/60 border border-slate-700 text-xs space-y-1.5">
            <div class="text-amber-400 font-bold flex items-center gap-1.5">
              <Icon name="shield-check" class="w-4 h-4 text-emerald-400 shrink-0" />
              <span>{mat.name}</span>
            </div>
            <p class="text-slate-400 leading-relaxed text-[11px]">{mat.desc}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
