---
import Icon from './Icon.astro';

export interface Props {
  locations?: Array<{ town: string; slug: string; tier?: number; postcodes?: string[]; lat?: number; lng?: number }>;
  class?: string;
}

const { locations = [], class: className = '' } = Astro.props;

// Grouped regional clusters
const regionalGroups = [
  {
    name: 'Birmingham & Inner Districts (B1–B48)',
    desc: 'B1-B48 postcode zones including Clean Air Zone corridors, Digbeth, Harborne, Selly Oak and Sutton Coldfield',
    towns: [
      { name: 'Birmingham City', slug: 'birmingham', tier: 1 },
      { name: 'Sutton Coldfield', slug: 'sutton-coldfield', tier: 1 },
      { name: 'Harborne', slug: 'harborne', tier: 2 },
      { name: 'Moseley', slug: 'moseley', tier: 2 },
      { name: 'Kings Heath', slug: 'kings-heath', tier: 2 },
      { name: 'Selly Oak', slug: 'selly-oak', tier: 2 },
      { name: 'Northfield', slug: 'northfield', tier: 2 },
      { name: 'Erdington', slug: 'erdington', tier: 2 }
    ]
  },
  {
    name: 'The Black Country',
    desc: 'Sandwell, Dudley, Walsall & Wolverhampton industrial & residential communities',
    towns: [
      { name: 'Wolverhampton', slug: 'wolverhampton', tier: 1 },
      { name: 'Dudley', slug: 'dudley', tier: 1 },
      { name: 'Walsall', slug: 'walsall', tier: 1 },
      { name: 'West Bromwich', slug: 'west-bromwich', tier: 1 },
      { name: 'Stourbridge', slug: 'stourbridge', tier: 1 },
      { name: 'Halesowen', slug: 'halesowen', tier: 2 },
      { name: 'Oldbury', slug: 'oldbury', tier: 2 },
      { name: 'Smethwick', slug: 'smethwick', tier: 2 },
      { name: 'Tipton', slug: 'tipton', tier: 2 },
      { name: 'Wednesbury', slug: 'wednesbury', tier: 2 },
      { name: 'Willenhall', slug: 'willenhall', tier: 2 },
      { name: 'Bilston', slug: 'bilston', tier: 2 },
      { name: 'Brierley Hill', slug: 'brierley-hill', tier: 2 },
      { name: 'Kingswinford', slug: 'kingswinford', tier: 2 },
      { name: 'Rowley Regis', slug: 'rowley-regis', tier: 2 },
      { name: 'Cradley Heath', slug: 'cradley-heath', tier: 2 },
      { name: 'Bloxwich', slug: 'bloxwich', tier: 2 },
      { name: 'Aldridge', slug: 'aldridge', tier: 2 }
    ]
  },
  {
    name: 'Coventry, Solihull & Warwickshire',
    desc: 'M42, A45 and Coventry corridors connecting Warwickshire and East Birmingham',
    towns: [
      { name: 'Coventry', slug: 'coventry', tier: 1 },
      { name: 'Solihull', slug: 'solihull', tier: 1 },
      { name: 'Shirley', slug: 'shirley', tier: 2 },
      { name: 'Nuneaton', slug: 'nuneaton', tier: 2 },
      { name: 'Bedworth', slug: 'bedworth', tier: 2 },
      { name: 'Leamington Spa', slug: 'leamington-spa', tier: 2 }
    ]
  },
  {
    name: 'Staffordshire & Worcestershire Borders',
    desc: 'North and South commuter arteries along M5, M6 and A38 corridors',
    towns: [
      { name: 'Tamworth', slug: 'tamworth', tier: 2 },
      { name: 'Lichfield', slug: 'lichfield', tier: 2 },
      { name: 'Cannock', slug: 'cannock', tier: 2 },
      { name: 'Bromsgrove', slug: 'bromsgrove', tier: 2 },
      { name: 'Redditch', slug: 'redditch', tier: 2 }
    ]
  }
];
---

<div id="area-coverage-map" class:list={["space-y-12", className]} data-total-locations={locations.length}>
  
  <!-- Click-to-Load Regional Map Container -->
  <div class="relative bg-slate-900 rounded-3xl p-6 sm:p-10 border border-slate-800 shadow-2xl overflow-hidden">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400">
          Regional Motorway Corridors: M6 • M5 • M42 • A38(M)
        </span>
        <div class="text-xl sm:text-2xl font-bold text-white mt-1">West Midlands Operations Map</div>
      </div>
      <div class="flex items-center gap-3 text-xs text-slate-300">
        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span> Tier 1 Hubs</span>
        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-slate-400 inline-block"></span> Supporting Districts</span>
      </div>
    </div>

    <!-- Click-to-Load Map Wrapper -->
    <div id="map-interactive-wrapper" class="relative w-full aspect-[16/9] max-h-[460px] bg-slate-950 rounded-2xl border border-slate-800 flex items-center justify-center overflow-hidden">
      
      <!-- Static Preview Overlay with Click-to-Load Trigger -->
      <div id="map-preview-overlay" class="absolute inset-0 z-10 bg-gradient-to-t from-slate-950 via-slate-900/80 to-transparent flex flex-col items-center justify-center p-6 text-center">
        <div class="w-14 h-14 rounded-2xl bg-amber-500/20 text-amber-400 flex items-center justify-center mb-3">
          <Icon name="map" class="w-7 h-7" />
        </div>
        <h3 class="text-lg font-bold text-white mb-1">Explore 37 Coverage Locations</h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-md mb-4">
          Click below to load the interactive motorway network map showing M6, M5, M42 and A38(M) transit corridors.
        </p>
        <button
          type="button"
          id="load-map-btn"
          class="px-6 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm rounded-xl shadow-lg transition interactive-btn flex items-center gap-2"
        >
          <Icon name="navigation" class="w-4 h-4" />
          <span>Load Interactive Map</span>
        </button>
      </div>

      <!-- Scalable Visual Region Schematic SVG -->
      <svg id="schematic-map-svg" viewBox="0 0 800 450" class="w-full h-full text-slate-700 opacity-40 transition-opacity duration-500" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Motorway arterial network (M6, M5, M42) -->
        <path d="M50 80 Q 250 200 400 225 T 750 320" stroke="#475569" stroke-width="6" stroke-dasharray="6 4" />
        <path d="M400 225 Q 380 320 350 420" stroke="#475569" stroke-width="6" stroke-dasharray="6 4" />
        <path d="M460 225 Q 520 280 620 400" stroke="#475569" stroke-width="4" stroke-dasharray="4 4" />

        <!-- Major Hubs (Tier 1) with Amber Markers -->
        <!-- Birmingham (Center) -->
        <circle cx="410" cy="225" r="14" fill="#d97706" />
        <circle cx="410" cy="225" r="22" stroke="#d97706" stroke-width="2" stroke-opacity="0.5" />
        <text x="410" y="258" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="14">Birmingham (Hub)</text>

        <!-- Wolverhampton -->
        <circle cx="210" cy="140" r="10" fill="#d97706" />
        <text x="210" y="125" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="12">Wolverhampton</text>

        <!-- Coventry -->
        <circle cx="630" cy="260" r="10" fill="#d97706" />
        <text x="630" y="285" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="12">Coventry</text>

        <!-- Solihull -->
        <circle cx="490" cy="285" r="9" fill="#d97706" />
        <text x="490" y="308" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="11">Solihull</text>

        <!-- Dudley -->
        <circle cx="280" cy="205" r="9" fill="#d97706" />
        <text x="280" y="195" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="11">Dudley</text>

        <!-- Walsall -->
        <circle cx="340" cy="130" r="9" fill="#d97706" />
        <text x="340" y="120" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="11">Walsall</text>

        <!-- West Bromwich -->
        <circle cx="345" cy="195" r="9" fill="#d97706" />
        <text x="345" y="185" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="11">West Bromwich</text>

        <!-- Sutton Coldfield -->
        <circle cx="470" cy="135" r="9" fill="#d97706" />
        <text x="470" y="125" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="11">Sutton Coldfield</text>

        <!-- Stourbridge -->
        <circle cx="230" cy="265" r="8" fill="#d97706" />
        <text x="230" y="285" text-anchor="middle" fill="#ffffff" font-weight="bold" font-size="11">Stourbridge</text>

        <!-- Tier 2 Towns (Slate Nodes) -->
        <circle cx="310" cy="265" r="4" fill="#94a3b8" />
        <text x="310" y="280" text-anchor="middle" fill="#94a3b8" font-size="9">Halesowen</text>

        <circle cx="340" cy="235" r="4" fill="#94a3b8" />
        <text x="340" y="248" text-anchor="middle" fill="#94a3b8" font-size="9">Smethwick</text>

        <circle cx="350" cy="388" r="4" fill="#94a3b8" />
        <text x="350" y="405" text-anchor="middle" fill="#94a3b8" font-size="9">Bromsgrove</text>

        <circle cx="430" cy="390" r="4" fill="#94a3b8" />
        <text x="430" y="408" text-anchor="middle" fill="#94a3b8" font-size="9">Redditch</text>

        <circle cx="680" cy="340" r="4" fill="#94a3b8" />
        <text x="680" y="358" text-anchor="middle" fill="#94a3b8" font-size="9">Leamington</text>

        <circle cx="660" cy="170" r="4" fill="#94a3b8" />
        <text x="660" y="160" text-anchor="middle" fill="#94a3b8" font-size="9">Nuneaton</text>

        <circle cx="560" cy="90" r="4" fill="#94a3b8" />
        <text x="560" y="80" text-anchor="middle" fill="#94a3b8" font-size="9">Tamworth</text>

        <circle cx="480" cy="50" r="4" fill="#94a3b8" />
        <text x="480" y="40" text-anchor="middle" fill="#94a3b8" font-size="9">Lichfield</text>

        <circle cx="330" cy="50" r="4" fill="#94a3b8" />
        <text x="330" y="40" text-anchor="middle" fill="#94a3b8" font-size="9">Cannock</text>
      </svg>
    </div>
  </div>

  <!-- Grouped Regional Directories: Birmingham / Black Country / Coventry & Warwickshire / Staffordshire Border -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {regionalGroups.map((group) => (
      <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <Icon name="map-pin" class="w-5 h-5 text-amber-500" />
            <span>{group.name}</span>
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            {group.desc}
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-2">
          {group.towns.map((town) => (
            <a
              href={`/areas/${town.slug}/`}
              class={`p-2.5 rounded-xl border transition-all text-xs font-semibold flex items-center justify-between group ${
                town.tier === 1
                  ? 'bg-amber-500/10 border-amber-500/30 text-slate-900 dark:text-white hover:border-amber-500'
                  : 'bg-slate-50 dark:bg-slate-800/60 border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:border-amber-500'
              }`}
            >
              <span class="truncate">{town.name}</span>
              <Icon name="chevron-right" class="w-3.5 h-3.5 text-amber-500 opacity-0 group-hover:opacity-100 transition-opacity shrink-0" />
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

</div>

<!-- Click-to-Load Script -->
<script is:inline>
  (function() {
    const btn = document.getElementById('load-map-btn');
    const overlay = document.getElementById('map-preview-overlay');
    const svg = document.getElementById('schematic-map-svg');

    if (btn && overlay && svg) {
      btn.addEventListener('click', () => {
        overlay.classList.add('opacity-0', 'pointer-events-none');
        svg.classList.remove('opacity-40');
        svg.classList.add('opacity-100');
        setTimeout(() => {
          overlay.classList.add('hidden');
        }, 500);
      });
    }
  })();
</script>
