---
import Icon from './Icon.astro';

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Why Choose Jimmys Removals?',
  subtitle = 'Compare our professional removals against unvetted casual operators and DIY van hire.'
} = Astro.props;

const comparisonPoints = [
  {
    feature: 'Insurance Status',
    jimmys: 'Fully insured',
    unlicensed: 'Rarely / None',
    diy: 'Extra excess charge'
  },
  {
    feature: 'Vetted, DBS-Checked Crews',
    jimmys: 'Uniformed, directly employed',
    unlicensed: 'Unknown casual labour',
    diy: 'Manual heavy lifting yourself'
  },
  {
    feature: '3.5-Tonne Luton Vans with Tail Lifts',
    jimmys: 'Yes (With tie-rails and tail lift)',
    unlicensed: 'Often standard panel vans',
    diy: 'Standard manual loading van'
  },
  {
    feature: 'Guaranteed Fixed Quotes',
    jimmys: 'Confirmed fixed price',
    unlicensed: 'Hourly meters and surprise add-ons',
    diy: 'Fuel, deposits, and mileage charges'
  },
  {
    feature: 'Operating Hours',
    jimmys: 'Open 24 hours, 7 days a week',
    unlicensed: 'Limited or unreliable scheduling',
    diy: 'Strict rental depot return windows'
  },
  {
    feature: 'Confirmed Booking Date',
    jimmys: 'Confirmed in writing',
    unlicensed: 'High cancellation risk',
    diy: 'Subject to vehicle availability'
  }
];
---

<section class="py-16 bg-slate-50 dark:bg-slate-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">
        {title}
      </h2>
      <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
        {subtitle}
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full max-w-4xl mx-auto text-left border-collapse bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 overflow-hidden text-xs sm:text-sm">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-100/70 dark:bg-slate-800/60 text-slate-900 dark:text-white">
            <th class="p-4 font-bold">Standard Features</th>
            <th class="p-4 font-bold text-amber-600 dark:text-amber-400 bg-amber-500/10">Jimmys Removals</th>
            <th class="p-4 font-bold text-slate-500">Unvetted Operators</th>
            <th class="p-4 font-bold text-slate-500">DIY Van Hire</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
          {comparisonPoints.map((row) => (
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40">
              <td class="p-4 font-medium text-slate-900 dark:text-slate-100">{row.feature}</td>
              <td class="p-4 font-semibold text-slate-900 dark:text-white bg-amber-500/5 flex items-center gap-2">
                <Icon name="check" class="w-4 h-4 text-emerald-500 shrink-0" />
                <span>{row.jimmys}</span>
              </td>
              <td class="p-4 text-slate-500">{row.unlicensed}</td>
              <td class="p-4 text-slate-500">{row.diy}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
