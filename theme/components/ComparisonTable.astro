---
import Icon from './Icon.astro';

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Why Choose Jimmys Removals?',
  subtitle = 'Compare our insured, professional removals against unlicensed casual operators and DIY van hire.'
} = Astro.props;

const comparisonPoints = [
  {
    feature: 'Goods in Transit Insurance',
    jimmys: '£50,000 Included',
    unlicensed: 'Rarely / None',
    diy: 'Extra excess charge (£1,000+)'
  },
  {
    feature: 'Public Liability Cover',
    jimmys: '£2,000,000 Included',
    unlicensed: 'None',
    diy: 'None for household goods'
  },
  {
    feature: 'Clean Air Zone Compliance',
    jimmys: '100% Euro 6 (Zero charge)',
    unlicensed: 'Often non-compliant (fees passed on)',
    diy: 'Dependent on hire fleet age'
  },
  {
    feature: 'Vetted, DBS-Checked Porters',
    jimmys: 'Yes (Uniformed & DBS-checked)',
    unlicensed: 'Unknown casual labour',
    diy: 'You and your friends'
  },
  {
    feature: 'Tail-Lift Luton Box Vans',
    jimmys: 'Yes (With tie-rails & ramps)',
    unlicensed: 'Often standard panel vans',
    diy: 'Standard manual loading van'
  },
  {
    feature: 'Guaranteed Booking Date',
    jimmys: 'Confirmed in writing',
    unlicensed: 'High cancellation / no-show risk',
    diy: 'Subject to rental depot availability'
  }
];
---

<section class="py-16 bg-slate-50 dark:bg-slate-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-10">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">
        {title}
      </h2>
      <p class="text-sm sm:text-base text-slate-500 dark:text-slate-400 mt-2">
        {subtitle}
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse bg-white dark:bg-slate-900 rounded-2xl overflow-hidden shadow-lg border border-slate-200 dark:border-slate-800">
        <thead>
          <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-100/70 dark:bg-slate-800/70">
            <th class="p-4 sm:p-5 text-sm font-bold text-slate-900 dark:text-white">Key Protection Feature</th>
            <th class="p-4 sm:p-5 text-sm font-bold text-amber-600 dark:text-amber-400 bg-amber-50/50 dark:bg-amber-950/20 border-x border-amber-500/20">
              Jimmys Removals
            </th>
            <th class="p-4 sm:p-5 text-sm font-semibold text-slate-600 dark:text-slate-400">Casual / Unlicensed Mover</th>
            <th class="p-4 sm:p-5 text-sm font-semibold text-slate-600 dark:text-slate-400">DIY Van Hire</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-xs sm:text-sm">
          {comparisonPoints.map((row) => (
            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition-colors">
              <td class="p-4 sm:p-5 font-semibold text-slate-800 dark:text-slate-200">
                {row.feature}
              </td>
              <td class="p-4 sm:p-5 font-bold text-emerald-600 dark:text-emerald-400 bg-amber-50/30 dark:bg-amber-950/10 border-x border-amber-500/20 flex items-center gap-1.5">
                <Icon name="check" class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>{row.jimmys}</span>
              </td>
              <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">
                {row.unlicensed}
              </td>
              <td class="p-4 sm:p-5 text-slate-500 dark:text-slate-400">
                {row.diy}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
