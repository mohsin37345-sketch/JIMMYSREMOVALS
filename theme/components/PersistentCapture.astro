---
import { siteConfig } from 'src/data/site';
import Icon from './Icon.astro';
---

<!-- Persistent Capture Suite: Callback Widget, Checklist Download & Desktop Exit Intent -->

<!-- 1. Floating Desktop Callback Button -->
<div id="callback-float-trigger" class="fixed bottom-6 left-6 z-30 hidden lg:block">
  <button
    type="button"
    id="open-callback-btn"
    class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white shadow-xl hover:shadow-2xl hover:border-amber-500 transition-all text-xs font-bold interactive-btn"
    aria-label="Request a 30-minute callback"
  >
    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
    <Icon name="phone" class="w-4 h-4 text-amber-500" />
    <span>30-Min Callback (8am-8pm)</span>
  </button>
</div>

<!-- 2. Callback Modal Dialog -->
<div
  id="callback-modal"
  class="fixed inset-0 z-50 hidden bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="callback-modal-title"
>
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl relative space-y-4">
    <button
      type="button"
      id="close-callback-btn"
      class="absolute top-4 right-4 p-1.5 rounded-lg text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition"
      aria-label="Close modal"
    >
      <Icon name="close" class="w-5 h-5" />
    </button>

    <div class="space-y-1 pr-6">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300">
        Fast Response
      </div>
      <h3 id="callback-modal-title" class="text-xl font-bold text-slate-900 dark:text-white">
        Request a 30-Minute Callback
      </h3>
      <p class="text-xs text-slate-500 dark:text-slate-400">
        Operating 7 days a week, 8am to 8pm. One of our Birmingham move coordinators will ring you back directly.
      </p>
    </div>

    <form id="callback-form" class="space-y-3.5">
      <div>
        <label for="cb-name" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Your Name</label>
        <input type="text" id="cb-name" required placeholder="e.g. John Taylor" class="w-full px-3.5 py-2 text-sm bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500 transition" />
      </div>
      <div>
        <label for="cb-phone" class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300 mb-1">Phone Number</label>
        <input type="tel" id="cb-phone" required placeholder="e.g. 07123 456789" class="w-full px-3.5 py-2 text-sm bg-slate-50 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500 transition" />
      </div>
      <div class="flex items-center gap-3 pt-1">
        <button
          type="button"
          id="cancel-callback-btn"
          class="w-1/3 py-2.5 px-4 rounded-xl border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 font-semibold text-sm transition focus:outline-none focus:ring-2 focus:ring-slate-400 text-center cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="flex-1 py-2.5 px-4 bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm rounded-xl shadow transition focus:outline-none focus:ring-2 focus:ring-amber-500 text-center cursor-pointer"
        >
          Request Callback Now
        </button>
      </div>
    </form>

    <div id="callback-success" class="hidden p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-300 dark:border-emerald-800 text-center text-xs text-emerald-800 dark:text-emerald-200">
      ✓ Request received! We will call you back within 30 minutes.
    </div>
  </div>
</div>

<!-- 3. Desktop-Only Exit Intent Modal -->
<div
  id="exit-intent-modal"
  class="fixed inset-0 z-50 hidden bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-modal-title"
>
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-8 shadow-2xl relative text-center space-y-4">
    <button
      type="button"
      id="close-exit-btn"
      class="absolute top-4 right-4 p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition"
      aria-label="Close offer"
    >
      <Icon name="close" class="w-5 h-5" />
    </button>

    <div class="w-12 h-12 rounded-2xl bg-amber-500/15 text-amber-500 flex items-center justify-center mx-auto">
      <Icon name="truck" class="w-6 h-6" />
    </div>

    <div>
      <span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
        Before You Go
      </span>
      <h3 id="exit-modal-title" class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1">
        Save 10% on Midweek West Midlands Moves
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-2 leading-relaxed">
        Moving Tuesday to Thursday? Lock in our exclusive discounted midweek rate with our fully insured, directly employed moving crew.
      </p>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row gap-3">
      <a
        href="/get-a-quote/"
        class="flex-1 py-3 px-4 bg-amber-600 hover:bg-amber-700 text-white font-bold text-sm rounded-xl shadow-md transition interactive-btn flex items-center justify-center gap-2"
      >
        <span>Claim Midweek Quote</span>
        <Icon name="chevron-right" class="w-4 h-4" />
      </a>
      <a
        href={`tel:${siteConfig.phoneE164}`}
        class="flex-1 py-3 px-4 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-bold text-sm rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition flex items-center justify-center gap-2"
      >
        <Icon name="phone" class="w-4 h-4 text-amber-500" />
        <span>{siteConfig.phone}</span>
      </a>
    </div>

    <div class="pt-1">
      <button
        type="button"
        id="cancel-exit-btn"
        class="text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition underline underline-offset-4 cursor-pointer"
      >
        No thanks, dismiss this offer
      </button>
    </div>

    <p class="text-[11px] text-slate-400">
      Valid for domestic & commercial moves across Birmingham, Solihull & the Black Country.
    </p>
  </div>
</div>

<script is:inline>
  (function() {
    // 1. Callback Modal Logic
    const openCbBtn = document.getElementById('open-callback-btn');
    const closeCbBtn = document.getElementById('close-callback-btn');
    const cancelCbBtn = document.getElementById('cancel-callback-btn');
    const cbModal = document.getElementById('callback-modal');
    const cbForm = document.getElementById('callback-form');
    const cbSuccess = document.getElementById('callback-success');

    function closeCallbackModal() {
      if (cbModal) cbModal.classList.add('hidden');
    }

    if (openCbBtn && cbModal) {
      openCbBtn.addEventListener('click', () => {
        cbModal.classList.remove('hidden');
      });
    }

    if (closeCbBtn) {
      closeCbBtn.addEventListener('click', closeCallbackModal);
    }

    if (cancelCbBtn) {
      cancelCbBtn.addEventListener('click', closeCallbackModal);
    }

    if (cbModal) {
      cbModal.addEventListener('click', (e) => {
        if (e.target === cbModal) {
          closeCallbackModal();
        }
      });
    }

    if (cbForm) {
      cbForm.addEventListener('submit', (e) => {
        e.preventDefault();
        cbForm.classList.add('hidden');
        if (cbSuccess) cbSuccess.classList.remove('hidden');
        setTimeout(() => {
          closeCallbackModal();
        }, 2500);
      });
    }

    // 2. Desktop Exit Intent Logic
    const exitModal = document.getElementById('exit-intent-modal');
    const closeExitBtn = document.getElementById('close-exit-btn');
    const cancelExitBtn = document.getElementById('cancel-exit-btn');

    function closeExitModal() {
      if (exitModal) exitModal.classList.add('hidden');
    }

    if (closeExitBtn) {
      closeExitBtn.addEventListener('click', closeExitModal);
    }

    if (cancelExitBtn) {
      cancelExitBtn.addEventListener('click', closeExitModal);
    }

    if (exitModal) {
      exitModal.addEventListener('click', (e) => {
        if (e.target === exitModal) {
          closeExitModal();
        }
      });
    }

    if (exitModal && typeof window !== 'undefined' && window.innerWidth >= 1024) {
      const shownKey = 'jimmys_exit_shown';

      document.addEventListener('mouseleave', (e) => {
        if (e.clientY <= 10 && !sessionStorage.getItem(shownKey)) {
          sessionStorage.setItem(shownKey, 'true');
          exitModal.classList.remove('hidden');
        }
      });
    }

    // Universal Escape key listener
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeExitModal();
        closeCallbackModal();
      }
    });
  })();
</script>
